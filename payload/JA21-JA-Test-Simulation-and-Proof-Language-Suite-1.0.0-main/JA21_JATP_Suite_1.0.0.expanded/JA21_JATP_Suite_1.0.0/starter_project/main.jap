module starter.verification
use Proof
policy no_network

fixture StarterFixture {
    input 4
    expected 12
}

property TripleProperty for_all x: Count where x <= 4 {
    let result = x * 3
    invariant result >= x
    assert result == expected
}

simulation RecoveryScenario {
    virtual_time 10s
    inject service.pause at 3s
    expect service.recovers within 4s
}

benchmark StarterBench limit cpu 5ms memory 16MB
assert proof.complete == true
emit mcrt "starter.verification.mcrt"
