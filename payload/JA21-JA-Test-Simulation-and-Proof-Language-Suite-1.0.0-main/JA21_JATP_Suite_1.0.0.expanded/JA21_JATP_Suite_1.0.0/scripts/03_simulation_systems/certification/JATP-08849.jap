module corpus.ja_proof.example_08849
use Proof
policy no_network

fixture FixtureJATP_08849 {
    input 24
    expected 360
}
unit test FixtureCheckJATP_08849 {
    let fixture_result = FixtureJATP_08849.input * 15
    assert fixture_result == FixtureJATP_08849.expected
}
property PropertyJATP_08849 for_all x: Count where x <= 24 {
    let result = x * 15
    invariant result >= x
}
simulation FailureJATP_08849 {
    virtual_time 24s
    inject network.partition at 15s
    expect service.recovers within 18s
}
benchmark BenchJATP_08849 limit cpu 24ms memory 23MB
assert proof.complete == true
emit mcrt "PropertyJATP_08849.proof.mcrt"