module corpus.ja_proof.example_08209
use Proof
policy no_network

fixture FixtureJATP_08209 {
    input 63
    expected 1638
}
unit test FixtureCheckJATP_08209 {
    let fixture_result = FixtureJATP_08209.input * 26
    assert fixture_result == FixtureJATP_08209.expected
}
property PropertyJATP_08209 for_all x: Count where x <= 63 {
    let result = x * 26
    invariant result >= x
}
simulation FailureJATP_08209 {
    virtual_time 63s
    inject network.partition at 26s
    expect service.recovers within 29s
}
benchmark BenchJATP_08209 limit cpu 63ms memory 34MB
assert proof.complete == true
emit mcrt "PropertyJATP_08209.proof.mcrt"