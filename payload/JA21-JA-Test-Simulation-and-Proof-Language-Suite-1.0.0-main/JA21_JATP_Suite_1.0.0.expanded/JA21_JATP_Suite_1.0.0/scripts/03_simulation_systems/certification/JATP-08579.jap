module corpus.ja_proof.example_08579
use Proof
policy no_network

fixture FixtureJATP_08579 {
    input 45
    expected 1080
}
unit test FixtureCheckJATP_08579 {
    let fixture_result = FixtureJATP_08579.input * 24
    assert fixture_result == FixtureJATP_08579.expected
}
property PropertyJATP_08579 for_all x: Count where x <= 45 {
    let result = x * 24
    invariant result >= x
}
simulation FailureJATP_08579 {
    virtual_time 45s
    inject network.partition at 24s
    expect service.recovers within 27s
}
benchmark BenchJATP_08579 limit cpu 45ms memory 32MB
assert proof.complete == true
emit mcrt "PropertyJATP_08579.proof.mcrt"