module corpus.ja_proof.example_08419
use Proof
policy no_network

fixture FixtureJATP_08419 {
    input 79
    expected 1501
}
property PropertyJATP_08419 for_all x: Count where x <= 79 {
    let result = x * 19
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_08419 {
    virtual_time 79s
    inject network.partition at 19s
    expect service.recovers within 22s
}
benchmark BenchJATP_08419 limit cpu 79ms memory 27MB
assert proof.complete == false
emit mcrt "PropertyJATP_08419.proof.mcrt"