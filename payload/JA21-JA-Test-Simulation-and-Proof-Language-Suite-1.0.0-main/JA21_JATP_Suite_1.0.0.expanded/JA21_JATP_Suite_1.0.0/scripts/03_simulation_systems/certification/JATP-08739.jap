module corpus.ja_proof.example_08739
use Proof
policy no_network

fixture FixtureJATP_08739 {
    input 11
    expected 319
}
unit test FixtureCheckJATP_08739 {
    let fixture_result = FixtureJATP_08739.input * 29
    assert fixture_result == FixtureJATP_08739.expected
}
property PropertyJATP_08739 for_all x: Count where x <= 11 {
    let result = x * 29
    invariant result >= x
}
simulation FailureJATP_08739 {
    virtual_time 11s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_08739 limit cpu 11ms memory 37MB
assert proof.complete == true
emit mcrt "PropertyJATP_08739.proof.mcrt"