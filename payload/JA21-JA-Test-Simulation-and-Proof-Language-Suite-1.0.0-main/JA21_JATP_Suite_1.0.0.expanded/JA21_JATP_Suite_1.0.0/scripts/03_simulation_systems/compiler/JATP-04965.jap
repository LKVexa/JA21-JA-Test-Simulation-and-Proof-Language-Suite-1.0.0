module corpus.ja_proof.example_04965
use Proof
policy no_network

fixture FixtureJATP_04965 {
    input 20
    expected 120
}
property PropertyJATP_04965 for_all x: Count where x <= 20 {
    let result = x * 6
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_04965 {
    virtual_time 20s
    inject network.partition at 6s
    expect service.recovers within 9s
}
benchmark BenchJATP_04965 limit cpu 20ms memory 14MB
assert proof.complete == false
emit mcrt "PropertyJATP_04965.proof.mcrt"