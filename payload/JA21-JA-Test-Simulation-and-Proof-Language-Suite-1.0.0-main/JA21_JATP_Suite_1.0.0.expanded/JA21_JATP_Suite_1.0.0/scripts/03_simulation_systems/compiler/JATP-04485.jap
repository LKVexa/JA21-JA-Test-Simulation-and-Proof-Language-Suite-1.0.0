module corpus.ja_proof.example_04485
use Proof
policy no_network

fixture FixtureJATP_04485 {
    input 25
    expected 550
}
property PropertyJATP_04485 for_all x: Count where x <= 25 {
    let result = x * 22
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_04485 {
    virtual_time 25s
    inject network.partition at 22s
    expect service.recovers within 25s
}
benchmark BenchJATP_04485 limit cpu 25ms memory 30MB
assert proof.complete == false
emit mcrt "PropertyJATP_04485.proof.mcrt"