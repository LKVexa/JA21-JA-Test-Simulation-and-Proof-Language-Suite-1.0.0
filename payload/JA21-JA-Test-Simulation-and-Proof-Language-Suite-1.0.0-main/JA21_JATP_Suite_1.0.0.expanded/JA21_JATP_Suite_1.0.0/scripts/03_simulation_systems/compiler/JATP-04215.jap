module corpus.ja_proof.example_04215
use Proof
policy no_network

fixture FixtureJATP_04215 {
    input 46
    expected 1426
}
unit test FixtureCheckJATP_04215 {
    let fixture_result = FixtureJATP_04215.input * 31
    assert fixture_result == FixtureJATP_04215.expected
}
property PropertyJATP_04215 for_all x: Count where x <= 46 {
    let result = x * 31
    invariant result >= x
}
simulation FailureJATP_04215 {
    virtual_time 46s
    inject network.partition at 31s
    expect service.recovers within 34s
}
benchmark BenchJATP_04215 limit cpu 46ms memory 39MB
assert proof.complete == true
emit mcrt "PropertyJATP_04215.proof.mcrt"