module corpus.ja_proof.example_04535
use Proof
policy no_network

fixture FixtureJATP_04535 {
    input 75
    expected 750
}
property PropertyJATP_04535 for_all x: Count where x <= 75 {
    let result = x * 10
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_04535 {
    virtual_time 75s
    inject network.partition at 10s
    expect service.recovers within 13s
}
benchmark BenchJATP_04535 limit cpu 75ms memory 18MB
assert proof.complete == false
emit mcrt "PropertyJATP_04535.proof.mcrt"