module corpus.ja_proof.example_04275
use Proof
policy no_network

fixture FixtureJATP_04275 {
    input 9
    expected 261
}
unit test FixtureCheckJATP_04275 {
    let fixture_result = FixtureJATP_04275.input * 29
    assert fixture_result == FixtureJATP_04275.expected
}
property PropertyJATP_04275 for_all x: Count where x <= 9 {
    let result = x * 29
    invariant result >= x
}
simulation FailureJATP_04275 {
    virtual_time 9s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_04275 limit cpu 9ms memory 37MB
assert proof.complete == true
emit mcrt "PropertyJATP_04275.proof.mcrt"