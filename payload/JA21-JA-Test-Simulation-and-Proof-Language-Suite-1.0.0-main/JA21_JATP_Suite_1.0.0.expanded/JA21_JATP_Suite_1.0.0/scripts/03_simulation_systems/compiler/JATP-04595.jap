module corpus.ja_proof.example_04595
use Proof
policy no_network

fixture FixtureJATP_04595 {
    input 38
    expected 304
}
unit test FixtureCheckJATP_04595 {
    let fixture_result = FixtureJATP_04595.input * 8
    assert fixture_result == FixtureJATP_04595.expected
}
property PropertyJATP_04595 for_all x: Count where x <= 38 {
    let result = x * 8
    invariant result >= x
}
simulation FailureJATP_04595 {
    virtual_time 38s
    inject network.partition at 8s
    expect service.recovers within 11s
}
benchmark BenchJATP_04595 limit cpu 38ms memory 16MB
assert proof.complete == true
emit mcrt "PropertyJATP_04595.proof.mcrt"