module corpus.ja_proof.example_04115
use Proof
policy no_network

fixture FixtureJATP_04115 {
    input 43
    expected 1032
}
unit test FixtureCheckJATP_04115 {
    let fixture_result = FixtureJATP_04115.input * 24
    assert fixture_result == FixtureJATP_04115.expected
}
property PropertyJATP_04115 for_all x: Count where x <= 43 {
    let result = x * 24
    invariant result >= x
}
simulation FailureJATP_04115 {
    virtual_time 43s
    inject network.partition at 24s
    expect service.recovers within 27s
}
benchmark BenchJATP_04115 limit cpu 43ms memory 32MB
assert proof.complete == true
emit mcrt "PropertyJATP_04115.proof.mcrt"