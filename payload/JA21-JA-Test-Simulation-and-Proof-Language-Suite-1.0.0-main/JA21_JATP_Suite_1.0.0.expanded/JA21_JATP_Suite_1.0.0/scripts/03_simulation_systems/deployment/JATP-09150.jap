module corpus.ja_proof.example_09150
use Proof
policy no_network

fixture FixtureJATP_09150 {
    input 34
    expected 204
}
unit test FixtureCheckJATP_09150 {
    let fixture_result = FixtureJATP_09150.input * 6
    assert fixture_result == FixtureJATP_09150.expected
}
property PropertyJATP_09150 for_all x: Count where x <= 34 {
    let result = x * 6
    invariant result >= x
}
simulation FailureJATP_09150 {
    virtual_time 34s
    inject network.partition at 6s
    expect service.recovers within 9s
}
benchmark BenchJATP_09150 limit cpu 34ms memory 14MB
assert proof.complete == true
emit mcrt "PropertyJATP_09150.proof.mcrt"