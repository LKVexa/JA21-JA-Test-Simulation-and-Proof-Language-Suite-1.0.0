module corpus.ja_proof.example_09420
use Proof
policy no_network

fixture FixtureJATP_09420 {
    input 13
    expected 364
}
property PropertyJATP_09420 for_all x: Count where x <= 13 {
    let result = x * 28
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_09420 {
    virtual_time 13s
    inject network.partition at 28s
    expect service.recovers within 31s
}
benchmark BenchJATP_09420 limit cpu 13ms memory 36MB
assert proof.complete == false
emit mcrt "PropertyJATP_09420.proof.mcrt"