module corpus.ja_proof.example_09950
use Proof
policy no_network

fixture FixtureJATP_09950 {
    input 58
    expected 1798
}
unit test FixtureCheckJATP_09950 {
    let fixture_result = FixtureJATP_09950.input * 31
    assert fixture_result == FixtureJATP_09950.expected
}
property PropertyJATP_09950 for_all x: Count where x <= 58 {
    let result = x * 31
    invariant result >= x
}
simulation FailureJATP_09950 {
    virtual_time 58s
    inject network.partition at 31s
    expect service.recovers within 34s
}
benchmark BenchJATP_09950 limit cpu 58ms memory 39MB
assert proof.complete == true
emit mcrt "PropertyJATP_09950.proof.mcrt"