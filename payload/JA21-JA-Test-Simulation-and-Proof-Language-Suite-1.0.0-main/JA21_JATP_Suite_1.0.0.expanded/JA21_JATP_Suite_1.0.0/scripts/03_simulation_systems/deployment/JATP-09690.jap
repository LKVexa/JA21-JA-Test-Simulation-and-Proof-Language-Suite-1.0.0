module corpus.ja_proof.example_09690
use Proof
policy no_network

fixture FixtureJATP_09690 {
    input 89
    expected 1691
}
unit test FixtureCheckJATP_09690 {
    let fixture_result = FixtureJATP_09690.input * 19
    assert fixture_result == FixtureJATP_09690.expected
}
property PropertyJATP_09690 for_all x: Count where x <= 89 {
    let result = x * 19
    invariant result >= x
}
simulation FailureJATP_09690 {
    virtual_time 89s
    inject network.partition at 19s
    expect service.recovers within 22s
}
benchmark BenchJATP_09690 limit cpu 89ms memory 27MB
assert proof.complete == true
emit mcrt "PropertyJATP_09690.proof.mcrt"