module corpus.ja_proof.example_09740
use Proof
policy no_network

fixture FixtureJATP_09740 {
    input 42
    expected 294
}
unit test FixtureCheckJATP_09740 {
    let fixture_result = FixtureJATP_09740.input * 7
    assert fixture_result == FixtureJATP_09740.expected
}
property PropertyJATP_09740 for_all x: Count where x <= 42 {
    let result = x * 7
    invariant result >= x
}
simulation FailureJATP_09740 {
    virtual_time 42s
    inject network.partition at 7s
    expect service.recovers within 10s
}
benchmark BenchJATP_09740 limit cpu 42ms memory 15MB
assert proof.complete == true
emit mcrt "PropertyJATP_09740.proof.mcrt"