module corpus.ja_proof.example_06427
use Proof
policy no_network

fixture FixtureJATP_06427 {
    input 27
    expected 297
}
property PropertyJATP_06427 for_all x: Count where x <= 27 {
    let result = x * 11
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_06427 {
    virtual_time 27s
    inject network.partition at 11s
    expect service.recovers within 14s
}
benchmark BenchJATP_06427 limit cpu 27ms memory 19MB
assert proof.complete == false
emit mcrt "PropertyJATP_06427.proof.mcrt"