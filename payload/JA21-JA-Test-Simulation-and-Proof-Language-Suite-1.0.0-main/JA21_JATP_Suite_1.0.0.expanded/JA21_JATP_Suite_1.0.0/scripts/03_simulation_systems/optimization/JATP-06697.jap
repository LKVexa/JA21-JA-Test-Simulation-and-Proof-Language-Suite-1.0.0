module corpus.ja_proof.example_06697
use Proof
policy no_network

fixture FixtureJATP_06697 {
    input 6
    expected 12
}
unit test FixtureCheckJATP_06697 {
    let fixture_result = FixtureJATP_06697.input * 2
    assert fixture_result == FixtureJATP_06697.expected
}
property PropertyJATP_06697 for_all x: Count where x <= 6 {
    let result = x * 2
    invariant result >= x
}
simulation FailureJATP_06697 {
    virtual_time 6s
    inject network.partition at 2s
    expect service.recovers within 5s
}
benchmark BenchJATP_06697 limit cpu 6ms memory 10MB
assert proof.complete == true
emit mcrt "PropertyJATP_06697.proof.mcrt"