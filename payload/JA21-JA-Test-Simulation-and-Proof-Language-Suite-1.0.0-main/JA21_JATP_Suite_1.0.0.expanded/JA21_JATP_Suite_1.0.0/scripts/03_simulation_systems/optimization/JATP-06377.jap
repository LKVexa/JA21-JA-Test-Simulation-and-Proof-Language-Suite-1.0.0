module corpus.ja_proof.example_06377
use Proof
policy no_network

fixture FixtureJATP_06377 {
    input 74
    expected 1702
}
unit test FixtureCheckJATP_06377 {
    let fixture_result = FixtureJATP_06377.input * 23
    assert fixture_result == FixtureJATP_06377.expected
}
property PropertyJATP_06377 for_all x: Count where x <= 74 {
    let result = x * 23
    invariant result >= x
}
simulation FailureJATP_06377 {
    virtual_time 74s
    inject network.partition at 23s
    expect service.recovers within 26s
}
benchmark BenchJATP_06377 limit cpu 74ms memory 31MB
assert proof.complete == true
emit mcrt "PropertyJATP_06377.proof.mcrt"