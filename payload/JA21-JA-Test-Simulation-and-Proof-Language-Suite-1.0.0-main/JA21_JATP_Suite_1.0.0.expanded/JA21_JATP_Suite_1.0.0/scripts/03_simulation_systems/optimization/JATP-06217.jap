module corpus.ja_proof.example_06217
use Proof
policy no_network

fixture FixtureJATP_06217 {
    input 11
    expected 198
}
unit test FixtureCheckJATP_06217 {
    let fixture_result = FixtureJATP_06217.input * 18
    assert fixture_result == FixtureJATP_06217.expected
}
property PropertyJATP_06217 for_all x: Count where x <= 11 {
    let result = x * 18
    invariant result >= x
}
simulation FailureJATP_06217 {
    virtual_time 11s
    inject network.partition at 18s
    expect service.recovers within 21s
}
benchmark BenchJATP_06217 limit cpu 11ms memory 26MB
assert proof.complete == true
emit mcrt "PropertyJATP_06217.proof.mcrt"