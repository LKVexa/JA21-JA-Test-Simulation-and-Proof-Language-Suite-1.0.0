module corpus.ja_proof.example_06157
use Proof
policy no_network

fixture FixtureJATP_06157 {
    input 48
    expected 960
}
unit test FixtureCheckJATP_06157 {
    let fixture_result = FixtureJATP_06157.input * 20
    assert fixture_result == FixtureJATP_06157.expected
}
property PropertyJATP_06157 for_all x: Count where x <= 48 {
    let result = x * 20
    invariant result >= x
}
simulation FailureJATP_06157 {
    virtual_time 48s
    inject network.partition at 20s
    expect service.recovers within 23s
}
benchmark BenchJATP_06157 limit cpu 48ms memory 28MB
assert proof.complete == true
emit mcrt "PropertyJATP_06157.proof.mcrt"