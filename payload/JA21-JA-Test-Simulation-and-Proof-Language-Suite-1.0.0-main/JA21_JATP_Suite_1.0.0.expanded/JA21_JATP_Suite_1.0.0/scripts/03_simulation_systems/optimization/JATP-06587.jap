module corpus.ja_proof.example_06587
use Proof
policy no_network

fixture FixtureJATP_06587 {
    input 90
    expected 1440
}
unit test FixtureCheckJATP_06587 {
    let fixture_result = FixtureJATP_06587.input * 16
    assert fixture_result == FixtureJATP_06587.expected
}
property PropertyJATP_06587 for_all x: Count where x <= 90 {
    let result = x * 16
    invariant result >= x
}
simulation FailureJATP_06587 {
    virtual_time 90s
    inject network.partition at 16s
    expect service.recovers within 19s
}
benchmark BenchJATP_06587 limit cpu 90ms memory 24MB
assert proof.complete == true
emit mcrt "PropertyJATP_06587.proof.mcrt"