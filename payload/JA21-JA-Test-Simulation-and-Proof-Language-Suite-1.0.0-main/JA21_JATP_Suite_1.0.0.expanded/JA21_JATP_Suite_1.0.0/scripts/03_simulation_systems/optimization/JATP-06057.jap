module corpus.ja_proof.example_06057
use Proof
policy no_network

fixture FixtureJATP_06057 {
    input 45
    expected 585
}
unit test FixtureCheckJATP_06057 {
    let fixture_result = FixtureJATP_06057.input * 13
    assert fixture_result == FixtureJATP_06057.expected
}
property PropertyJATP_06057 for_all x: Count where x <= 45 {
    let result = x * 13
    invariant result >= x
}
simulation FailureJATP_06057 {
    virtual_time 45s
    inject network.partition at 13s
    expect service.recovers within 16s
}
benchmark BenchJATP_06057 limit cpu 45ms memory 21MB
assert proof.complete == true
emit mcrt "PropertyJATP_06057.proof.mcrt"