module corpus.ja_proof.example_01862
use Proof
policy no_network

fixture FixtureJATP_01862 {
    input 21
    expected 63
}
unit test FixtureCheckJATP_01862 {
    let fixture_result = FixtureJATP_01862.input * 3
    assert fixture_result == FixtureJATP_01862.expected
}
property PropertyJATP_01862 for_all x: Count where x <= 21 {
    let result = x * 3
    invariant result >= x
}
simulation FailureJATP_01862 {
    virtual_time 21s
    inject network.partition at 3s
    expect service.recovers within 6s
}
benchmark BenchJATP_01862 limit cpu 21ms memory 11MB
assert proof.complete == true
emit mcrt "PropertyJATP_01862.proof.mcrt"