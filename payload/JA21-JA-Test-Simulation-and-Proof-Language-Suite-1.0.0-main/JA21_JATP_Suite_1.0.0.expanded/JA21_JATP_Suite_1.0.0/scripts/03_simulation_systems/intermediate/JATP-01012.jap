ja source 0.3
module corpus.ja_proof.example_01012
use Proof
policy no_network

fixture FixtureJATP_01012 {
    input 44
    expected 924
}
unit test FixtureCheckJATP_01012 {
    let fixture_result = FixtureJATP_01012.input * 21
    assert fixture_result == FixtureJATP_01012.expected
}
property PropertyJATP_01012 for_all x: Count where x <= 44 {
    let result = x * 21
    invariant result >= x
}
simulation FailureJATP_01012 {
    virtual_time 44s
    inject network.partition at 21s
    expect service.recovers within 24s
}
benchmark BenchJATP_01012 limit cpu 44ms memory 29MB
assert proof.complete == true
emit mcrt "PropertyJATP_01012.proof.mcrt"