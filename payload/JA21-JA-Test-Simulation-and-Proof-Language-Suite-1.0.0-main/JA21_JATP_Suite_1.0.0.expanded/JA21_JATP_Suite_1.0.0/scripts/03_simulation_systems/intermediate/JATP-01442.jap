module corpus.ja_proof.example_01442
use Proof
policy no_network

fixture FixtureJATP_01442 {
    input 86
    expected 1462
}
property PropertyJATP_01442 for_all x: Count where x <= 86 {
    let result = x * 17
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_01442 {
    virtual_time 86s
    inject network.partition at 17s
    expect service.recovers within 20s
}
benchmark BenchJATP_01442 limit cpu 86ms memory 25MB
assert proof.complete == false
emit mcrt "PropertyJATP_01442.proof.mcrt"