module corpus.ja_proof.example_01542
use Proof
policy no_network

fixture FixtureJATP_01542 {
    input 89
    expected 2136
}
property PropertyJATP_01542 for_all x: Count where x <= 89 {
    let result = x * 24
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_01542 {
    virtual_time 89s
    inject network.partition at 24s
    expect service.recovers within 27s
}
benchmark BenchJATP_01542 limit cpu 89ms memory 32MB
assert proof.complete == false
emit mcrt "PropertyJATP_01542.proof.mcrt"