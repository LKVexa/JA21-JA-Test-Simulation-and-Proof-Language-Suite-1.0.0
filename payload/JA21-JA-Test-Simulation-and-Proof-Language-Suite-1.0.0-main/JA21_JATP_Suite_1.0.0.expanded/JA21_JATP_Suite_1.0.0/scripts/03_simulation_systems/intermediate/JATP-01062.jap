module corpus.ja_proof.example_01062
use Proof
policy no_network

fixture FixtureJATP_01062 {
    input 94
    expected 846
}
unit test FixtureCheckJATP_01062 {
    let fixture_result = FixtureJATP_01062.input * 9
    assert fixture_result == FixtureJATP_01062.expected
}
property PropertyJATP_01062 for_all x: Count where x <= 94 {
    let result = x * 9
    invariant result >= x
}
simulation FailureJATP_01062 {
    virtual_time 94s
    inject network.partition at 9s
    expect service.recovers within 12s
}
benchmark BenchJATP_01062 limit cpu 94ms memory 17MB
assert proof.complete == true
emit mcrt "PropertyJATP_01062.proof.mcrt"