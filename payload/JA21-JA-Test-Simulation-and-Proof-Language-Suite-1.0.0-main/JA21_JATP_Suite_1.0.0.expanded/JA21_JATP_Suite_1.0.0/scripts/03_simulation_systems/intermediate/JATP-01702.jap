module corpus.ja_proof.example_01702
use Proof
policy no_network

fixture FixtureJATP_01702 {
    input 55
    expected 1595
}
unit test FixtureCheckJATP_01702 {
    let fixture_result = FixtureJATP_01702.input * 29
    assert fixture_result == FixtureJATP_01702.expected
}
property PropertyJATP_01702 for_all x: Count where x <= 55 {
    let result = x * 29
    invariant result >= x
}
simulation FailureJATP_01702 {
    virtual_time 55s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_01702 limit cpu 55ms memory 37MB
assert proof.complete == true
emit mcrt "PropertyJATP_01702.proof.mcrt"