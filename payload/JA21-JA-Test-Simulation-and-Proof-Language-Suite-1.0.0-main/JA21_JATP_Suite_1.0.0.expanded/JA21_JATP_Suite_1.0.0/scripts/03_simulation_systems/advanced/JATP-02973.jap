module corpus.ja_proof.example_02973
use Proof
policy no_network

fixture FixtureJATP_02973 {
    input 65
    expected 1885
}
property PropertyJATP_02973 for_all x: Count where x <= 65 {
    let result = x * 29
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_02973 {
    virtual_time 65s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_02973 limit cpu 65ms memory 37MB
assert proof.complete == false
emit mcrt "PropertyJATP_02973.proof.mcrt"