module corpus.ja_proof.example_02913
use Proof
policy no_network

fixture FixtureJATP_02913 {
    input 5
    expected 155
}
unit test FixtureCheckJATP_02913 {
    let fixture_result = FixtureJATP_02913.input * 31
    assert fixture_result == FixtureJATP_02913.expected
}
property PropertyJATP_02913 for_all x: Count where x <= 5 {
    let result = x * 31
    invariant result >= x
}
simulation FailureJATP_02913 {
    virtual_time 5s
    inject network.partition at 31s
    expect service.recovers within 34s
}
benchmark BenchJATP_02913 limit cpu 5ms memory 39MB
assert proof.complete == true
emit mcrt "PropertyJATP_02913.proof.mcrt"