module corpus.ja_proof.example_02813
use Proof
policy no_network

fixture FixtureJATP_02813 {
    input 2
    expected 48
}
property PropertyJATP_02813 for_all x: Count where x <= 2 {
    let result = x * 24
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_02813 {
    virtual_time 2s
    inject network.partition at 24s
    expect service.recovers within 27s
}
benchmark BenchJATP_02813 limit cpu 2ms memory 32MB
assert proof.complete == false
emit mcrt "PropertyJATP_02813.proof.mcrt"