module corpus.ja_proof.example_02273
use Proof
policy no_network

fixture FixtureJATP_02273 {
    input 44
    expected 484
}
unit test FixtureCheckJATP_02273 {
    let fixture_result = FixtureJATP_02273.input * 11
    assert fixture_result == FixtureJATP_02273.expected
}
property PropertyJATP_02273 for_all x: Count where x <= 44 {
    let result = x * 11
    invariant result >= x
}
simulation FailureJATP_02273 {
    virtual_time 44s
    inject network.partition at 11s
    expect service.recovers within 14s
}
benchmark BenchJATP_02273 limit cpu 44ms memory 19MB
assert proof.complete == true
emit mcrt "PropertyJATP_02273.proof.mcrt"