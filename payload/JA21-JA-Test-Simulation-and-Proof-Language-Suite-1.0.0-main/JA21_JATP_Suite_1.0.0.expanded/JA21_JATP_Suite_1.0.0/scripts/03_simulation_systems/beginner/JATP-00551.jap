module corpus.ja_proof.example_00551
use Proof
policy no_network

fixture FixtureJATP_00551 {
    input 68
    expected 1700
}
unit test FixtureCheckJATP_00551 {
    let fixture_result = FixtureJATP_00551.input * 25
    assert fixture_result == FixtureJATP_00551.expected
}
property PropertyJATP_00551 for_all x: Count where x <= 68 {
    let result = x * 25
    invariant result >= x
}
simulation FailureJATP_00551 {
    virtual_time 68s
    inject network.partition at 25s
    expect service.recovers within 28s
}
benchmark BenchJATP_00551 limit cpu 68ms memory 33MB
assert proof.complete == true
emit mcrt "PropertyJATP_00551.proof.mcrt"