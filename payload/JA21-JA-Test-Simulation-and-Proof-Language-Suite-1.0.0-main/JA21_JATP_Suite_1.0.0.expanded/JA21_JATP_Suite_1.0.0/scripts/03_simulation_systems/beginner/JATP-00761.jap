module corpus.ja_proof.example_00761
use Proof
policy no_network

fixture FixtureJATP_00761 {
    input 84
    expected 1512
}
property PropertyJATP_00761 for_all x: Count where x <= 84 {
    let result = x * 18
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_00761 {
    virtual_time 84s
    inject network.partition at 18s
    expect service.recovers within 21s
}
benchmark BenchJATP_00761 limit cpu 84ms memory 26MB
assert proof.complete == false
emit mcrt "PropertyJATP_00761.proof.mcrt"