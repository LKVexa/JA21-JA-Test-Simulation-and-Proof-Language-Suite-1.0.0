module corpus.ja_proof.example_00331
use Proof
policy no_network

fixture FixtureJATP_00331 {
    input 42
    expected 924
}
unit test FixtureCheckJATP_00331 {
    let fixture_result = FixtureJATP_00331.input * 22
    assert fixture_result == FixtureJATP_00331.expected
}
property PropertyJATP_00331 for_all x: Count where x <= 42 {
    let result = x * 22
    invariant result >= x
}
simulation FailureJATP_00331 {
    virtual_time 42s
    inject network.partition at 22s
    expect service.recovers within 25s
}
benchmark BenchJATP_00331 limit cpu 42ms memory 30MB
assert proof.complete == true
emit mcrt "PropertyJATP_00331.proof.mcrt"