module corpus.ja_proof.example_00601
use Proof
policy no_network

fixture FixtureJATP_00601 {
    input 21
    expected 273
}
unit test FixtureCheckJATP_00601 {
    let fixture_result = FixtureJATP_00601.input * 13
    assert fixture_result == FixtureJATP_00601.expected
}
property PropertyJATP_00601 for_all x: Count where x <= 21 {
    let result = x * 13
    invariant result >= x
}
simulation FailureJATP_00601 {
    virtual_time 21s
    inject network.partition at 13s
    expect service.recovers within 16s
}
benchmark BenchJATP_00601 limit cpu 21ms memory 21MB
assert proof.complete == true
emit mcrt "PropertyJATP_00601.proof.mcrt"