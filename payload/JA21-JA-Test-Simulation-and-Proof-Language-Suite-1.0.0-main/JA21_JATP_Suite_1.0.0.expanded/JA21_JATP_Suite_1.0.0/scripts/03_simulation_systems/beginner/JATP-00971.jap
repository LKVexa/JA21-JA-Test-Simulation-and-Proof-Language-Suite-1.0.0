module corpus.ja_proof.example_00971
use Proof
policy no_network

fixture FixtureJATP_00971 {
    input 3
    expected 33
}
property PropertyJATP_00971 for_all x: Count where x <= 3 {
    let result = x * 11
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_00971 {
    virtual_time 3s
    inject network.partition at 11s
    expect service.recovers within 14s
}
benchmark BenchJATP_00971 limit cpu 3ms memory 19MB
assert proof.complete == false
emit mcrt "PropertyJATP_00971.proof.mcrt"