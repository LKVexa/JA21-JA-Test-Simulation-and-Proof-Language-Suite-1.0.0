module corpus.ja_proof.example_07528
use Proof
policy no_network

fixture FixtureJATP_07528 {
    input 61
    expected 1647
}
property PropertyJATP_07528 for_all x: Count where x <= 61 {
    let result = x * 27
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_07528 {
    virtual_time 61s
    inject network.partition at 27s
    expect service.recovers within 30s
}
benchmark BenchJATP_07528 limit cpu 61ms memory 35MB
assert proof.complete == false
emit mcrt "PropertyJATP_07528.proof.mcrt"