module corpus.ja_proof.example_07208
use Proof
policy no_network

fixture FixtureJATP_07208 {
    input 32
    expected 544
}
unit test FixtureCheckJATP_07208 {
    let fixture_result = FixtureJATP_07208.input * 17
    assert fixture_result == FixtureJATP_07208.expected
}
property PropertyJATP_07208 for_all x: Count where x <= 32 {
    let result = x * 17
    invariant result >= x
}
simulation FailureJATP_07208 {
    virtual_time 32s
    inject network.partition at 17s
    expect service.recovers within 20s
}
benchmark BenchJATP_07208 limit cpu 32ms memory 25MB
assert proof.complete == true
emit mcrt "PropertyJATP_07208.proof.mcrt"