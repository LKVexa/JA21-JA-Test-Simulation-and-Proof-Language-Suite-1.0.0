module corpus.ja_proof.example_07798
use Proof
policy no_network

fixture FixtureJATP_07798 {
    input 40
    expected 720
}
property PropertyJATP_07798 for_all x: Count where x <= 40 {
    let result = x * 18
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_07798 {
    virtual_time 40s
    inject network.partition at 18s
    expect service.recovers within 21s
}
benchmark BenchJATP_07798 limit cpu 40ms memory 26MB
assert proof.complete == false
emit mcrt "PropertyJATP_07798.proof.mcrt"