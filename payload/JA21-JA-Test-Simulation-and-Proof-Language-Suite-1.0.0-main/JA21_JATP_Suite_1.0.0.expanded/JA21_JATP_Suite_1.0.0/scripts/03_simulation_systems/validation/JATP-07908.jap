module corpus.ja_proof.example_07908
use Proof
policy no_network

fixture FixtureJATP_07908 {
    input 53
    expected 212
}
unit test FixtureCheckJATP_07908 {
    let fixture_result = FixtureJATP_07908.input * 4
    assert fixture_result == FixtureJATP_07908.expected
}
property PropertyJATP_07908 for_all x: Count where x <= 53 {
    let result = x * 4
    invariant result >= x
}
simulation FailureJATP_07908 {
    virtual_time 53s
    inject network.partition at 4s
    expect service.recovers within 7s
}
benchmark BenchJATP_07908 limit cpu 53ms memory 12MB
assert proof.complete == true
emit mcrt "PropertyJATP_07908.proof.mcrt"