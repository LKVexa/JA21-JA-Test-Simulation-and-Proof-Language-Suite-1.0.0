module corpus.ja_proof.example_07478
use Proof
policy no_network

fixture FixtureJATP_07478 {
    input 11
    expected 88
}
property PropertyJATP_07478 for_all x: Count where x <= 11 {
    let result = x * 8
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_07478 {
    virtual_time 11s
    inject network.partition at 8s
    expect service.recovers within 11s
}
benchmark BenchJATP_07478 limit cpu 11ms memory 16MB
assert proof.complete == false
emit mcrt "PropertyJATP_07478.proof.mcrt"