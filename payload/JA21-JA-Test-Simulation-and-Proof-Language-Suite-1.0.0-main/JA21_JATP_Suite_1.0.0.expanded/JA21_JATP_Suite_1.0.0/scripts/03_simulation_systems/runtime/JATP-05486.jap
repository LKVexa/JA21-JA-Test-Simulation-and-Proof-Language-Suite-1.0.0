module corpus.ja_proof.example_05486
use Proof
policy no_network

fixture FixtureJATP_05486 {
    input 56
    expected 1736
}
property PropertyJATP_05486 for_all x: Count where x <= 56 {
    let result = x * 31
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_05486 {
    virtual_time 56s
    inject network.partition at 31s
    expect service.recovers within 34s
}
benchmark BenchJATP_05486 limit cpu 56ms memory 39MB
assert proof.complete == false
emit mcrt "PropertyJATP_05486.proof.mcrt"