module corpus.ja_proof.example_05856
use Proof
policy no_network

fixture FixtureJATP_05856 {
    input 38
    expected 1102
}
unit test FixtureCheckJATP_05856 {
    let fixture_result = FixtureJATP_05856.input * 29
    assert fixture_result == FixtureJATP_05856.expected
}
property PropertyJATP_05856 for_all x: Count where x <= 38 {
    let result = x * 29
    invariant result >= x
}
simulation FailureJATP_05856 {
    virtual_time 38s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_05856 limit cpu 38ms memory 37MB
assert proof.complete == true
emit mcrt "PropertyJATP_05856.proof.mcrt"