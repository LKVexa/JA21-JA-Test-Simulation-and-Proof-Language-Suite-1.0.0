module corpus.ja_proof.example_05376
use Proof
policy no_network

fixture FixtureJATP_05376 {
    input 43
    expected 602
}
unit test FixtureCheckJATP_05376 {
    let fixture_result = FixtureJATP_05376.input * 14
    assert fixture_result == FixtureJATP_05376.expected
}
property PropertyJATP_05376 for_all x: Count where x <= 43 {
    let result = x * 14
    invariant result >= x
}
simulation FailureJATP_05376 {
    virtual_time 43s
    inject network.partition at 14s
    expect service.recovers within 17s
}
benchmark BenchJATP_05376 limit cpu 43ms memory 22MB
assert proof.complete == true
emit mcrt "PropertyJATP_05376.proof.mcrt"