module corpus.ja_proof.example_05806
use Proof
policy no_network

fixture FixtureJATP_05806 {
    input 85
    expected 850
}
property PropertyJATP_05806 for_all x: Count where x <= 85 {
    let result = x * 10
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_05806 {
    virtual_time 85s
    inject network.partition at 10s
    expect service.recovers within 13s
}
benchmark BenchJATP_05806 limit cpu 85ms memory 18MB
assert proof.complete == false
emit mcrt "PropertyJATP_05806.proof.mcrt"