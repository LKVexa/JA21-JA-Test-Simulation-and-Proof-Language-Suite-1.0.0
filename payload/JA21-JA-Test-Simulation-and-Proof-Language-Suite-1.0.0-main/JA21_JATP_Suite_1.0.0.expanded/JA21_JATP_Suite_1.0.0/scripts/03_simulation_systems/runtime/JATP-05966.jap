module corpus.ja_proof.example_05966
use Proof
policy no_network

fixture FixtureJATP_05966 {
    input 51
    expected 765
}
property PropertyJATP_05966 for_all x: Count where x <= 51 {
    let result = x * 15
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_05966 {
    virtual_time 51s
    inject network.partition at 15s
    expect service.recovers within 18s
}
benchmark BenchJATP_05966 limit cpu 51ms memory 23MB
assert proof.complete == false
emit mcrt "PropertyJATP_05966.proof.mcrt"