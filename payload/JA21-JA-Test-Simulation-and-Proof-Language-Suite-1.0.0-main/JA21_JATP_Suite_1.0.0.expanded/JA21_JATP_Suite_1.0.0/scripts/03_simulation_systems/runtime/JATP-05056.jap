module corpus.ja_proof.example_05056
use Proof
policy no_network

fixture FixtureJATP_05056 {
    input 14
    expected 56
}
unit test FixtureCheckJATP_05056 {
    let fixture_result = FixtureJATP_05056.input * 4
    assert fixture_result == FixtureJATP_05056.expected
}
property PropertyJATP_05056 for_all x: Count where x <= 14 {
    let result = x * 4
    invariant result >= x
}
simulation FailureJATP_05056 {
    virtual_time 14s
    inject network.partition at 4s
    expect service.recovers within 7s
}
benchmark BenchJATP_05056 limit cpu 14ms memory 12MB
assert proof.complete == true
emit mcrt "PropertyJATP_05056.proof.mcrt"