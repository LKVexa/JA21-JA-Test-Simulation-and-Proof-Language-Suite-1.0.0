module corpus.ja_proof.example_03004
use Proof
policy no_network

fixture FixtureJATP_03004 {
    input 96
    expected 2784
}
unit test FixtureCheckJATP_03004 {
    let fixture_result = FixtureJATP_03004.input * 29
    assert fixture_result == FixtureJATP_03004.expected
}
property PropertyJATP_03004 for_all x: Count where x <= 96 {
    let result = x * 29
    invariant result >= x
}
simulation FailureJATP_03004 {
    virtual_time 96s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_03004 limit cpu 96ms memory 37MB
assert proof.complete == true
emit mcrt "PropertyJATP_03004.proof.mcrt"