module corpus.ja_proof.example_03964
use Proof
policy no_network

fixture FixtureJATP_03964 {
    input 86
    expected 2408
}
property PropertyJATP_03964 for_all x: Count where x <= 86 {
    let result = x * 28
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_03964 {
    virtual_time 86s
    inject network.partition at 28s
    expect service.recovers within 31s
}
benchmark BenchJATP_03964 limit cpu 86ms memory 36MB
assert proof.complete == false
emit mcrt "PropertyJATP_03964.proof.mcrt"