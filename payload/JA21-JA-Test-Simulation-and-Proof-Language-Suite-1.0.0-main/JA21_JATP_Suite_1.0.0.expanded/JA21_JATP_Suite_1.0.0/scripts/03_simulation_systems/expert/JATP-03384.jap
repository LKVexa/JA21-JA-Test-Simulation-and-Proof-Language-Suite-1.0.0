module corpus.ja_proof.example_03384
use Proof
policy no_network

fixture FixtureJATP_03384 {
    input 88
    expected 528
}
unit test FixtureCheckJATP_03384 {
    let fixture_result = FixtureJATP_03384.input * 6
    assert fixture_result == FixtureJATP_03384.expected
}
property PropertyJATP_03384 for_all x: Count where x <= 88 {
    let result = x * 6
    invariant result >= x
}
simulation FailureJATP_03384 {
    virtual_time 88s
    inject network.partition at 6s
    expect service.recovers within 9s
}
benchmark BenchJATP_03384 limit cpu 88ms memory 14MB
assert proof.complete == true
emit mcrt "PropertyJATP_03384.proof.mcrt"