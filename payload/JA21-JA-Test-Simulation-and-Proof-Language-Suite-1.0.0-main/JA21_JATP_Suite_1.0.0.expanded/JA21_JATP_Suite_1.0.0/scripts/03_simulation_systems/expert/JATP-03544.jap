module corpus.ja_proof.example_03544
use Proof
policy no_network

fixture FixtureJATP_03544 {
    input 54
    expected 594
}
property PropertyJATP_03544 for_all x: Count where x <= 54 {
    let result = x * 11
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_03544 {
    virtual_time 54s
    inject network.partition at 11s
    expect service.recovers within 14s
}
benchmark BenchJATP_03544 limit cpu 54ms memory 19MB
assert proof.complete == false
emit mcrt "PropertyJATP_03544.proof.mcrt"