module corpus.ja_proof.example_03484
use Proof
policy no_network

fixture FixtureJATP_03484 {
    input 91
    expected 1183
}
property PropertyJATP_03484 for_all x: Count where x <= 91 {
    let result = x * 13
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_03484 {
    virtual_time 91s
    inject network.partition at 13s
    expect service.recovers within 16s
}
benchmark BenchJATP_03484 limit cpu 91ms memory 21MB
assert proof.complete == false
emit mcrt "PropertyJATP_03484.proof.mcrt"