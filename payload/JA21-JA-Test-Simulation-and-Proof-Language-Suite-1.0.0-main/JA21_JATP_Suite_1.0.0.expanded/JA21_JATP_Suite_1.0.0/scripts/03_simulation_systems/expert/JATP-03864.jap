module corpus.ja_proof.example_03864
use Proof
policy no_network

fixture FixtureJATP_03864 {
    input 83
    expected 1743
}
unit test FixtureCheckJATP_03864 {
    let fixture_result = FixtureJATP_03864.input * 21
    assert fixture_result == FixtureJATP_03864.expected
}
property PropertyJATP_03864 for_all x: Count where x <= 83 {
    let result = x * 21
    invariant result >= x
}
simulation FailureJATP_03864 {
    virtual_time 83s
    inject network.partition at 21s
    expect service.recovers within 24s
}
benchmark BenchJATP_03864 limit cpu 83ms memory 29MB
assert proof.complete == true
emit mcrt "PropertyJATP_03864.proof.mcrt"