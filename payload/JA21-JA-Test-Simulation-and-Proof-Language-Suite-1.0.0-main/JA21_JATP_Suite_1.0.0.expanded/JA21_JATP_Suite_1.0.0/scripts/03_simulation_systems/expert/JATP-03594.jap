module corpus.ja_proof.example_03594
use Proof
policy no_network

fixture FixtureJATP_03594 {
    input 7
    expected 210
}
unit test FixtureCheckJATP_03594 {
    let fixture_result = FixtureJATP_03594.input * 30
    assert fixture_result == FixtureJATP_03594.expected
}
property PropertyJATP_03594 for_all x: Count where x <= 7 {
    let result = x * 30
    invariant result >= x
}
simulation FailureJATP_03594 {
    virtual_time 7s
    inject network.partition at 30s
    expect service.recovers within 33s
}
benchmark BenchJATP_03594 limit cpu 7ms memory 38MB
assert proof.complete == true
emit mcrt "PropertyJATP_03594.proof.mcrt"