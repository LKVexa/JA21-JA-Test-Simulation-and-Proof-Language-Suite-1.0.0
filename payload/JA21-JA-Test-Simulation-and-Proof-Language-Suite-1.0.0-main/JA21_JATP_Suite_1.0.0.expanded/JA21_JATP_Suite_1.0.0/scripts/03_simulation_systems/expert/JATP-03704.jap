module corpus.ja_proof.example_03704
use Proof
policy no_network

fixture FixtureJATP_03704 {
    input 20
    expected 320
}
unit test FixtureCheckJATP_03704 {
    let fixture_result = FixtureJATP_03704.input * 16
    assert fixture_result == FixtureJATP_03704.expected
}
property PropertyJATP_03704 for_all x: Count where x <= 20 {
    let result = x * 16
    invariant result >= x
}
simulation FailureJATP_03704 {
    virtual_time 20s
    inject network.partition at 16s
    expect service.recovers within 19s
}
benchmark BenchJATP_03704 limit cpu 20ms memory 24MB
assert proof.complete == true
emit mcrt "PropertyJATP_03704.proof.mcrt"