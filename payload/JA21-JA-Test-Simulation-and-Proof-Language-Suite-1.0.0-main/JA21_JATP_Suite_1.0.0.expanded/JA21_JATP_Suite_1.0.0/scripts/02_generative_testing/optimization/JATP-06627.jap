module corpus.ja_proof.example_06627
use Proof
policy no_network

fixture FixtureJATP_06627 {
    input 33
    expected 825
}
unit test FixtureCheckJATP_06627 {
    let fixture_result = FixtureJATP_06627.input * 25
    assert fixture_result == FixtureJATP_06627.expected
}
property PropertyJATP_06627 for_all x: Count where x <= 33 {
    let result = x * 25
    invariant result >= x
}
simulation FailureJATP_06627 {
    virtual_time 33s
    inject network.partition at 25s
    expect service.recovers within 28s
}
benchmark BenchJATP_06627 limit cpu 33ms memory 33MB
assert proof.complete == true
emit mcrt "PropertyJATP_06627.proof.mcrt"