module corpus.ja_proof.example_06577
use Proof
policy no_network

fixture FixtureJATP_06577 {
    input 80
    expected 480
}
unit test FixtureCheckJATP_06577 {
    let fixture_result = FixtureJATP_06577.input * 6
    assert fixture_result == FixtureJATP_06577.expected
}
property PropertyJATP_06577 for_all x: Count where x <= 80 {
    let result = x * 6
    invariant result >= x
}
simulation FailureJATP_06577 {
    virtual_time 80s
    inject network.partition at 6s
    expect service.recovers within 9s
}
benchmark BenchJATP_06577 limit cpu 80ms memory 14MB
assert proof.complete == true
emit mcrt "PropertyJATP_06577.proof.mcrt"