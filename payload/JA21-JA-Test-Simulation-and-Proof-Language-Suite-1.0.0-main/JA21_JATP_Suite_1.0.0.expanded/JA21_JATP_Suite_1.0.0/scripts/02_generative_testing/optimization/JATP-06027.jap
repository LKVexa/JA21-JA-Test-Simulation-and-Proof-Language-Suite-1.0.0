module corpus.ja_proof.example_06027
use Proof
policy no_network

fixture FixtureJATP_06027 {
    input 15
    expected 210
}
unit test FixtureCheckJATP_06027 {
    let fixture_result = FixtureJATP_06027.input * 14
    assert fixture_result == FixtureJATP_06027.expected
}
property PropertyJATP_06027 for_all x: Count where x <= 15 {
    let result = x * 14
    invariant result >= x
}
simulation FailureJATP_06027 {
    virtual_time 15s
    inject network.partition at 14s
    expect service.recovers within 17s
}
benchmark BenchJATP_06027 limit cpu 15ms memory 22MB
assert proof.complete == true
emit mcrt "PropertyJATP_06027.proof.mcrt"