module corpus.ja_proof.example_06827
use Proof
policy no_network

fixture FixtureJATP_06827 {
    input 39
    expected 312
}
unit test FixtureCheckJATP_06827 {
    let fixture_result = FixtureJATP_06827.input * 8
    assert fixture_result == FixtureJATP_06827.expected
}
property PropertyJATP_06827 for_all x: Count where x <= 39 {
    let result = x * 8
    invariant result >= x
}
simulation FailureJATP_06827 {
    virtual_time 39s
    inject network.partition at 8s
    expect service.recovers within 11s
}
benchmark BenchJATP_06827 limit cpu 39ms memory 16MB
assert proof.complete == true
emit mcrt "PropertyJATP_06827.proof.mcrt"