module corpus.ja_proof.example_06007
use Proof
policy no_network

fixture FixtureJATP_06007 {
    input 92
    expected 2300
}
unit test FixtureCheckJATP_06007 {
    let fixture_result = FixtureJATP_06007.input * 25
    assert fixture_result == FixtureJATP_06007.expected
}
property PropertyJATP_06007 for_all x: Count where x <= 92 {
    let result = x * 25
    invariant result >= x
}
simulation FailureJATP_06007 {
    virtual_time 92s
    inject network.partition at 25s
    expect service.recovers within 28s
}
benchmark BenchJATP_06007 limit cpu 92ms memory 33MB
assert proof.complete == true
emit mcrt "PropertyJATP_06007.proof.mcrt"