module corpus.ja_proof.example_06327
use Proof
policy no_network

fixture FixtureJATP_06327 {
    input 24
    expected 96
}
unit test FixtureCheckJATP_06327 {
    let fixture_result = FixtureJATP_06327.input * 4
    assert fixture_result == FixtureJATP_06327.expected
}
property PropertyJATP_06327 for_all x: Count where x <= 24 {
    let result = x * 4
    invariant result >= x
}
simulation FailureJATP_06327 {
    virtual_time 24s
    inject network.partition at 4s
    expect service.recovers within 7s
}
benchmark BenchJATP_06327 limit cpu 24ms memory 12MB
assert proof.complete == true
emit mcrt "PropertyJATP_06327.proof.mcrt"