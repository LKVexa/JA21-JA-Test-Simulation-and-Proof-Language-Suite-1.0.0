module corpus.ja_proof.example_06167
use Proof
policy no_network

fixture FixtureJATP_06167 {
    input 58
    expected 1740
}
unit test FixtureCheckJATP_06167 {
    let fixture_result = FixtureJATP_06167.input * 30
    assert fixture_result == FixtureJATP_06167.expected
}
property PropertyJATP_06167 for_all x: Count where x <= 58 {
    let result = x * 30
    invariant result >= x
}
simulation FailureJATP_06167 {
    virtual_time 58s
    inject network.partition at 30s
    expect service.recovers within 33s
}
benchmark BenchJATP_06167 limit cpu 58ms memory 38MB
assert proof.complete == true
emit mcrt "PropertyJATP_06167.proof.mcrt"