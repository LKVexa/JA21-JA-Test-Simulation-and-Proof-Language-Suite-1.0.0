module corpus.ja_proof.example_06507
use Proof
policy no_network

fixture FixtureJATP_06507 {
    input 10
    expected 290
}
property PropertyJATP_06507 for_all x: Count where x <= 10 {
    let result = x * 29
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_06507 {
    virtual_time 10s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_06507 limit cpu 10ms memory 37MB
assert proof.complete == false
emit mcrt "PropertyJATP_06507.proof.mcrt"