module corpus.ja_proof.example_06257
use Proof
policy no_network

fixture FixtureJATP_06257 {
    input 51
    expected 1377
}
unit test FixtureCheckJATP_06257 {
    let fixture_result = FixtureJATP_06257.input * 27
    assert fixture_result == FixtureJATP_06257.expected
}
property PropertyJATP_06257 for_all x: Count where x <= 51 {
    let result = x * 27
    invariant result >= x
}
simulation FailureJATP_06257 {
    virtual_time 51s
    inject network.partition at 27s
    expect service.recovers within 30s
}
benchmark BenchJATP_06257 limit cpu 51ms memory 35MB
assert proof.complete == true
emit mcrt "PropertyJATP_06257.proof.mcrt"