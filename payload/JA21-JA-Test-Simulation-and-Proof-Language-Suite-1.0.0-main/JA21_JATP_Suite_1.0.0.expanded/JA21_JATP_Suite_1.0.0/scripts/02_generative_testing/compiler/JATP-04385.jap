module corpus.ja_proof.example_04385
use Proof
policy no_network

fixture FixtureJATP_04385 {
    input 22
    expected 330
}
unit test FixtureCheckJATP_04385 {
    let fixture_result = FixtureJATP_04385.input * 15
    assert fixture_result == FixtureJATP_04385.expected
}
property PropertyJATP_04385 for_all x: Count where x <= 22 {
    let result = x * 15
    invariant result >= x
}
simulation FailureJATP_04385 {
    virtual_time 22s
    inject network.partition at 15s
    expect service.recovers within 18s
}
benchmark BenchJATP_04385 limit cpu 22ms memory 23MB
assert proof.complete == true
emit mcrt "PropertyJATP_04385.proof.mcrt"