module corpus.ja_proof.example_04365
use Proof
policy no_network

fixture FixtureJATP_04365 {
    input 2
    expected 52
}
unit test FixtureCheckJATP_04365 {
    let fixture_result = FixtureJATP_04365.input * 26
    assert fixture_result == FixtureJATP_04365.expected
}
property PropertyJATP_04365 for_all x: Count where x <= 2 {
    let result = x * 26
    invariant result >= x
}
simulation FailureJATP_04365 {
    virtual_time 2s
    inject network.partition at 26s
    expect service.recovers within 29s
}
benchmark BenchJATP_04365 limit cpu 2ms memory 34MB
assert proof.complete == true
emit mcrt "PropertyJATP_04365.proof.mcrt"