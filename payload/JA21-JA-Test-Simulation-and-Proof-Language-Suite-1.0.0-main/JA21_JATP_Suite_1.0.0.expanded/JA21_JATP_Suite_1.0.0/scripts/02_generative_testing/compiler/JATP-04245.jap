module corpus.ja_proof.example_04245
use Proof
policy no_network

fixture FixtureJATP_04245 {
    input 76
    expected 2280
}
unit test FixtureCheckJATP_04245 {
    let fixture_result = FixtureJATP_04245.input * 30
    assert fixture_result == FixtureJATP_04245.expected
}
property PropertyJATP_04245 for_all x: Count where x <= 76 {
    let result = x * 30
    invariant result >= x
}
simulation FailureJATP_04245 {
    virtual_time 76s
    inject network.partition at 30s
    expect service.recovers within 33s
}
benchmark BenchJATP_04245 limit cpu 76ms memory 38MB
assert proof.complete == true
emit mcrt "PropertyJATP_04245.proof.mcrt"