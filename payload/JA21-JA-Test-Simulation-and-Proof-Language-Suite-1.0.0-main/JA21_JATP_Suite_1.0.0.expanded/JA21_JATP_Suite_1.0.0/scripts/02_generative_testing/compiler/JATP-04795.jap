module corpus.ja_proof.example_04795
use Proof
policy no_network

fixture FixtureJATP_04795 {
    input 44
    expected 968
}
property PropertyJATP_04795 for_all x: Count where x <= 44 {
    let result = x * 22
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_04795 {
    virtual_time 44s
    inject network.partition at 22s
    expect service.recovers within 25s
}
benchmark BenchJATP_04795 limit cpu 44ms memory 30MB
assert proof.complete == false
emit mcrt "PropertyJATP_04795.proof.mcrt"