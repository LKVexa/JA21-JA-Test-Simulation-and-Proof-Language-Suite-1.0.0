ja source 0.3
module corpus.ja_proof.example_04225
use Proof
policy no_network

fixture FixtureJATP_04225 {
    input 56
    expected 560
}
unit test FixtureCheckJATP_04225 {
    let fixture_result = FixtureJATP_04225.input * 10
    assert fixture_result == FixtureJATP_04225.expected
}
property PropertyJATP_04225 for_all x: Count where x <= 56 {
    let result = x * 10
    invariant result >= x
}
simulation FailureJATP_04225 {
    virtual_time 56s
    inject network.partition at 10s
    expect service.recovers within 13s
}
benchmark BenchJATP_04225 limit cpu 56ms memory 18MB
assert proof.complete == true
emit mcrt "PropertyJATP_04225.proof.mcrt"