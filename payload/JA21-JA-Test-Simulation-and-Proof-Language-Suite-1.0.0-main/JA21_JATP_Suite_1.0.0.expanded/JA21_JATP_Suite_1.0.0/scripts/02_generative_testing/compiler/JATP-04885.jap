module corpus.ja_proof.example_04885
use Proof
policy no_network

fixture FixtureJATP_04885 {
    input 37
    expected 703
}
unit test FixtureCheckJATP_04885 {
    let fixture_result = FixtureJATP_04885.input * 19
    assert fixture_result == FixtureJATP_04885.expected
}
property PropertyJATP_04885 for_all x: Count where x <= 37 {
    let result = x * 19
    invariant result >= x
}
simulation FailureJATP_04885 {
    virtual_time 37s
    inject network.partition at 19s
    expect service.recovers within 22s
}
benchmark BenchJATP_04885 limit cpu 37ms memory 27MB
assert proof.complete == true
emit mcrt "PropertyJATP_04885.proof.mcrt"