module corpus.ja_proof.example_04475
use Proof
policy no_network

fixture FixtureJATP_04475 {
    input 15
    expected 180
}
property PropertyJATP_04475 for_all x: Count where x <= 15 {
    let result = x * 12
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_04475 {
    virtual_time 15s
    inject network.partition at 12s
    expect service.recovers within 15s
}
benchmark BenchJATP_04475 limit cpu 15ms memory 20MB
assert proof.complete == false
emit mcrt "PropertyJATP_04475.proof.mcrt"