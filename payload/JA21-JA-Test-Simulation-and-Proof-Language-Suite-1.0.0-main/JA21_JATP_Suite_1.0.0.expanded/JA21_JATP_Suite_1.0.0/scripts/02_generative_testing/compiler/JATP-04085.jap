module corpus.ja_proof.example_04085
use Proof
policy no_network

fixture FixtureJATP_04085 {
    input 13
    expected 325
}
unit test FixtureCheckJATP_04085 {
    let fixture_result = FixtureJATP_04085.input * 25
    assert fixture_result == FixtureJATP_04085.expected
}
property PropertyJATP_04085 for_all x: Count where x <= 13 {
    let result = x * 25
    invariant result >= x
}
simulation FailureJATP_04085 {
    virtual_time 13s
    inject network.partition at 25s
    expect service.recovers within 28s
}
benchmark BenchJATP_04085 limit cpu 13ms memory 33MB
assert proof.complete == true
emit mcrt "PropertyJATP_04085.proof.mcrt"