ja source 0.3
module corpus.ja_proof.example_04045
use Proof
policy no_network

fixture FixtureJATP_04045 {
    input 70
    expected 1120
}
unit test FixtureCheckJATP_04045 {
    let fixture_result = FixtureJATP_04045.input * 16
    assert fixture_result == FixtureJATP_04045.expected
}
property PropertyJATP_04045 for_all x: Count where x <= 70 {
    let result = x * 16
    invariant result >= x
}
simulation FailureJATP_04045 {
    virtual_time 70s
    inject network.partition at 16s
    expect service.recovers within 19s
}
benchmark BenchJATP_04045 limit cpu 70ms memory 24MB
assert proof.complete == true
emit mcrt "PropertyJATP_04045.proof.mcrt"