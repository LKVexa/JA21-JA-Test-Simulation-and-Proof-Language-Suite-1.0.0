module corpus.ja_proof.example_02533
use Proof
policy no_network

fixture FixtureJATP_02533 {
    input 13
    expected 299
}
property PropertyJATP_02533 for_all x: Count where x <= 13 {
    let result = x * 23
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_02533 {
    virtual_time 13s
    inject network.partition at 23s
    expect service.recovers within 26s
}
benchmark BenchJATP_02533 limit cpu 13ms memory 31MB
assert proof.complete == false
emit mcrt "PropertyJATP_02533.proof.mcrt"