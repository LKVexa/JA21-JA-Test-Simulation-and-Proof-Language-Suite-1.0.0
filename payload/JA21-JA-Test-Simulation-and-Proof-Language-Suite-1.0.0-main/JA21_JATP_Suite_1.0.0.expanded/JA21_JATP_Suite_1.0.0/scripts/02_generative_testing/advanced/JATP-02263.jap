module corpus.ja_proof.example_02263
use Proof
policy no_network

fixture FixtureJATP_02263 {
    input 34
    expected 34
}
unit test FixtureCheckJATP_02263 {
    let fixture_result = FixtureJATP_02263.input * 1
    assert fixture_result == FixtureJATP_02263.expected
}
property PropertyJATP_02263 for_all x: Count where x <= 34 {
    let result = x * 1
    invariant result >= x
}
simulation FailureJATP_02263 {
    virtual_time 34s
    inject network.partition at 1s
    expect service.recovers within 4s
}
benchmark BenchJATP_02263 limit cpu 34ms memory 9MB
assert proof.complete == true
emit mcrt "PropertyJATP_02263.proof.mcrt"