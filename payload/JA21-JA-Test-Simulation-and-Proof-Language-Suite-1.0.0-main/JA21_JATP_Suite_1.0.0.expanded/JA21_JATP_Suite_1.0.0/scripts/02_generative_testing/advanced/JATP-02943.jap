module corpus.ja_proof.example_02943
use Proof
policy no_network

fixture FixtureJATP_02943 {
    input 35
    expected 1050
}
unit test FixtureCheckJATP_02943 {
    let fixture_result = FixtureJATP_02943.input * 30
    assert fixture_result == FixtureJATP_02943.expected
}
property PropertyJATP_02943 for_all x: Count where x <= 35 {
    let result = x * 30
    invariant result >= x
}
simulation FailureJATP_02943 {
    virtual_time 35s
    inject network.partition at 30s
    expect service.recovers within 33s
}
benchmark BenchJATP_02943 limit cpu 35ms memory 38MB
assert proof.complete == true
emit mcrt "PropertyJATP_02943.proof.mcrt"