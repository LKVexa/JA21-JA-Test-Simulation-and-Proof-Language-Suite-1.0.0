ja source 0.3
module corpus.ja_proof.example_02123
use Proof
policy no_network

fixture FixtureJATP_02123 {
    input 88
    expected 1408
}
unit test FixtureCheckJATP_02123 {
    let fixture_result = FixtureJATP_02123.input * 16
    assert fixture_result == FixtureJATP_02123.expected
}
property PropertyJATP_02123 for_all x: Count where x <= 88 {
    let result = x * 16
    invariant result >= x
}
simulation FailureJATP_02123 {
    virtual_time 88s
    inject network.partition at 16s
    expect service.recovers within 19s
}
benchmark BenchJATP_02123 limit cpu 88ms memory 24MB
assert proof.complete == true
emit mcrt "PropertyJATP_02123.proof.mcrt"