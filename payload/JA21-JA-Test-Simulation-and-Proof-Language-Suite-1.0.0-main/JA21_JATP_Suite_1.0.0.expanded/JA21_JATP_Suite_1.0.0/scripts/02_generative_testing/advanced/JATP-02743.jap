module corpus.ja_proof.example_02743
use Proof
policy no_network

fixture FixtureJATP_02743 {
    input 29
    expected 464
}
unit test FixtureCheckJATP_02743 {
    let fixture_result = FixtureJATP_02743.input * 16
    assert fixture_result == FixtureJATP_02743.expected
}
property PropertyJATP_02743 for_all x: Count where x <= 29 {
    let result = x * 16
    invariant result >= x
}
simulation FailureJATP_02743 {
    virtual_time 29s
    inject network.partition at 16s
    expect service.recovers within 19s
}
benchmark BenchJATP_02743 limit cpu 29ms memory 24MB
assert proof.complete == true
emit mcrt "PropertyJATP_02743.proof.mcrt"