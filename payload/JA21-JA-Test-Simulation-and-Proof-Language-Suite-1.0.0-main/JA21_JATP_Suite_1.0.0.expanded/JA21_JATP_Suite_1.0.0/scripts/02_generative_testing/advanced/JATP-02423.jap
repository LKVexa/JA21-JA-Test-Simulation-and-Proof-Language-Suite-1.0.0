module corpus.ja_proof.example_02423
use Proof
policy no_network

fixture FixtureJATP_02423 {
    input 97
    expected 582
}
property PropertyJATP_02423 for_all x: Count where x <= 97 {
    let result = x * 6
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_02423 {
    virtual_time 97s
    inject network.partition at 6s
    expect service.recovers within 9s
}
benchmark BenchJATP_02423 limit cpu 97ms memory 14MB
assert proof.complete == false
emit mcrt "PropertyJATP_02423.proof.mcrt"