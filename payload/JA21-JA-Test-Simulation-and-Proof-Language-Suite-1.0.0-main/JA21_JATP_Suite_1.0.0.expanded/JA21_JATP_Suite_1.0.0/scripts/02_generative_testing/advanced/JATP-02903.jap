module corpus.ja_proof.example_02903
use Proof
policy no_network

fixture FixtureJATP_02903 {
    input 92
    expected 1932
}
unit test FixtureCheckJATP_02903 {
    let fixture_result = FixtureJATP_02903.input * 21
    assert fixture_result == FixtureJATP_02903.expected
}
property PropertyJATP_02903 for_all x: Count where x <= 92 {
    let result = x * 21
    invariant result >= x
}
simulation FailureJATP_02903 {
    virtual_time 92s
    inject network.partition at 21s
    expect service.recovers within 24s
}
benchmark BenchJATP_02903 limit cpu 92ms memory 29MB
assert proof.complete == true
emit mcrt "PropertyJATP_02903.proof.mcrt"