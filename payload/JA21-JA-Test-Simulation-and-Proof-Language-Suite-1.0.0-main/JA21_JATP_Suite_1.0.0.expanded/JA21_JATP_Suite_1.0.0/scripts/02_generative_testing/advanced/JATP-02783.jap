module corpus.ja_proof.example_02783
use Proof
policy no_network

fixture FixtureJATP_02783 {
    input 69
    expected 1725
}
property PropertyJATP_02783 for_all x: Count where x <= 69 {
    let result = x * 25
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_02783 {
    virtual_time 69s
    inject network.partition at 25s
    expect service.recovers within 28s
}
benchmark BenchJATP_02783 limit cpu 69ms memory 33MB
assert proof.complete == false
emit mcrt "PropertyJATP_02783.proof.mcrt"