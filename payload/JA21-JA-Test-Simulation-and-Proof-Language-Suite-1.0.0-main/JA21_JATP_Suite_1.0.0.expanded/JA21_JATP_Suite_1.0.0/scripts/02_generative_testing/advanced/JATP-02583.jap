module corpus.ja_proof.example_02583
use Proof
policy no_network

fixture FixtureJATP_02583 {
    input 63
    expected 693
}
unit test FixtureCheckJATP_02583 {
    let fixture_result = FixtureJATP_02583.input * 11
    assert fixture_result == FixtureJATP_02583.expected
}
property PropertyJATP_02583 for_all x: Count where x <= 63 {
    let result = x * 11
    invariant result >= x
}
simulation FailureJATP_02583 {
    virtual_time 63s
    inject network.partition at 11s
    expect service.recovers within 14s
}
benchmark BenchJATP_02583 limit cpu 63ms memory 19MB
assert proof.complete == true
emit mcrt "PropertyJATP_02583.proof.mcrt"