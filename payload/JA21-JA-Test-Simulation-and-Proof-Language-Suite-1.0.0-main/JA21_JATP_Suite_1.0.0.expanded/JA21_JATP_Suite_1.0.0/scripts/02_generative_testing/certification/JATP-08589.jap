module corpus.ja_proof.example_08589
use Proof
policy no_network

fixture FixtureJATP_08589 {
    input 55
    expected 165
}
unit test FixtureCheckJATP_08589 {
    let fixture_result = FixtureJATP_08589.input * 3
    assert fixture_result == FixtureJATP_08589.expected
}
property PropertyJATP_08589 for_all x: Count where x <= 55 {
    let result = x * 3
    invariant result >= x
}
simulation FailureJATP_08589 {
    virtual_time 55s
    inject network.partition at 3s
    expect service.recovers within 6s
}
benchmark BenchJATP_08589 limit cpu 55ms memory 11MB
assert proof.complete == true
emit mcrt "PropertyJATP_08589.proof.mcrt"