module corpus.ja_proof.example_08089
use Proof
policy no_network

fixture FixtureJATP_08089 {
    input 40
    expected 1200
}
unit test FixtureCheckJATP_08089 {
    let fixture_result = FixtureJATP_08089.input * 30
    assert fixture_result == FixtureJATP_08089.expected
}
property PropertyJATP_08089 for_all x: Count where x <= 40 {
    let result = x * 30
    invariant result >= x
}
simulation FailureJATP_08089 {
    virtual_time 40s
    inject network.partition at 30s
    expect service.recovers within 33s
}
benchmark BenchJATP_08089 limit cpu 40ms memory 38MB
assert proof.complete == true
emit mcrt "PropertyJATP_08089.proof.mcrt"