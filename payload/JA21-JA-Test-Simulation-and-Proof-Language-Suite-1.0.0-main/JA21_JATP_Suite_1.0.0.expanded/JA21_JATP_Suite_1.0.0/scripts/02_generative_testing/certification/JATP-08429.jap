module corpus.ja_proof.example_08429
use Proof
policy no_network

fixture FixtureJATP_08429 {
    input 89
    expected 2581
}
property PropertyJATP_08429 for_all x: Count where x <= 89 {
    let result = x * 29
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_08429 {
    virtual_time 89s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_08429 limit cpu 89ms memory 37MB
assert proof.complete == false
emit mcrt "PropertyJATP_08429.proof.mcrt"