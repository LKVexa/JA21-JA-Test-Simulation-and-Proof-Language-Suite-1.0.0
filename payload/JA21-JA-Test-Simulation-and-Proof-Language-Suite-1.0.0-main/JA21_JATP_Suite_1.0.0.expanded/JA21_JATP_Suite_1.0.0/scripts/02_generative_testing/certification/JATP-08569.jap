module corpus.ja_proof.example_08569
use Proof
policy no_network

fixture FixtureJATP_08569 {
    input 35
    expected 490
}
unit test FixtureCheckJATP_08569 {
    let fixture_result = FixtureJATP_08569.input * 14
    assert fixture_result == FixtureJATP_08569.expected
}
property PropertyJATP_08569 for_all x: Count where x <= 35 {
    let result = x * 14
    invariant result >= x
}
simulation FailureJATP_08569 {
    virtual_time 35s
    inject network.partition at 14s
    expect service.recovers within 17s
}
benchmark BenchJATP_08569 limit cpu 35ms memory 22MB
assert proof.complete == true
emit mcrt "PropertyJATP_08569.proof.mcrt"