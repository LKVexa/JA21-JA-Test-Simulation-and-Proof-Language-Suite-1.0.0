module corpus.ja_proof.example_08109
use Proof
policy no_network

fixture FixtureJATP_08109 {
    input 60
    expected 1140
}
unit test FixtureCheckJATP_08109 {
    let fixture_result = FixtureJATP_08109.input * 19
    assert fixture_result == FixtureJATP_08109.expected
}
property PropertyJATP_08109 for_all x: Count where x <= 60 {
    let result = x * 19
    invariant result >= x
}
simulation FailureJATP_08109 {
    virtual_time 60s
    inject network.partition at 19s
    expect service.recovers within 22s
}
benchmark BenchJATP_08109 limit cpu 60ms memory 27MB
assert proof.complete == true
emit mcrt "PropertyJATP_08109.proof.mcrt"