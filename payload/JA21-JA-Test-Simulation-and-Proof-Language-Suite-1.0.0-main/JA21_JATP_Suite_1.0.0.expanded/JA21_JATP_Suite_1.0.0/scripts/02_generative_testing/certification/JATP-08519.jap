module corpus.ja_proof.example_08519
use Proof
policy no_network

fixture FixtureJATP_08519 {
    input 82
    expected 2132
}
property PropertyJATP_08519 for_all x: Count where x <= 82 {
    let result = x * 26
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_08519 {
    virtual_time 82s
    inject network.partition at 26s
    expect service.recovers within 29s
}
benchmark BenchJATP_08519 limit cpu 82ms memory 34MB
assert proof.complete == false
emit mcrt "PropertyJATP_08519.proof.mcrt"