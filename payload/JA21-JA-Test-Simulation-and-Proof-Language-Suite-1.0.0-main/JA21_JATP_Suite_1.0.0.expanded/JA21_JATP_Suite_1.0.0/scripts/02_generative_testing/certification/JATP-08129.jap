module corpus.ja_proof.example_08129
use Proof
policy no_network

fixture FixtureJATP_08129 {
    input 80
    expected 640
}
unit test FixtureCheckJATP_08129 {
    let fixture_result = FixtureJATP_08129.input * 8
    assert fixture_result == FixtureJATP_08129.expected
}
property PropertyJATP_08129 for_all x: Count where x <= 80 {
    let result = x * 8
    invariant result >= x
}
simulation FailureJATP_08129 {
    virtual_time 80s
    inject network.partition at 8s
    expect service.recovers within 11s
}
benchmark BenchJATP_08129 limit cpu 80ms memory 16MB
assert proof.complete == true
emit mcrt "PropertyJATP_08129.proof.mcrt"