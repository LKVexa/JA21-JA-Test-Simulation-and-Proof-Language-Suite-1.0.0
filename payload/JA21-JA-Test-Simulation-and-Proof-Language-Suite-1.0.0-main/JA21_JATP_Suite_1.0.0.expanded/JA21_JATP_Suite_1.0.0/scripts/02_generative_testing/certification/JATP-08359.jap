module corpus.ja_proof.example_08359
use Proof
policy no_network

fixture FixtureJATP_08359 {
    input 19
    expected 399
}
unit test FixtureCheckJATP_08359 {
    let fixture_result = FixtureJATP_08359.input * 21
    assert fixture_result == FixtureJATP_08359.expected
}
property PropertyJATP_08359 for_all x: Count where x <= 19 {
    let result = x * 21
    invariant result >= x
}
simulation FailureJATP_08359 {
    virtual_time 19s
    inject network.partition at 21s
    expect service.recovers within 24s
}
benchmark BenchJATP_08359 limit cpu 19ms memory 29MB
assert proof.complete == true
emit mcrt "PropertyJATP_08359.proof.mcrt"