module corpus.ja_proof.example_08289
use Proof
policy no_network

fixture FixtureJATP_08289 {
    input 46
    expected 598
}
unit test FixtureCheckJATP_08289 {
    let fixture_result = FixtureJATP_08289.input * 13
    assert fixture_result == FixtureJATP_08289.expected
}
property PropertyJATP_08289 for_all x: Count where x <= 46 {
    let result = x * 13
    invariant result >= x
}
simulation FailureJATP_08289 {
    virtual_time 46s
    inject network.partition at 13s
    expect service.recovers within 16s
}
benchmark BenchJATP_08289 limit cpu 46ms memory 21MB
assert proof.complete == true
emit mcrt "PropertyJATP_08289.proof.mcrt"