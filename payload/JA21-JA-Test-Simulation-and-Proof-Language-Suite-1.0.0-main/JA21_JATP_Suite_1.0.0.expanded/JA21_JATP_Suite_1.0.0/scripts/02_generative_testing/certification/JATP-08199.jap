module corpus.ja_proof.example_08199
use Proof
policy no_network

fixture FixtureJATP_08199 {
    input 53
    expected 848
}
unit test FixtureCheckJATP_08199 {
    let fixture_result = FixtureJATP_08199.input * 16
    assert fixture_result == FixtureJATP_08199.expected
}
property PropertyJATP_08199 for_all x: Count where x <= 53 {
    let result = x * 16
    invariant result >= x
}
simulation FailureJATP_08199 {
    virtual_time 53s
    inject network.partition at 16s
    expect service.recovers within 19s
}
benchmark BenchJATP_08199 limit cpu 53ms memory 24MB
assert proof.complete == true
emit mcrt "PropertyJATP_08199.proof.mcrt"