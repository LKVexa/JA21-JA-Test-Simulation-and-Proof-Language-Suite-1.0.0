module corpus.ja_proof.example_09410
use Proof
policy no_network

fixture FixtureJATP_09410 {
    input 3
    expected 54
}
property PropertyJATP_09410 for_all x: Count where x <= 3 {
    let result = x * 18
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_09410 {
    virtual_time 3s
    inject network.partition at 18s
    expect service.recovers within 21s
}
benchmark BenchJATP_09410 limit cpu 3ms memory 26MB
assert proof.complete == false
emit mcrt "PropertyJATP_09410.proof.mcrt"