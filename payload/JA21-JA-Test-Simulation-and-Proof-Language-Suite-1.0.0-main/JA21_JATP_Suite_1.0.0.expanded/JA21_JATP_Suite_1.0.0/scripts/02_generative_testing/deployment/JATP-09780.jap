module corpus.ja_proof.example_09780
use Proof
policy no_network

fixture FixtureJATP_09780 {
    input 82
    expected 1312
}
property PropertyJATP_09780 for_all x: Count where x <= 82 {
    let result = x * 16
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_09780 {
    virtual_time 82s
    inject network.partition at 16s
    expect service.recovers within 19s
}
benchmark BenchJATP_09780 limit cpu 82ms memory 24MB
assert proof.complete == false
emit mcrt "PropertyJATP_09780.proof.mcrt"