module corpus.ja_proof.example_09640
use Proof
policy no_network

fixture FixtureJATP_09640 {
    input 39
    expected 1209
}
unit test FixtureCheckJATP_09640 {
    let fixture_result = FixtureJATP_09640.input * 31
    assert fixture_result == FixtureJATP_09640.expected
}
property PropertyJATP_09640 for_all x: Count where x <= 39 {
    let result = x * 31
    invariant result >= x
}
simulation FailureJATP_09640 {
    virtual_time 39s
    inject network.partition at 31s
    expect service.recovers within 34s
}
benchmark BenchJATP_09640 limit cpu 39ms memory 39MB
assert proof.complete == true
emit mcrt "PropertyJATP_09640.proof.mcrt"