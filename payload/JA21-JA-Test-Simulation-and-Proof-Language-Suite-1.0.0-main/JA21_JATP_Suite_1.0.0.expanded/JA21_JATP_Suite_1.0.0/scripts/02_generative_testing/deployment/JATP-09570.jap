module corpus.ja_proof.example_09570
use Proof
policy no_network

fixture FixtureJATP_09570 {
    input 66
    expected 1518
}
unit test FixtureCheckJATP_09570 {
    let fixture_result = FixtureJATP_09570.input * 23
    assert fixture_result == FixtureJATP_09570.expected
}
property PropertyJATP_09570 for_all x: Count where x <= 66 {
    let result = x * 23
    invariant result >= x
}
simulation FailureJATP_09570 {
    virtual_time 66s
    inject network.partition at 23s
    expect service.recovers within 26s
}
benchmark BenchJATP_09570 limit cpu 66ms memory 31MB
assert proof.complete == true
emit mcrt "PropertyJATP_09570.proof.mcrt"