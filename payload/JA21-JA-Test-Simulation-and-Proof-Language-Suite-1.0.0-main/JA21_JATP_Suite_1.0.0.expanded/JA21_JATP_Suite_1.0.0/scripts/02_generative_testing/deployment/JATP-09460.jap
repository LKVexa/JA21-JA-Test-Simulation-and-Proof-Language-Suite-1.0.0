module corpus.ja_proof.example_09460
use Proof
policy no_network

fixture FixtureJATP_09460 {
    input 53
    expected 318
}
property PropertyJATP_09460 for_all x: Count where x <= 53 {
    let result = x * 6
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_09460 {
    virtual_time 53s
    inject network.partition at 6s
    expect service.recovers within 9s
}
benchmark BenchJATP_09460 limit cpu 53ms memory 14MB
assert proof.complete == false
emit mcrt "PropertyJATP_09460.proof.mcrt"