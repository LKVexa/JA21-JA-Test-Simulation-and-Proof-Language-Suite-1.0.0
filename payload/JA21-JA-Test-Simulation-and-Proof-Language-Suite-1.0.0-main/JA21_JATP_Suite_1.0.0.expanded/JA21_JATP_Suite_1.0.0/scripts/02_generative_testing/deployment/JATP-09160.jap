module corpus.ja_proof.example_09160
use Proof
policy no_network

fixture FixtureJATP_09160 {
    input 44
    expected 704
}
unit test FixtureCheckJATP_09160 {
    let fixture_result = FixtureJATP_09160.input * 16
    assert fixture_result == FixtureJATP_09160.expected
}
property PropertyJATP_09160 for_all x: Count where x <= 44 {
    let result = x * 16
    invariant result >= x
}
simulation FailureJATP_09160 {
    virtual_time 44s
    inject network.partition at 16s
    expect service.recovers within 19s
}
benchmark BenchJATP_09160 limit cpu 44ms memory 24MB
assert proof.complete == true
emit mcrt "PropertyJATP_09160.proof.mcrt"