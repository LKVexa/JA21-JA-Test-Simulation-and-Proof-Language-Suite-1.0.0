module corpus.ja_proof.example_05936
use Proof
policy no_network

fixture FixtureJATP_05936 {
    input 21
    expected 336
}
unit test FixtureCheckJATP_05936 {
    let fixture_result = FixtureJATP_05936.input * 16
    assert fixture_result == FixtureJATP_05936.expected
}
property PropertyJATP_05936 for_all x: Count where x <= 21 {
    let result = x * 16
    invariant result >= x
}
simulation FailureJATP_05936 {
    virtual_time 21s
    inject network.partition at 16s
    expect service.recovers within 19s
}
benchmark BenchJATP_05936 limit cpu 21ms memory 24MB
assert proof.complete == true
emit mcrt "PropertyJATP_05936.proof.mcrt"