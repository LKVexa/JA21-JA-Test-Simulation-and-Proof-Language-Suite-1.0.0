module corpus.ja_proof.example_05686
use Proof
policy no_network

fixture FixtureJATP_05686 {
    input 62
    expected 868
}
unit test FixtureCheckJATP_05686 {
    let fixture_result = FixtureJATP_05686.input * 14
    assert fixture_result == FixtureJATP_05686.expected
}
property PropertyJATP_05686 for_all x: Count where x <= 62 {
    let result = x * 14
    invariant result >= x
}
simulation FailureJATP_05686 {
    virtual_time 62s
    inject network.partition at 14s
    expect service.recovers within 17s
}
benchmark BenchJATP_05686 limit cpu 62ms memory 22MB
assert proof.complete == true
emit mcrt "PropertyJATP_05686.proof.mcrt"