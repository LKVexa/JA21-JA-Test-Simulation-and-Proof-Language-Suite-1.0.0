module corpus.ja_proof.example_05756
use Proof
policy no_network

fixture FixtureJATP_05756 {
    input 35
    expected 770
}
property PropertyJATP_05756 for_all x: Count where x <= 35 {
    let result = x * 22
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_05756 {
    virtual_time 35s
    inject network.partition at 22s
    expect service.recovers within 25s
}
benchmark BenchJATP_05756 limit cpu 35ms memory 30MB
assert proof.complete == false
emit mcrt "PropertyJATP_05756.proof.mcrt"