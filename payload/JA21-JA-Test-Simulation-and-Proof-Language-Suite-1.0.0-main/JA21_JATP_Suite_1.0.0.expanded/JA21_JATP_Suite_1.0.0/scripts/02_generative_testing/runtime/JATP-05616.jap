module corpus.ja_proof.example_05616
use Proof
policy no_network

fixture FixtureJATP_05616 {
    input 89
    expected 534
}
unit test FixtureCheckJATP_05616 {
    let fixture_result = FixtureJATP_05616.input * 6
    assert fixture_result == FixtureJATP_05616.expected
}
property PropertyJATP_05616 for_all x: Count where x <= 89 {
    let result = x * 6
    invariant result >= x
}
simulation FailureJATP_05616 {
    virtual_time 89s
    inject network.partition at 6s
    expect service.recovers within 9s
}
benchmark BenchJATP_05616 limit cpu 89ms memory 14MB
assert proof.complete == true
emit mcrt "PropertyJATP_05616.proof.mcrt"