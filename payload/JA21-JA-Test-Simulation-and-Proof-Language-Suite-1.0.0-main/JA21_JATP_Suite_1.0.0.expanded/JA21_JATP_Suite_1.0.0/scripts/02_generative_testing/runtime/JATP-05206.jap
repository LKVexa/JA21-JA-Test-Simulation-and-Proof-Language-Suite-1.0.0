module corpus.ja_proof.example_05206
use Proof
policy no_network

fixture FixtureJATP_05206 {
    input 67
    expected 2010
}
unit test FixtureCheckJATP_05206 {
    let fixture_result = FixtureJATP_05206.input * 30
    assert fixture_result == FixtureJATP_05206.expected
}
property PropertyJATP_05206 for_all x: Count where x <= 67 {
    let result = x * 30
    invariant result >= x
}
simulation FailureJATP_05206 {
    virtual_time 67s
    inject network.partition at 30s
    expect service.recovers within 33s
}
benchmark BenchJATP_05206 limit cpu 67ms memory 38MB
assert proof.complete == true
emit mcrt "PropertyJATP_05206.proof.mcrt"