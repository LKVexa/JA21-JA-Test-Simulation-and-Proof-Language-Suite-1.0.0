module corpus.ja_proof.example_00201
use Proof
policy no_network

fixture FixtureJATP_00201 {
    input 9
    expected 144
}
unit test FixtureCheckJATP_00201 {
    let fixture_result = FixtureJATP_00201.input * 16
    assert fixture_result == FixtureJATP_00201.expected
}
property PropertyJATP_00201 for_all x: Count where x <= 9 {
    let result = x * 16
    invariant result >= x
}
simulation FailureJATP_00201 {
    virtual_time 9s
    inject network.partition at 16s
    expect service.recovers within 19s
}
benchmark BenchJATP_00201 limit cpu 9ms memory 24MB
assert proof.complete == true
emit mcrt "PropertyJATP_00201.proof.mcrt"