module corpus.ja_proof.example_00751
use Proof
policy no_network

fixture FixtureJATP_00751 {
    input 74
    expected 592
}
property PropertyJATP_00751 for_all x: Count where x <= 74 {
    let result = x * 8
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_00751 {
    virtual_time 74s
    inject network.partition at 8s
    expect service.recovers within 11s
}
benchmark BenchJATP_00751 limit cpu 74ms memory 16MB
assert proof.complete == false
emit mcrt "PropertyJATP_00751.proof.mcrt"