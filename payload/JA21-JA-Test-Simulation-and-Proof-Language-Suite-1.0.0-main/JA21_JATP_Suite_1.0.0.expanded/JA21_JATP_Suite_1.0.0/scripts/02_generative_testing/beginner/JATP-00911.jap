module corpus.ja_proof.example_00911
use Proof
policy no_network

fixture FixtureJATP_00911 {
    input 40
    expected 520
}
unit test FixtureCheckJATP_00911 {
    let fixture_result = FixtureJATP_00911.input * 13
    assert fixture_result == FixtureJATP_00911.expected
}
property PropertyJATP_00911 for_all x: Count where x <= 40 {
    let result = x * 13
    invariant result >= x
}
simulation FailureJATP_00911 {
    virtual_time 40s
    inject network.partition at 13s
    expect service.recovers within 16s
}
benchmark BenchJATP_00911 limit cpu 40ms memory 21MB
assert proof.complete == true
emit mcrt "PropertyJATP_00911.proof.mcrt"