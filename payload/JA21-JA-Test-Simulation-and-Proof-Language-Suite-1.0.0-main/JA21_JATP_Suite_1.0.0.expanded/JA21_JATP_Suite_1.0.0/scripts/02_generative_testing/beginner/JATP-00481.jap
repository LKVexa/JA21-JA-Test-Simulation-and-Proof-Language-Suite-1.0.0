module corpus.ja_proof.example_00481
use Proof
policy no_network

fixture FixtureJATP_00481 {
    input 95
    expected 1615
}
property PropertyJATP_00481 for_all x: Count where x <= 95 {
    let result = x * 17
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_00481 {
    virtual_time 95s
    inject network.partition at 17s
    expect service.recovers within 20s
}
benchmark BenchJATP_00481 limit cpu 95ms memory 25MB
assert proof.complete == false
emit mcrt "PropertyJATP_00481.proof.mcrt"