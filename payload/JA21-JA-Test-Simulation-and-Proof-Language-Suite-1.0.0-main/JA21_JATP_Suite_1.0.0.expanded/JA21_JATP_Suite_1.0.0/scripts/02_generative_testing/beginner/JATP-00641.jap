module corpus.ja_proof.example_00641
use Proof
policy no_network

fixture FixtureJATP_00641 {
    input 61
    expected 1342
}
unit test FixtureCheckJATP_00641 {
    let fixture_result = FixtureJATP_00641.input * 22
    assert fixture_result == FixtureJATP_00641.expected
}
property PropertyJATP_00641 for_all x: Count where x <= 61 {
    let result = x * 22
    invariant result >= x
}
simulation FailureJATP_00641 {
    virtual_time 61s
    inject network.partition at 22s
    expect service.recovers within 25s
}
benchmark BenchJATP_00641 limit cpu 61ms memory 30MB
assert proof.complete == true
emit mcrt "PropertyJATP_00641.proof.mcrt"