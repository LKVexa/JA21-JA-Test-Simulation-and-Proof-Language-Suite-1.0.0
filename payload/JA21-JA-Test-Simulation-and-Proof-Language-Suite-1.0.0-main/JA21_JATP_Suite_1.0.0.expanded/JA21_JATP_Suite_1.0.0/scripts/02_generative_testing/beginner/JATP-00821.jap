module corpus.ja_proof.example_00821
use Proof
policy no_network

fixture FixtureJATP_00821 {
    input 47
    expected 752
}
property PropertyJATP_00821 for_all x: Count where x <= 47 {
    let result = x * 16
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_00821 {
    virtual_time 47s
    inject network.partition at 16s
    expect service.recovers within 19s
}
benchmark BenchJATP_00821 limit cpu 47ms memory 24MB
assert proof.complete == false
emit mcrt "PropertyJATP_00821.proof.mcrt"