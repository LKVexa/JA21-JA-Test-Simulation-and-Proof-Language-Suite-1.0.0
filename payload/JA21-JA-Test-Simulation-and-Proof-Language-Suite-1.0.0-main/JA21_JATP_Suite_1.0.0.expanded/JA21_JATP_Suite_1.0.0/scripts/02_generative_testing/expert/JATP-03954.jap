module corpus.ja_proof.example_03954
use Proof
policy no_network

fixture FixtureJATP_03954 {
    input 76
    expected 1368
}
property PropertyJATP_03954 for_all x: Count where x <= 76 {
    let result = x * 18
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_03954 {
    virtual_time 76s
    inject network.partition at 18s
    expect service.recovers within 21s
}
benchmark BenchJATP_03954 limit cpu 76ms memory 26MB
assert proof.complete == false
emit mcrt "PropertyJATP_03954.proof.mcrt"