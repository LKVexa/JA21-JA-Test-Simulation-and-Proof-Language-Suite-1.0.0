module corpus.ja_proof.example_03474
use Proof
policy no_network

fixture FixtureJATP_03474 {
    input 81
    expected 243
}
property PropertyJATP_03474 for_all x: Count where x <= 81 {
    let result = x * 3
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_03474 {
    virtual_time 81s
    inject network.partition at 3s
    expect service.recovers within 6s
}
benchmark BenchJATP_03474 limit cpu 81ms memory 11MB
assert proof.complete == false
emit mcrt "PropertyJATP_03474.proof.mcrt"