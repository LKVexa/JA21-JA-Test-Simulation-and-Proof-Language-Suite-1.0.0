module corpus.ja_proof.example_03674
use Proof
policy no_network

fixture FixtureJATP_03674 {
    input 87
    expected 1479
}
unit test FixtureCheckJATP_03674 {
    let fixture_result = FixtureJATP_03674.input * 17
    assert fixture_result == FixtureJATP_03674.expected
}
property PropertyJATP_03674 for_all x: Count where x <= 87 {
    let result = x * 17
    invariant result >= x
}
simulation FailureJATP_03674 {
    virtual_time 87s
    inject network.partition at 17s
    expect service.recovers within 20s
}
benchmark BenchJATP_03674 limit cpu 87ms memory 25MB
assert proof.complete == true
emit mcrt "PropertyJATP_03674.proof.mcrt"