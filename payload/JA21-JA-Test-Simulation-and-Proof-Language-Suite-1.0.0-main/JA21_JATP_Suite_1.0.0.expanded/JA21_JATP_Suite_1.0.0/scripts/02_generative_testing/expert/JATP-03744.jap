module corpus.ja_proof.example_03744
use Proof
policy no_network

fixture FixtureJATP_03744 {
    input 60
    expected 1500
}
unit test FixtureCheckJATP_03744 {
    let fixture_result = FixtureJATP_03744.input * 25
    assert fixture_result == FixtureJATP_03744.expected
}
property PropertyJATP_03744 for_all x: Count where x <= 60 {
    let result = x * 25
    invariant result >= x
}
simulation FailureJATP_03744 {
    virtual_time 60s
    inject network.partition at 25s
    expect service.recovers within 28s
}
benchmark BenchJATP_03744 limit cpu 60ms memory 33MB
assert proof.complete == true
emit mcrt "PropertyJATP_03744.proof.mcrt"