module corpus.ja_proof.example_03904
use Proof
policy no_network

fixture FixtureJATP_03904 {
    input 26
    expected 780
}
unit test FixtureCheckJATP_03904 {
    let fixture_result = FixtureJATP_03904.input * 30
    assert fixture_result == FixtureJATP_03904.expected
}
property PropertyJATP_03904 for_all x: Count where x <= 26 {
    let result = x * 30
    invariant result >= x
}
simulation FailureJATP_03904 {
    virtual_time 26s
    inject network.partition at 30s
    expect service.recovers within 33s
}
benchmark BenchJATP_03904 limit cpu 26ms memory 38MB
assert proof.complete == true
emit mcrt "PropertyJATP_03904.proof.mcrt"