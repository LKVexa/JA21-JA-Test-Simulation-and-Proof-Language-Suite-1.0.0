module corpus.ja_proof.example_03154
use Proof
policy no_network

fixture FixtureJATP_03154 {
    input 52
    expected 1248
}
unit test FixtureCheckJATP_03154 {
    let fixture_result = FixtureJATP_03154.input * 24
    assert fixture_result == FixtureJATP_03154.expected
}
property PropertyJATP_03154 for_all x: Count where x <= 52 {
    let result = x * 24
    invariant result >= x
}
simulation FailureJATP_03154 {
    virtual_time 52s
    inject network.partition at 24s
    expect service.recovers within 27s
}
benchmark BenchJATP_03154 limit cpu 52ms memory 32MB
assert proof.complete == true
emit mcrt "PropertyJATP_03154.proof.mcrt"