module corpus.ja_proof.example_03424
use Proof
policy no_network

fixture FixtureJATP_03424 {
    input 31
    expected 465
}
property PropertyJATP_03424 for_all x: Count where x <= 31 {
    let result = x * 15
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_03424 {
    virtual_time 31s
    inject network.partition at 15s
    expect service.recovers within 18s
}
benchmark BenchJATP_03424 limit cpu 31ms memory 23MB
assert proof.complete == false
emit mcrt "PropertyJATP_03424.proof.mcrt"