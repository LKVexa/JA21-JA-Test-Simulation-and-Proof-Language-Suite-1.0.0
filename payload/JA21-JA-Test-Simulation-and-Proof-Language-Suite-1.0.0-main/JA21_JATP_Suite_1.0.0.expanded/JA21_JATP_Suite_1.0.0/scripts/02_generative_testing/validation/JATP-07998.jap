module corpus.ja_proof.example_07998
use Proof
policy no_network

fixture FixtureJATP_07998 {
    input 46
    expected 46
}
unit test FixtureCheckJATP_07998 {
    let fixture_result = FixtureJATP_07998.input * 1
    assert fixture_result == FixtureJATP_07998.expected
}
property PropertyJATP_07998 for_all x: Count where x <= 46 {
    let result = x * 1
    invariant result >= x
}
simulation FailureJATP_07998 {
    virtual_time 46s
    inject network.partition at 1s
    expect service.recovers within 4s
}
benchmark BenchJATP_07998 limit cpu 46ms memory 9MB
assert proof.complete == true
emit mcrt "PropertyJATP_07998.proof.mcrt"