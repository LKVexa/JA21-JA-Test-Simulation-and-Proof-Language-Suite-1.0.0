module corpus.ja_proof.example_07678
use Proof
policy no_network

fixture FixtureJATP_07678 {
    input 17
    expected 374
}
unit test FixtureCheckJATP_07678 {
    let fixture_result = FixtureJATP_07678.input * 22
    assert fixture_result == FixtureJATP_07678.expected
}
property PropertyJATP_07678 for_all x: Count where x <= 17 {
    let result = x * 22
    invariant result >= x
}
simulation FailureJATP_07678 {
    virtual_time 17s
    inject network.partition at 22s
    expect service.recovers within 25s
}
benchmark BenchJATP_07678 limit cpu 17ms memory 30MB
assert proof.complete == true
emit mcrt "PropertyJATP_07678.proof.mcrt"