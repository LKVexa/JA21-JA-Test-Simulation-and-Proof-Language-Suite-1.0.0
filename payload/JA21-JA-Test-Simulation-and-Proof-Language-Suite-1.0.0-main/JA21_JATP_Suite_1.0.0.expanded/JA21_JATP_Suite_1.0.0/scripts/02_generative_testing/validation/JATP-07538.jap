module corpus.ja_proof.example_07538
use Proof
policy no_network

fixture FixtureJATP_07538 {
    input 71
    expected 426
}
property PropertyJATP_07538 for_all x: Count where x <= 71 {
    let result = x * 6
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_07538 {
    virtual_time 71s
    inject network.partition at 6s
    expect service.recovers within 9s
}
benchmark BenchJATP_07538 limit cpu 71ms memory 14MB
assert proof.complete == false
emit mcrt "PropertyJATP_07538.proof.mcrt"