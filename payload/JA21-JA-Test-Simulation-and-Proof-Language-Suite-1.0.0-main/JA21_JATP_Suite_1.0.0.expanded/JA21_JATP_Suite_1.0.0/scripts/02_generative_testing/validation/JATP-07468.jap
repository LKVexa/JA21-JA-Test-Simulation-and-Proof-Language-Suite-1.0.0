module corpus.ja_proof.example_07468
use Proof
policy no_network

fixture FixtureJATP_07468 {
    input 98
    expected 2842
}
property PropertyJATP_07468 for_all x: Count where x <= 98 {
    let result = x * 29
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_07468 {
    virtual_time 98s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_07468 limit cpu 98ms memory 37MB
assert proof.complete == false
emit mcrt "PropertyJATP_07468.proof.mcrt"