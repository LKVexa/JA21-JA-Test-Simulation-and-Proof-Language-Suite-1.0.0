module corpus.ja_proof.example_07078
use Proof
policy no_network

fixture FixtureJATP_07078 {
    input 96
    expected 1056
}
unit test FixtureCheckJATP_07078 {
    let fixture_result = FixtureJATP_07078.input * 11
    assert fixture_result == FixtureJATP_07078.expected
}
property PropertyJATP_07078 for_all x: Count where x <= 96 {
    let result = x * 11
    invariant result >= x
}
simulation FailureJATP_07078 {
    virtual_time 96s
    inject network.partition at 11s
    expect service.recovers within 14s
}
benchmark BenchJATP_07078 limit cpu 96ms memory 19MB
assert proof.complete == true
emit mcrt "PropertyJATP_07078.proof.mcrt"