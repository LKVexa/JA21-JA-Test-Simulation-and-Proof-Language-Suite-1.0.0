module corpus.ja_proof.example_07948
use Proof
policy no_network

fixture FixtureJATP_07948 {
    input 93
    expected 1209
}
unit test FixtureCheckJATP_07948 {
    let fixture_result = FixtureJATP_07948.input * 13
    assert fixture_result == FixtureJATP_07948.expected
}
property PropertyJATP_07948 for_all x: Count where x <= 93 {
    let result = x * 13
    invariant result >= x
}
simulation FailureJATP_07948 {
    virtual_time 93s
    inject network.partition at 13s
    expect service.recovers within 16s
}
benchmark BenchJATP_07948 limit cpu 93ms memory 21MB
assert proof.complete == true
emit mcrt "PropertyJATP_07948.proof.mcrt"