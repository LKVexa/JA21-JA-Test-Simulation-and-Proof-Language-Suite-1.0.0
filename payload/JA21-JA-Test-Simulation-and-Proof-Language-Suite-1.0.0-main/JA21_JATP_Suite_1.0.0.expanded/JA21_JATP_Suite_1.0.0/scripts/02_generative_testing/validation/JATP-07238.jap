module corpus.ja_proof.example_07238
use Proof
policy no_network

fixture FixtureJATP_07238 {
    input 62
    expected 992
}
unit test FixtureCheckJATP_07238 {
    let fixture_result = FixtureJATP_07238.input * 16
    assert fixture_result == FixtureJATP_07238.expected
}
property PropertyJATP_07238 for_all x: Count where x <= 62 {
    let result = x * 16
    invariant result >= x
}
simulation FailureJATP_07238 {
    virtual_time 62s
    inject network.partition at 16s
    expect service.recovers within 19s
}
benchmark BenchJATP_07238 limit cpu 62ms memory 24MB
assert proof.complete == true
emit mcrt "PropertyJATP_07238.proof.mcrt"