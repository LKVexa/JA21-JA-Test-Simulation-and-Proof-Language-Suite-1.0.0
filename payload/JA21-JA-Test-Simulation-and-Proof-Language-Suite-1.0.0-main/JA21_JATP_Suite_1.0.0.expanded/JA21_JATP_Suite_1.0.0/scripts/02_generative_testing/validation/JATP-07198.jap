module corpus.ja_proof.example_07198
use Proof
policy no_network

fixture FixtureJATP_07198 {
    input 22
    expected 154
}
unit test FixtureCheckJATP_07198 {
    let fixture_result = FixtureJATP_07198.input * 7
    assert fixture_result == FixtureJATP_07198.expected
}
property PropertyJATP_07198 for_all x: Count where x <= 22 {
    let result = x * 7
    invariant result >= x
}
simulation FailureJATP_07198 {
    virtual_time 22s
    inject network.partition at 7s
    expect service.recovers within 10s
}
benchmark BenchJATP_07198 limit cpu 22ms memory 15MB
assert proof.complete == true
emit mcrt "PropertyJATP_07198.proof.mcrt"