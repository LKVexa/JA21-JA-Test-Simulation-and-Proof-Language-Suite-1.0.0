module corpus.ja_proof.example_01572
use Proof
policy no_network

fixture FixtureJATP_01572 {
    input 22
    expected 506
}
unit test FixtureCheckJATP_01572 {
    let fixture_result = FixtureJATP_01572.input * 23
    assert fixture_result == FixtureJATP_01572.expected
}
property PropertyJATP_01572 for_all x: Count where x <= 22 {
    let result = x * 23
    invariant result >= x
}
simulation FailureJATP_01572 {
    virtual_time 22s
    inject network.partition at 23s
    expect service.recovers within 26s
}
benchmark BenchJATP_01572 limit cpu 22ms memory 31MB
assert proof.complete == true
emit mcrt "PropertyJATP_01572.proof.mcrt"