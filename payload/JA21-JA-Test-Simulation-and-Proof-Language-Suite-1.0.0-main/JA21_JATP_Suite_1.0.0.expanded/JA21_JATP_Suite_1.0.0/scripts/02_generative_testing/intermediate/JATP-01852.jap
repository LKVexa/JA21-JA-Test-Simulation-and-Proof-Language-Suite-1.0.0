module corpus.ja_proof.example_01852
use Proof
policy no_network

fixture FixtureJATP_01852 {
    input 11
    expected 264
}
unit test FixtureCheckJATP_01852 {
    let fixture_result = FixtureJATP_01852.input * 24
    assert fixture_result == FixtureJATP_01852.expected
}
property PropertyJATP_01852 for_all x: Count where x <= 11 {
    let result = x * 24
    invariant result >= x
}
simulation FailureJATP_01852 {
    virtual_time 11s
    inject network.partition at 24s
    expect service.recovers within 27s
}
benchmark BenchJATP_01852 limit cpu 11ms memory 32MB
assert proof.complete == true
emit mcrt "PropertyJATP_01852.proof.mcrt"