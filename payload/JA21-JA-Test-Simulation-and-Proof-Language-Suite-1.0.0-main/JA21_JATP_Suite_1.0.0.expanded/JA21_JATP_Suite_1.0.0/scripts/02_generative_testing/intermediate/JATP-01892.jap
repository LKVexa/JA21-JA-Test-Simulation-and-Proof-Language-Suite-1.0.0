module corpus.ja_proof.example_01892
use Proof
policy no_network

fixture FixtureJATP_01892 {
    input 51
    expected 102
}
unit test FixtureCheckJATP_01892 {
    let fixture_result = FixtureJATP_01892.input * 2
    assert fixture_result == FixtureJATP_01892.expected
}
property PropertyJATP_01892 for_all x: Count where x <= 51 {
    let result = x * 2
    invariant result >= x
}
simulation FailureJATP_01892 {
    virtual_time 51s
    inject network.partition at 2s
    expect service.recovers within 5s
}
benchmark BenchJATP_01892 limit cpu 51ms memory 10MB
assert proof.complete == true
emit mcrt "PropertyJATP_01892.proof.mcrt"