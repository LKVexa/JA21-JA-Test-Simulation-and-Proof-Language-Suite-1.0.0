ja source 0.3
module corpus.ja_proof.example_01212
use Proof
policy no_network

fixture FixtureJATP_01212 {
    input 50
    expected 200
}
unit test FixtureCheckJATP_01212 {
    let fixture_result = FixtureJATP_01212.input * 4
    assert fixture_result == FixtureJATP_01212.expected
}
property PropertyJATP_01212 for_all x: Count where x <= 50 {
    let result = x * 4
    invariant result >= x
}
simulation FailureJATP_01212 {
    virtual_time 50s
    inject network.partition at 4s
    expect service.recovers within 7s
}
benchmark BenchJATP_01212 limit cpu 50ms memory 12MB
assert proof.complete == true
emit mcrt "PropertyJATP_01212.proof.mcrt"