module corpus.ja_proof.example_01392
use Proof
policy no_network

fixture FixtureJATP_01392 {
    input 36
    expected 1044
}
unit test FixtureCheckJATP_01392 {
    let fixture_result = FixtureJATP_01392.input * 29
    assert fixture_result == FixtureJATP_01392.expected
}
property PropertyJATP_01392 for_all x: Count where x <= 36 {
    let result = x * 29
    invariant result >= x
}
simulation FailureJATP_01392 {
    virtual_time 36s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_01392 limit cpu 36ms memory 37MB
assert proof.complete == true
emit mcrt "PropertyJATP_01392.proof.mcrt"