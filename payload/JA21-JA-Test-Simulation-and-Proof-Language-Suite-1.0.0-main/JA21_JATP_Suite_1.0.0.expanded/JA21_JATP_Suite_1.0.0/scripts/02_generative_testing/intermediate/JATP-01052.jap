module corpus.ja_proof.example_01052
use Proof
policy no_network

fixture FixtureJATP_01052 {
    input 84
    expected 2520
}
unit test FixtureCheckJATP_01052 {
    let fixture_result = FixtureJATP_01052.input * 30
    assert fixture_result == FixtureJATP_01052.expected
}
property PropertyJATP_01052 for_all x: Count where x <= 84 {
    let result = x * 30
    invariant result >= x
}
simulation FailureJATP_01052 {
    virtual_time 84s
    inject network.partition at 30s
    expect service.recovers within 33s
}
benchmark BenchJATP_01052 limit cpu 84ms memory 38MB
assert proof.complete == true
emit mcrt "PropertyJATP_01052.proof.mcrt"