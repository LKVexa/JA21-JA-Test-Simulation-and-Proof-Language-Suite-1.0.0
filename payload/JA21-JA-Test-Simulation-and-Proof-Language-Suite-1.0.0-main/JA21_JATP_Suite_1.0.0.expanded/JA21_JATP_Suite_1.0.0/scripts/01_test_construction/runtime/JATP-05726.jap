module corpus.ja_proof.example_05726
use Proof
policy no_network

fixture FixtureJATP_05726 {
    input 5
    expected 115
}
unit test FixtureCheckJATP_05726 {
    let fixture_result = FixtureJATP_05726.input * 23
    assert fixture_result == FixtureJATP_05726.expected
}
property PropertyJATP_05726 for_all x: Count where x <= 5 {
    let result = x * 23
    invariant result >= x
}
simulation FailureJATP_05726 {
    virtual_time 5s
    inject network.partition at 23s
    expect service.recovers within 26s
}
benchmark BenchJATP_05726 limit cpu 5ms memory 31MB
assert proof.complete == true
emit mcrt "PropertyJATP_05726.proof.mcrt"