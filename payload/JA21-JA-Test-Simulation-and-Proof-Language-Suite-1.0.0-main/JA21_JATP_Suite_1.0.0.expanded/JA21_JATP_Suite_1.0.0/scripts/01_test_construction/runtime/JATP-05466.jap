module corpus.ja_proof.example_05466
use Proof
policy no_network

fixture FixtureJATP_05466 {
    input 36
    expected 396
}
property PropertyJATP_05466 for_all x: Count where x <= 36 {
    let result = x * 11
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_05466 {
    virtual_time 36s
    inject network.partition at 11s
    expect service.recovers within 14s
}
benchmark BenchJATP_05466 limit cpu 36ms memory 19MB
assert proof.complete == false
emit mcrt "PropertyJATP_05466.proof.mcrt"