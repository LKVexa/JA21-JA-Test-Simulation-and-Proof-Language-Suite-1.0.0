module corpus.ja_proof.example_05516
use Proof
policy no_network

fixture FixtureJATP_05516 {
    input 86
    expected 2580
}
property PropertyJATP_05516 for_all x: Count where x <= 86 {
    let result = x * 30
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_05516 {
    virtual_time 86s
    inject network.partition at 30s
    expect service.recovers within 33s
}
benchmark BenchJATP_05516 limit cpu 86ms memory 38MB
assert proof.complete == false
emit mcrt "PropertyJATP_05516.proof.mcrt"