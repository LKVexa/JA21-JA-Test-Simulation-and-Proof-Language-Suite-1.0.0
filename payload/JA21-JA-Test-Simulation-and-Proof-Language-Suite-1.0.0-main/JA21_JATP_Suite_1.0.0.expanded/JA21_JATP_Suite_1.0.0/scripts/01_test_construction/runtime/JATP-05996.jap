module corpus.ja_proof.example_05996
use Proof
policy no_network

fixture FixtureJATP_05996 {
    input 81
    expected 1134
}
unit test FixtureCheckJATP_05996 {
    let fixture_result = FixtureJATP_05996.input * 14
    assert fixture_result == FixtureJATP_05996.expected
}
property PropertyJATP_05996 for_all x: Count where x <= 81 {
    let result = x * 14
    invariant result >= x
}
simulation FailureJATP_05996 {
    virtual_time 81s
    inject network.partition at 14s
    expect service.recovers within 17s
}
benchmark BenchJATP_05996 limit cpu 81ms memory 22MB
assert proof.complete == true
emit mcrt "PropertyJATP_05996.proof.mcrt"