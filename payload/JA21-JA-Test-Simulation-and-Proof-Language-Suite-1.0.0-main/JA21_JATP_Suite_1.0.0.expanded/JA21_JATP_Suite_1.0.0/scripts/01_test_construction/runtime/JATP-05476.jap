module corpus.ja_proof.example_05476
use Proof
policy no_network

fixture FixtureJATP_05476 {
    input 46
    expected 966
}
property PropertyJATP_05476 for_all x: Count where x <= 46 {
    let result = x * 21
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_05476 {
    virtual_time 46s
    inject network.partition at 21s
    expect service.recovers within 24s
}
benchmark BenchJATP_05476 limit cpu 46ms memory 29MB
assert proof.complete == false
emit mcrt "PropertyJATP_05476.proof.mcrt"