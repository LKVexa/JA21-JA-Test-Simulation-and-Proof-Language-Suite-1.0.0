module corpus.ja_proof.example_05156
use Proof
policy no_network

fixture FixtureJATP_05156 {
    input 17
    expected 187
}
unit test FixtureCheckJATP_05156 {
    let fixture_result = FixtureJATP_05156.input * 11
    assert fixture_result == FixtureJATP_05156.expected
}
property PropertyJATP_05156 for_all x: Count where x <= 17 {
    let result = x * 11
    invariant result >= x
}
simulation FailureJATP_05156 {
    virtual_time 17s
    inject network.partition at 11s
    expect service.recovers within 14s
}
benchmark BenchJATP_05156 limit cpu 17ms memory 19MB
assert proof.complete == true
emit mcrt "PropertyJATP_05156.proof.mcrt"