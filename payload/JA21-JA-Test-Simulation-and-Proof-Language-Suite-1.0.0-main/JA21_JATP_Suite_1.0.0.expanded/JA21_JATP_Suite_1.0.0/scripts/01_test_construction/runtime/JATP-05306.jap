module corpus.ja_proof.example_05306
use Proof
policy no_network

fixture FixtureJATP_05306 {
    input 70
    expected 420
}
unit test FixtureCheckJATP_05306 {
    let fixture_result = FixtureJATP_05306.input * 6
    assert fixture_result == FixtureJATP_05306.expected
}
property PropertyJATP_05306 for_all x: Count where x <= 70 {
    let result = x * 6
    invariant result >= x
}
simulation FailureJATP_05306 {
    virtual_time 70s
    inject network.partition at 6s
    expect service.recovers within 9s
}
benchmark BenchJATP_05306 limit cpu 70ms memory 14MB
assert proof.complete == true
emit mcrt "PropertyJATP_05306.proof.mcrt"