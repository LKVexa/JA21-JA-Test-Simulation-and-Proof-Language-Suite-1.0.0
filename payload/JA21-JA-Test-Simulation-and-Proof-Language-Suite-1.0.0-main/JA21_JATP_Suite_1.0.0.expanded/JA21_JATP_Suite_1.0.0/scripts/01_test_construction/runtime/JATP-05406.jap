module corpus.ja_proof.example_05406
use Proof
policy no_network

fixture FixtureJATP_05406 {
    input 73
    expected 949
}
property PropertyJATP_05406 for_all x: Count where x <= 73 {
    let result = x * 13
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_05406 {
    virtual_time 73s
    inject network.partition at 13s
    expect service.recovers within 16s
}
benchmark BenchJATP_05406 limit cpu 73ms memory 21MB
assert proof.complete == false
emit mcrt "PropertyJATP_05406.proof.mcrt"