module corpus.ja_proof.example_01472
use Proof
policy no_network

fixture FixtureJATP_01472 {
    input 19
    expected 304
}
property PropertyJATP_01472 for_all x: Count where x <= 19 {
    let result = x * 16
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_01472 {
    virtual_time 19s
    inject network.partition at 16s
    expect service.recovers within 19s
}
benchmark BenchJATP_01472 limit cpu 19ms memory 24MB
assert proof.complete == false
emit mcrt "PropertyJATP_01472.proof.mcrt"