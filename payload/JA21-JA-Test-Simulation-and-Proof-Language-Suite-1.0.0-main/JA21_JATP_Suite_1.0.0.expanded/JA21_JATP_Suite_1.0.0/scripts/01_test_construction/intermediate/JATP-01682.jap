module corpus.ja_proof.example_01682
use Proof
policy no_network

fixture FixtureJATP_01682 {
    input 35
    expected 315
}
unit test FixtureCheckJATP_01682 {
    let fixture_result = FixtureJATP_01682.input * 9
    assert fixture_result == FixtureJATP_01682.expected
}
property PropertyJATP_01682 for_all x: Count where x <= 35 {
    let result = x * 9
    invariant result >= x
}
simulation FailureJATP_01682 {
    virtual_time 35s
    inject network.partition at 9s
    expect service.recovers within 12s
}
benchmark BenchJATP_01682 limit cpu 35ms memory 17MB
assert proof.complete == true
emit mcrt "PropertyJATP_01682.proof.mcrt"