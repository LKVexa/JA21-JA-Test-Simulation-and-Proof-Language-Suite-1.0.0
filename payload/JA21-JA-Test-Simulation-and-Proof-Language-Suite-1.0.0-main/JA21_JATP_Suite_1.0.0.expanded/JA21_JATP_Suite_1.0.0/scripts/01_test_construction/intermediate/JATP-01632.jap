module corpus.ja_proof.example_01632
use Proof
policy no_network

fixture FixtureJATP_01632 {
    input 82
    expected 1722
}
unit test FixtureCheckJATP_01632 {
    let fixture_result = FixtureJATP_01632.input * 21
    assert fixture_result == FixtureJATP_01632.expected
}
property PropertyJATP_01632 for_all x: Count where x <= 82 {
    let result = x * 21
    invariant result >= x
}
simulation FailureJATP_01632 {
    virtual_time 82s
    inject network.partition at 21s
    expect service.recovers within 24s
}
benchmark BenchJATP_01632 limit cpu 82ms memory 29MB
assert proof.complete == true
emit mcrt "PropertyJATP_01632.proof.mcrt"