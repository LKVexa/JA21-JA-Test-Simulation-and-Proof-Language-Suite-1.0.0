module corpus.ja_proof.example_01912
use Proof
policy no_network

fixture FixtureJATP_01912 {
    input 71
    expected 1562
}
unit test FixtureCheckJATP_01912 {
    let fixture_result = FixtureJATP_01912.input * 22
    assert fixture_result == FixtureJATP_01912.expected
}
property PropertyJATP_01912 for_all x: Count where x <= 71 {
    let result = x * 22
    invariant result >= x
}
simulation FailureJATP_01912 {
    virtual_time 71s
    inject network.partition at 22s
    expect service.recovers within 25s
}
benchmark BenchJATP_01912 limit cpu 71ms memory 30MB
assert proof.complete == true
emit mcrt "PropertyJATP_01912.proof.mcrt"