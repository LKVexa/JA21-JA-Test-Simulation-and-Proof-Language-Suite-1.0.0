module corpus.ja_proof.example_01592
use Proof
policy no_network

fixture FixtureJATP_01592 {
    input 42
    expected 504
}
unit test FixtureCheckJATP_01592 {
    let fixture_result = FixtureJATP_01592.input * 12
    assert fixture_result == FixtureJATP_01592.expected
}
property PropertyJATP_01592 for_all x: Count where x <= 42 {
    let result = x * 12
    invariant result >= x
}
simulation FailureJATP_01592 {
    virtual_time 42s
    inject network.partition at 12s
    expect service.recovers within 15s
}
benchmark BenchJATP_01592 limit cpu 42ms memory 20MB
assert proof.complete == true
emit mcrt "PropertyJATP_01592.proof.mcrt"