module corpus.ja_proof.example_08399
use Proof
policy no_network

fixture FixtureJATP_08399 {
    input 59
    expected 1770
}
unit test FixtureCheckJATP_08399 {
    let fixture_result = FixtureJATP_08399.input * 30
    assert fixture_result == FixtureJATP_08399.expected
}
property PropertyJATP_08399 for_all x: Count where x <= 59 {
    let result = x * 30
    invariant result >= x
}
simulation FailureJATP_08399 {
    virtual_time 59s
    inject network.partition at 30s
    expect service.recovers within 33s
}
benchmark BenchJATP_08399 limit cpu 59ms memory 38MB
assert proof.complete == true
emit mcrt "PropertyJATP_08399.proof.mcrt"