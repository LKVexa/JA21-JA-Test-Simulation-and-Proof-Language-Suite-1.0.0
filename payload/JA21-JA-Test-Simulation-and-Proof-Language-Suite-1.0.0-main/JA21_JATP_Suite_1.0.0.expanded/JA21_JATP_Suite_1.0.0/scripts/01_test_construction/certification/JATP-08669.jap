module corpus.ja_proof.example_08669
use Proof
policy no_network

fixture FixtureJATP_08669 {
    input 38
    expected 798
}
unit test FixtureCheckJATP_08669 {
    let fixture_result = FixtureJATP_08669.input * 21
    assert fixture_result == FixtureJATP_08669.expected
}
property PropertyJATP_08669 for_all x: Count where x <= 38 {
    let result = x * 21
    invariant result >= x
}
simulation FailureJATP_08669 {
    virtual_time 38s
    inject network.partition at 21s
    expect service.recovers within 24s
}
benchmark BenchJATP_08669 limit cpu 38ms memory 29MB
assert proof.complete == true
emit mcrt "PropertyJATP_08669.proof.mcrt"