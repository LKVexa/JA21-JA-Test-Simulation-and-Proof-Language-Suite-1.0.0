module corpus.ja_proof.example_08189
use Proof
policy no_network

fixture FixtureJATP_08189 {
    input 43
    expected 258
}
unit test FixtureCheckJATP_08189 {
    let fixture_result = FixtureJATP_08189.input * 6
    assert fixture_result == FixtureJATP_08189.expected
}
property PropertyJATP_08189 for_all x: Count where x <= 43 {
    let result = x * 6
    invariant result >= x
}
simulation FailureJATP_08189 {
    virtual_time 43s
    inject network.partition at 6s
    expect service.recovers within 9s
}
benchmark BenchJATP_08189 limit cpu 43ms memory 14MB
assert proof.complete == true
emit mcrt "PropertyJATP_08189.proof.mcrt"