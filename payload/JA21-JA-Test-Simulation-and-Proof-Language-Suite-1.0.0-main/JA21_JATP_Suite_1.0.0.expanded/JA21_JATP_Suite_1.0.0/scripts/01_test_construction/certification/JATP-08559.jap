module corpus.ja_proof.example_08559
use Proof
policy no_network

fixture FixtureJATP_08559 {
    input 25
    expected 100
}
unit test FixtureCheckJATP_08559 {
    let fixture_result = FixtureJATP_08559.input * 4
    assert fixture_result == FixtureJATP_08559.expected
}
property PropertyJATP_08559 for_all x: Count where x <= 25 {
    let result = x * 4
    invariant result >= x
}
simulation FailureJATP_08559 {
    virtual_time 25s
    inject network.partition at 4s
    expect service.recovers within 7s
}
benchmark BenchJATP_08559 limit cpu 25ms memory 12MB
assert proof.complete == true
emit mcrt "PropertyJATP_08559.proof.mcrt"