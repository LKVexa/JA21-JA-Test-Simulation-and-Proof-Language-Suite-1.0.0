module corpus.ja_proof.example_08779
use Proof
policy no_network

fixture FixtureJATP_08779 {
    input 51
    expected 357
}
property PropertyJATP_08779 for_all x: Count where x <= 51 {
    let result = x * 7
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_08779 {
    virtual_time 51s
    inject network.partition at 7s
    expect service.recovers within 10s
}
benchmark BenchJATP_08779 limit cpu 51ms memory 15MB
assert proof.complete == false
emit mcrt "PropertyJATP_08779.proof.mcrt"