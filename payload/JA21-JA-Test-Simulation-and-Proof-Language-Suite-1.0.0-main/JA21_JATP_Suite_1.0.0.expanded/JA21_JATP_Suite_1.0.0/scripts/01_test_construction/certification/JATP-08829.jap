module corpus.ja_proof.example_08829
use Proof
policy no_network

fixture FixtureJATP_08829 {
    input 4
    expected 104
}
unit test FixtureCheckJATP_08829 {
    let fixture_result = FixtureJATP_08829.input * 26
    assert fixture_result == FixtureJATP_08829.expected
}
property PropertyJATP_08829 for_all x: Count where x <= 4 {
    let result = x * 26
    invariant result >= x
}
simulation FailureJATP_08829 {
    virtual_time 4s
    inject network.partition at 26s
    expect service.recovers within 29s
}
benchmark BenchJATP_08829 limit cpu 4ms memory 34MB
assert proof.complete == true
emit mcrt "PropertyJATP_08829.proof.mcrt"