module corpus.ja_proof.example_08939
use Proof
policy no_network

fixture FixtureJATP_08939 {
    input 17
    expected 204
}
unit test FixtureCheckJATP_08939 {
    let fixture_result = FixtureJATP_08939.input * 12
    assert fixture_result == FixtureJATP_08939.expected
}
property PropertyJATP_08939 for_all x: Count where x <= 17 {
    let result = x * 12
    invariant result >= x
}
simulation FailureJATP_08939 {
    virtual_time 17s
    inject network.partition at 12s
    expect service.recovers within 15s
}
benchmark BenchJATP_08939 limit cpu 17ms memory 20MB
assert proof.complete == true
emit mcrt "PropertyJATP_08939.proof.mcrt"