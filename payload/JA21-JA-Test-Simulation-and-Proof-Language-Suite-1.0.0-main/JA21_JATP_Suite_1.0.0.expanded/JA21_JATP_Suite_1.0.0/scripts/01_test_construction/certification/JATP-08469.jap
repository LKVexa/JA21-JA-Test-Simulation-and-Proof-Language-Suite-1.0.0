module corpus.ja_proof.example_08469
use Proof
policy no_network

fixture FixtureJATP_08469 {
    input 32
    expected 224
}
property PropertyJATP_08469 for_all x: Count where x <= 32 {
    let result = x * 7
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_08469 {
    virtual_time 32s
    inject network.partition at 7s
    expect service.recovers within 10s
}
benchmark BenchJATP_08469 limit cpu 32ms memory 15MB
assert proof.complete == false
emit mcrt "PropertyJATP_08469.proof.mcrt"