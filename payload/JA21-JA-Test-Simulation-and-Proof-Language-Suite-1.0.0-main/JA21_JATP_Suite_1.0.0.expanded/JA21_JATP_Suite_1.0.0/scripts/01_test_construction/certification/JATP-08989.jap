module corpus.ja_proof.example_08989
use Proof
policy no_network

fixture FixtureJATP_08989 {
    input 67
    expected 2077
}
unit test FixtureCheckJATP_08989 {
    let fixture_result = FixtureJATP_08989.input * 31
    assert fixture_result == FixtureJATP_08989.expected
}
property PropertyJATP_08989 for_all x: Count where x <= 67 {
    let result = x * 31
    invariant result >= x
}
simulation FailureJATP_08989 {
    virtual_time 67s
    inject network.partition at 31s
    expect service.recovers within 34s
}
benchmark BenchJATP_08989 limit cpu 67ms memory 39MB
assert proof.complete == true
emit mcrt "PropertyJATP_08989.proof.mcrt"