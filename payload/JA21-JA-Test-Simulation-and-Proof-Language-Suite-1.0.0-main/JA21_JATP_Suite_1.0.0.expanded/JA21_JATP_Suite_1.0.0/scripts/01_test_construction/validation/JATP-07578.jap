module corpus.ja_proof.example_07578
use Proof
policy no_network

fixture FixtureJATP_07578 {
    input 14
    expected 210
}
unit test FixtureCheckJATP_07578 {
    let fixture_result = FixtureJATP_07578.input * 15
    assert fixture_result == FixtureJATP_07578.expected
}
property PropertyJATP_07578 for_all x: Count where x <= 14 {
    let result = x * 15
    invariant result >= x
}
simulation FailureJATP_07578 {
    virtual_time 14s
    inject network.partition at 15s
    expect service.recovers within 18s
}
benchmark BenchJATP_07578 limit cpu 14ms memory 23MB
assert proof.complete == true
emit mcrt "PropertyJATP_07578.proof.mcrt"