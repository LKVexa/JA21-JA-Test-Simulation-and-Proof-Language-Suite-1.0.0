module corpus.ja_proof.example_07778
use Proof
policy no_network

fixture FixtureJATP_07778 {
    input 20
    expected 580
}
property PropertyJATP_07778 for_all x: Count where x <= 20 {
    let result = x * 29
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_07778 {
    virtual_time 20s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_07778 limit cpu 20ms memory 37MB
assert proof.complete == false
emit mcrt "PropertyJATP_07778.proof.mcrt"