module corpus.ja_proof.example_07568
use Proof
policy no_network

fixture FixtureJATP_07568 {
    input 4
    expected 20
}
unit test FixtureCheckJATP_07568 {
    let fixture_result = FixtureJATP_07568.input * 5
    assert fixture_result == FixtureJATP_07568.expected
}
property PropertyJATP_07568 for_all x: Count where x <= 4 {
    let result = x * 5
    invariant result >= x
}
simulation FailureJATP_07568 {
    virtual_time 4s
    inject network.partition at 5s
    expect service.recovers within 8s
}
benchmark BenchJATP_07568 limit cpu 4ms memory 13MB
assert proof.complete == true
emit mcrt "PropertyJATP_07568.proof.mcrt"