module corpus.ja_proof.example_07258
use Proof
policy no_network

fixture FixtureJATP_07258 {
    input 82
    expected 410
}
unit test FixtureCheckJATP_07258 {
    let fixture_result = FixtureJATP_07258.input * 5
    assert fixture_result == FixtureJATP_07258.expected
}
property PropertyJATP_07258 for_all x: Count where x <= 82 {
    let result = x * 5
    invariant result >= x
}
simulation FailureJATP_07258 {
    virtual_time 82s
    inject network.partition at 5s
    expect service.recovers within 8s
}
benchmark BenchJATP_07258 limit cpu 82ms memory 13MB
assert proof.complete == true
emit mcrt "PropertyJATP_07258.proof.mcrt"