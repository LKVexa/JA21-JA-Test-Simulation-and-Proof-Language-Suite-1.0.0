module corpus.ja_proof.example_07828
use Proof
policy no_network

fixture FixtureJATP_07828 {
    input 70
    expected 1190
}
unit test FixtureCheckJATP_07828 {
    let fixture_result = FixtureJATP_07828.input * 17
    assert fixture_result == FixtureJATP_07828.expected
}
property PropertyJATP_07828 for_all x: Count where x <= 70 {
    let result = x * 17
    invariant result >= x
}
simulation FailureJATP_07828 {
    virtual_time 70s
    inject network.partition at 17s
    expect service.recovers within 20s
}
benchmark BenchJATP_07828 limit cpu 70ms memory 25MB
assert proof.complete == true
emit mcrt "PropertyJATP_07828.proof.mcrt"