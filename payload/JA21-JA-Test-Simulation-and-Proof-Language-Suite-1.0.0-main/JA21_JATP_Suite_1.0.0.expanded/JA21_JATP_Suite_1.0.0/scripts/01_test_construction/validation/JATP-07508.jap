module corpus.ja_proof.example_07508
use Proof
policy no_network

fixture FixtureJATP_07508 {
    input 41
    expected 287
}
property PropertyJATP_07508 for_all x: Count where x <= 41 {
    let result = x * 7
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_07508 {
    virtual_time 41s
    inject network.partition at 7s
    expect service.recovers within 10s
}
benchmark BenchJATP_07508 limit cpu 41ms memory 15MB
assert proof.complete == false
emit mcrt "PropertyJATP_07508.proof.mcrt"