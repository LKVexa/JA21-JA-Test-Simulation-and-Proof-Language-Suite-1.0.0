module corpus.ja_proof.example_07988
use Proof
policy no_network

fixture FixtureJATP_07988 {
    input 36
    expected 792
}
unit test FixtureCheckJATP_07988 {
    let fixture_result = FixtureJATP_07988.input * 22
    assert fixture_result == FixtureJATP_07988.expected
}
property PropertyJATP_07988 for_all x: Count where x <= 36 {
    let result = x * 22
    invariant result >= x
}
simulation FailureJATP_07988 {
    virtual_time 36s
    inject network.partition at 22s
    expect service.recovers within 25s
}
benchmark BenchJATP_07988 limit cpu 36ms memory 30MB
assert proof.complete == true
emit mcrt "PropertyJATP_07988.proof.mcrt"