module corpus.ja_proof.example_07938
use Proof
policy no_network

fixture FixtureJATP_07938 {
    input 83
    expected 249
}
unit test FixtureCheckJATP_07938 {
    let fixture_result = FixtureJATP_07938.input * 3
    assert fixture_result == FixtureJATP_07938.expected
}
property PropertyJATP_07938 for_all x: Count where x <= 83 {
    let result = x * 3
    invariant result >= x
}
simulation FailureJATP_07938 {
    virtual_time 83s
    inject network.partition at 3s
    expect service.recovers within 6s
}
benchmark BenchJATP_07938 limit cpu 83ms memory 11MB
assert proof.complete == true
emit mcrt "PropertyJATP_07938.proof.mcrt"