module corpus.ja_proof.example_06567
use Proof
policy no_network

fixture FixtureJATP_06567 {
    input 70
    expected 1890
}
unit test FixtureCheckJATP_06567 {
    let fixture_result = FixtureJATP_06567.input * 27
    assert fixture_result == FixtureJATP_06567.expected
}
property PropertyJATP_06567 for_all x: Count where x <= 70 {
    let result = x * 27
    invariant result >= x
}
simulation FailureJATP_06567 {
    virtual_time 70s
    inject network.partition at 27s
    expect service.recovers within 30s
}
benchmark BenchJATP_06567 limit cpu 70ms memory 35MB
assert proof.complete == true
emit mcrt "PropertyJATP_06567.proof.mcrt"