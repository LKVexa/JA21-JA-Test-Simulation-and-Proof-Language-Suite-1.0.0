module corpus.ja_proof.example_06357
use Proof
policy no_network

fixture FixtureJATP_06357 {
    input 54
    expected 162
}
unit test FixtureCheckJATP_06357 {
    let fixture_result = FixtureJATP_06357.input * 3
    assert fixture_result == FixtureJATP_06357.expected
}
property PropertyJATP_06357 for_all x: Count where x <= 54 {
    let result = x * 3
    invariant result >= x
}
simulation FailureJATP_06357 {
    virtual_time 54s
    inject network.partition at 3s
    expect service.recovers within 6s
}
benchmark BenchJATP_06357 limit cpu 54ms memory 11MB
assert proof.complete == true
emit mcrt "PropertyJATP_06357.proof.mcrt"