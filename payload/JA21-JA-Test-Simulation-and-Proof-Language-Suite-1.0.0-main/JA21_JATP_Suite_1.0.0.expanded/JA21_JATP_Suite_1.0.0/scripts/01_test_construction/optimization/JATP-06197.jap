module corpus.ja_proof.example_06197
use Proof
policy no_network

fixture FixtureJATP_06197 {
    input 88
    expected 2552
}
unit test FixtureCheckJATP_06197 {
    let fixture_result = FixtureJATP_06197.input * 29
    assert fixture_result == FixtureJATP_06197.expected
}
property PropertyJATP_06197 for_all x: Count where x <= 88 {
    let result = x * 29
    invariant result >= x
}
simulation FailureJATP_06197 {
    virtual_time 88s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_06197 limit cpu 88ms memory 37MB
assert proof.complete == true
emit mcrt "PropertyJATP_06197.proof.mcrt"