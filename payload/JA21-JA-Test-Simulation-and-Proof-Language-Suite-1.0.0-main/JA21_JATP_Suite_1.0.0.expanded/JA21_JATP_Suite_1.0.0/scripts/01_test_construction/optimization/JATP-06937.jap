module corpus.ja_proof.example_06937
use Proof
policy no_network

fixture FixtureJATP_06937 {
    input 52
    expected 1300
}
unit test FixtureCheckJATP_06937 {
    let fixture_result = FixtureJATP_06937.input * 25
    assert fixture_result == FixtureJATP_06937.expected
}
property PropertyJATP_06937 for_all x: Count where x <= 52 {
    let result = x * 25
    invariant result >= x
}
simulation FailureJATP_06937 {
    virtual_time 52s
    inject network.partition at 25s
    expect service.recovers within 28s
}
benchmark BenchJATP_06937 limit cpu 52ms memory 33MB
assert proof.complete == true
emit mcrt "PropertyJATP_06937.proof.mcrt"