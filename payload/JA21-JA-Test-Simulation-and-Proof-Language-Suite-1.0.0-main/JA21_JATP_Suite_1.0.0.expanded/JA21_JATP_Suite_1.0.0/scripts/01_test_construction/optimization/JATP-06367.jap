module corpus.ja_proof.example_06367
use Proof
policy no_network

fixture FixtureJATP_06367 {
    input 64
    expected 832
}
unit test FixtureCheckJATP_06367 {
    let fixture_result = FixtureJATP_06367.input * 13
    assert fixture_result == FixtureJATP_06367.expected
}
property PropertyJATP_06367 for_all x: Count where x <= 64 {
    let result = x * 13
    invariant result >= x
}
simulation FailureJATP_06367 {
    virtual_time 64s
    inject network.partition at 13s
    expect service.recovers within 16s
}
benchmark BenchJATP_06367 limit cpu 64ms memory 21MB
assert proof.complete == true
emit mcrt "PropertyJATP_06367.proof.mcrt"