module corpus.ja_proof.example_09990
use Proof
policy no_network

fixture FixtureJATP_09990 {
    input 98
    expected 882
}
unit test FixtureCheckJATP_09990 {
    let fixture_result = FixtureJATP_09990.input * 9
    assert fixture_result == FixtureJATP_09990.expected
}
property PropertyJATP_09990 for_all x: Count where x <= 98 {
    let result = x * 9
    invariant result >= x
}
simulation FailureJATP_09990 {
    virtual_time 98s
    inject network.partition at 9s
    expect service.recovers within 12s
}
benchmark BenchJATP_09990 limit cpu 98ms memory 17MB
assert proof.complete == true
emit mcrt "PropertyJATP_09990.proof.mcrt"