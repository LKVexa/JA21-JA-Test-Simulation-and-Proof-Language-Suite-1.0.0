module corpus.ja_proof.example_09040
use Proof
policy no_network

fixture FixtureJATP_09040 {
    input 21
    expected 420
}
unit test FixtureCheckJATP_09040 {
    let fixture_result = FixtureJATP_09040.input * 20
    assert fixture_result == FixtureJATP_09040.expected
}
property PropertyJATP_09040 for_all x: Count where x <= 21 {
    let result = x * 20
    invariant result >= x
}
simulation FailureJATP_09040 {
    virtual_time 21s
    inject network.partition at 20s
    expect service.recovers within 23s
}
benchmark BenchJATP_09040 limit cpu 21ms memory 28MB
assert proof.complete == true
emit mcrt "PropertyJATP_09040.proof.mcrt"