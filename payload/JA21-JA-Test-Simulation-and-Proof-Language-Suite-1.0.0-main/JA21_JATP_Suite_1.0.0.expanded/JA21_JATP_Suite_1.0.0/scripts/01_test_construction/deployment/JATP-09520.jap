module corpus.ja_proof.example_09520
use Proof
policy no_network

fixture FixtureJATP_09520 {
    input 16
    expected 64
}
property PropertyJATP_09520 for_all x: Count where x <= 16 {
    let result = x * 4
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_09520 {
    virtual_time 16s
    inject network.partition at 4s
    expect service.recovers within 7s
}
benchmark BenchJATP_09520 limit cpu 16ms memory 12MB
assert proof.complete == false
emit mcrt "PropertyJATP_09520.proof.mcrt"