module corpus.ja_proof.example_09610
use Proof
policy no_network

fixture FixtureJATP_09610 {
    input 9
    expected 9
}
unit test FixtureCheckJATP_09610 {
    let fixture_result = FixtureJATP_09610.input * 1
    assert fixture_result == FixtureJATP_09610.expected
}
property PropertyJATP_09610 for_all x: Count where x <= 9 {
    let result = x * 1
    invariant result >= x
}
simulation FailureJATP_09610 {
    virtual_time 9s
    inject network.partition at 1s
    expect service.recovers within 4s
}
benchmark BenchJATP_09610 limit cpu 9ms memory 9MB
assert proof.complete == true
emit mcrt "PropertyJATP_09610.proof.mcrt"