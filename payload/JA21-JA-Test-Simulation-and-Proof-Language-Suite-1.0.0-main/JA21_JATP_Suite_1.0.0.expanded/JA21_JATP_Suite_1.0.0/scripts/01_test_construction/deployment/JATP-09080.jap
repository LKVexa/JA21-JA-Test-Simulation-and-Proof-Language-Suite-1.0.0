module corpus.ja_proof.example_09080
use Proof
policy no_network

fixture FixtureJATP_09080 {
    input 61
    expected 1769
}
unit test FixtureCheckJATP_09080 {
    let fixture_result = FixtureJATP_09080.input * 29
    assert fixture_result == FixtureJATP_09080.expected
}
property PropertyJATP_09080 for_all x: Count where x <= 61 {
    let result = x * 29
    invariant result >= x
}
simulation FailureJATP_09080 {
    virtual_time 61s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_09080 limit cpu 61ms memory 37MB
assert proof.complete == true
emit mcrt "PropertyJATP_09080.proof.mcrt"