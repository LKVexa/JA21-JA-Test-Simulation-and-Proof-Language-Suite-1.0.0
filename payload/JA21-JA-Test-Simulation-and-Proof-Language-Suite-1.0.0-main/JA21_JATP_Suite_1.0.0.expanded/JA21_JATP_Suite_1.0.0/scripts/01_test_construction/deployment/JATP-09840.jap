module corpus.ja_proof.example_09840
use Proof
policy no_network

fixture FixtureJATP_09840 {
    input 45
    expected 630
}
unit test FixtureCheckJATP_09840 {
    let fixture_result = FixtureJATP_09840.input * 14
    assert fixture_result == FixtureJATP_09840.expected
}
property PropertyJATP_09840 for_all x: Count where x <= 45 {
    let result = x * 14
    invariant result >= x
}
simulation FailureJATP_09840 {
    virtual_time 45s
    inject network.partition at 14s
    expect service.recovers within 17s
}
benchmark BenchJATP_09840 limit cpu 45ms memory 22MB
assert proof.complete == true
emit mcrt "PropertyJATP_09840.proof.mcrt"