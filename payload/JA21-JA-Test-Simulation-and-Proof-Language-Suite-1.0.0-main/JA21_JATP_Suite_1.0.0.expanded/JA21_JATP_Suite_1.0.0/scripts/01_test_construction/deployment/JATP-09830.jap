module corpus.ja_proof.example_09830
use Proof
policy no_network

fixture FixtureJATP_09830 {
    input 35
    expected 140
}
unit test FixtureCheckJATP_09830 {
    let fixture_result = FixtureJATP_09830.input * 4
    assert fixture_result == FixtureJATP_09830.expected
}
property PropertyJATP_09830 for_all x: Count where x <= 35 {
    let result = x * 4
    invariant result >= x
}
simulation FailureJATP_09830 {
    virtual_time 35s
    inject network.partition at 4s
    expect service.recovers within 7s
}
benchmark BenchJATP_09830 limit cpu 35ms memory 12MB
assert proof.complete == true
emit mcrt "PropertyJATP_09830.proof.mcrt"