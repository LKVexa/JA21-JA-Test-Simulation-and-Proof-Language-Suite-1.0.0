module corpus.ja_proof.example_00741
use Proof
policy no_network

fixture FixtureJATP_00741 {
    input 64
    expected 1856
}
unit test FixtureCheckJATP_00741 {
    let fixture_result = FixtureJATP_00741.input * 29
    assert fixture_result == FixtureJATP_00741.expected
}
property PropertyJATP_00741 for_all x: Count where x <= 64 {
    let result = x * 29
    invariant result >= x
}
simulation FailureJATP_00741 {
    virtual_time 64s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_00741 limit cpu 64ms memory 37MB
assert proof.complete == true
emit mcrt "PropertyJATP_00741.proof.mcrt"