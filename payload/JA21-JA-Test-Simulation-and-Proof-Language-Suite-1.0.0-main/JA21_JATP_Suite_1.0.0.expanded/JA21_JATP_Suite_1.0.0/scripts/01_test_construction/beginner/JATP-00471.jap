module corpus.ja_proof.example_00471
use Proof
policy no_network

fixture FixtureJATP_00471 {
    input 85
    expected 595
}
property PropertyJATP_00471 for_all x: Count where x <= 85 {
    let result = x * 7
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_00471 {
    virtual_time 85s
    inject network.partition at 7s
    expect service.recovers within 10s
}
benchmark BenchJATP_00471 limit cpu 85ms memory 15MB
assert proof.complete == false
emit mcrt "PropertyJATP_00471.proof.mcrt"