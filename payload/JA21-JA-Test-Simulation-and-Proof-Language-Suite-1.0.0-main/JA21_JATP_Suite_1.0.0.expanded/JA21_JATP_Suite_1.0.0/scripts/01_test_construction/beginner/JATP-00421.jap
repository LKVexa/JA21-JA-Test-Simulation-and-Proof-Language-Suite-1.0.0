module corpus.ja_proof.example_00421
use Proof
policy no_network

fixture FixtureJATP_00421 {
    input 35
    expected 665
}
property PropertyJATP_00421 for_all x: Count where x <= 35 {
    let result = x * 19
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_00421 {
    virtual_time 35s
    inject network.partition at 19s
    expect service.recovers within 22s
}
benchmark BenchJATP_00421 limit cpu 35ms memory 27MB
assert proof.complete == false
emit mcrt "PropertyJATP_00421.proof.mcrt"