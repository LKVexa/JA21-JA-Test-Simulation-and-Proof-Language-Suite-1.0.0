module corpus.ja_proof.example_00701
use Proof
policy no_network

fixture FixtureJATP_00701 {
    input 24
    expected 480
}
unit test FixtureCheckJATP_00701 {
    let fixture_result = FixtureJATP_00701.input * 20
    assert fixture_result == FixtureJATP_00701.expected
}
property PropertyJATP_00701 for_all x: Count where x <= 24 {
    let result = x * 20
    invariant result >= x
}
simulation FailureJATP_00701 {
    virtual_time 24s
    inject network.partition at 20s
    expect service.recovers within 23s
}
benchmark BenchJATP_00701 limit cpu 24ms memory 28MB
assert proof.complete == true
emit mcrt "PropertyJATP_00701.proof.mcrt"