module corpus.ja_proof.example_00581
use Proof
policy no_network

fixture FixtureJATP_00581 {
    input 98
    expected 2352
}
unit test FixtureCheckJATP_00581 {
    let fixture_result = FixtureJATP_00581.input * 24
    assert fixture_result == FixtureJATP_00581.expected
}
property PropertyJATP_00581 for_all x: Count where x <= 98 {
    let result = x * 24
    invariant result >= x
}
simulation FailureJATP_00581 {
    virtual_time 98s
    inject network.partition at 24s
    expect service.recovers within 27s
}
benchmark BenchJATP_00581 limit cpu 98ms memory 32MB
assert proof.complete == true
emit mcrt "PropertyJATP_00581.proof.mcrt"