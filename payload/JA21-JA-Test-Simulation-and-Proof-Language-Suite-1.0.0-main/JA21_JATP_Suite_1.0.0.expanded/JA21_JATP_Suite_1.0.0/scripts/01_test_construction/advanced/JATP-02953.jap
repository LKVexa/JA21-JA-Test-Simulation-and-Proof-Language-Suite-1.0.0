module corpus.ja_proof.example_02953
use Proof
policy no_network

fixture FixtureJATP_02953 {
    input 45
    expected 405
}
property PropertyJATP_02953 for_all x: Count where x <= 45 {
    let result = x * 9
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_02953 {
    virtual_time 45s
    inject network.partition at 9s
    expect service.recovers within 12s
}
benchmark BenchJATP_02953 limit cpu 45ms memory 17MB
assert proof.complete == false
emit mcrt "PropertyJATP_02953.proof.mcrt"