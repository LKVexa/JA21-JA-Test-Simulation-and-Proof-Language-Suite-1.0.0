module corpus.ja_proof.example_02043
use Proof
policy no_network

fixture FixtureJATP_02043 {
    input 8
    expected 232
}
unit test FixtureCheckJATP_02043 {
    let fixture_result = FixtureJATP_02043.input * 29
    assert fixture_result == FixtureJATP_02043.expected
}
property PropertyJATP_02043 for_all x: Count where x <= 8 {
    let result = x * 29
    invariant result >= x
}
simulation FailureJATP_02043 {
    virtual_time 8s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_02043 limit cpu 8ms memory 37MB
assert proof.complete == true
emit mcrt "PropertyJATP_02043.proof.mcrt"