module corpus.ja_proof.example_02573
use Proof
policy no_network

fixture FixtureJATP_02573 {
    input 53
    expected 53
}
unit test FixtureCheckJATP_02573 {
    let fixture_result = FixtureJATP_02573.input * 1
    assert fixture_result == FixtureJATP_02573.expected
}
property PropertyJATP_02573 for_all x: Count where x <= 53 {
    let result = x * 1
    invariant result >= x
}
simulation FailureJATP_02573 {
    virtual_time 53s
    inject network.partition at 1s
    expect service.recovers within 4s
}
benchmark BenchJATP_02573 limit cpu 53ms memory 9MB
assert proof.complete == true
emit mcrt "PropertyJATP_02573.proof.mcrt"