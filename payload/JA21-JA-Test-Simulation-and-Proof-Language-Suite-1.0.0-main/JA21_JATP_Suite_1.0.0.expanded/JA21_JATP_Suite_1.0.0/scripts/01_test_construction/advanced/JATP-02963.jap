module corpus.ja_proof.example_02963
use Proof
policy no_network

fixture FixtureJATP_02963 {
    input 55
    expected 1045
}
property PropertyJATP_02963 for_all x: Count where x <= 55 {
    let result = x * 19
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_02963 {
    virtual_time 55s
    inject network.partition at 19s
    expect service.recovers within 22s
}
benchmark BenchJATP_02963 limit cpu 55ms memory 27MB
assert proof.complete == false
emit mcrt "PropertyJATP_02963.proof.mcrt"