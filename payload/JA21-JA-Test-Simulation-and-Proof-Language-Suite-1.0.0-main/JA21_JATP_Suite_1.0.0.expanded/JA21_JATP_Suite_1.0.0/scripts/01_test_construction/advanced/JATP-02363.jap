module corpus.ja_proof.example_02363
use Proof
policy no_network

fixture FixtureJATP_02363 {
    input 37
    expected 296
}
unit test FixtureCheckJATP_02363 {
    let fixture_result = FixtureJATP_02363.input * 8
    assert fixture_result == FixtureJATP_02363.expected
}
property PropertyJATP_02363 for_all x: Count where x <= 37 {
    let result = x * 8
    invariant result >= x
}
simulation FailureJATP_02363 {
    virtual_time 37s
    inject network.partition at 8s
    expect service.recovers within 11s
}
benchmark BenchJATP_02363 limit cpu 37ms memory 16MB
assert proof.complete == true
emit mcrt "PropertyJATP_02363.proof.mcrt"