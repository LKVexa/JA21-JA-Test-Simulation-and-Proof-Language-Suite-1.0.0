module corpus.ja_proof.example_02483
use Proof
policy no_network

fixture FixtureJATP_02483 {
    input 60
    expected 240
}
property PropertyJATP_02483 for_all x: Count where x <= 60 {
    let result = x * 4
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_02483 {
    virtual_time 60s
    inject network.partition at 4s
    expect service.recovers within 7s
}
benchmark BenchJATP_02483 limit cpu 60ms memory 12MB
assert proof.complete == false
emit mcrt "PropertyJATP_02483.proof.mcrt"