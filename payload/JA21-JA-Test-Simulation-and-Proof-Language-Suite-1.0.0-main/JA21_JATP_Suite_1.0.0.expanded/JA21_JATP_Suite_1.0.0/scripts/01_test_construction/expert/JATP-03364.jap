module corpus.ja_proof.example_03364
use Proof
policy no_network

fixture FixtureJATP_03364 {
    input 68
    expected 1156
}
unit test FixtureCheckJATP_03364 {
    let fixture_result = FixtureJATP_03364.input * 17
    assert fixture_result == FixtureJATP_03364.expected
}
property PropertyJATP_03364 for_all x: Count where x <= 68 {
    let result = x * 17
    invariant result >= x
}
simulation FailureJATP_03364 {
    virtual_time 68s
    inject network.partition at 17s
    expect service.recovers within 20s
}
benchmark BenchJATP_03364 limit cpu 68ms memory 25MB
assert proof.complete == true
emit mcrt "PropertyJATP_03364.proof.mcrt"