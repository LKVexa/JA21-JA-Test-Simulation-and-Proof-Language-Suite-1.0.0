module corpus.ja_proof.example_03694
use Proof
policy no_network

fixture FixtureJATP_03694 {
    input 10
    expected 60
}
unit test FixtureCheckJATP_03694 {
    let fixture_result = FixtureJATP_03694.input * 6
    assert fixture_result == FixtureJATP_03694.expected
}
property PropertyJATP_03694 for_all x: Count where x <= 10 {
    let result = x * 6
    invariant result >= x
}
simulation FailureJATP_03694 {
    virtual_time 10s
    inject network.partition at 6s
    expect service.recovers within 9s
}
benchmark BenchJATP_03694 limit cpu 10ms memory 14MB
assert proof.complete == true
emit mcrt "PropertyJATP_03694.proof.mcrt"