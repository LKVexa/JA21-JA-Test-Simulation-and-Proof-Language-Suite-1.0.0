module corpus.ja_proof.example_03144
use Proof
policy no_network

fixture FixtureJATP_03144 {
    input 42
    expected 588
}
unit test FixtureCheckJATP_03144 {
    let fixture_result = FixtureJATP_03144.input * 14
    assert fixture_result == FixtureJATP_03144.expected
}
property PropertyJATP_03144 for_all x: Count where x <= 42 {
    let result = x * 14
    invariant result >= x
}
simulation FailureJATP_03144 {
    virtual_time 42s
    inject network.partition at 14s
    expect service.recovers within 17s
}
benchmark BenchJATP_03144 limit cpu 42ms memory 22MB
assert proof.complete == true
emit mcrt "PropertyJATP_03144.proof.mcrt"