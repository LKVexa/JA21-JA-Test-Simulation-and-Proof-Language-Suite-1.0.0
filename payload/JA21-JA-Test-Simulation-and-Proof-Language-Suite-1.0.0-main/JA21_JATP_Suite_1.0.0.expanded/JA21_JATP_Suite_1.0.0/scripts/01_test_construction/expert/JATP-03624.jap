module corpus.ja_proof.example_03624
use Proof
policy no_network

fixture FixtureJATP_03624 {
    input 37
    expected 1073
}
unit test FixtureCheckJATP_03624 {
    let fixture_result = FixtureJATP_03624.input * 29
    assert fixture_result == FixtureJATP_03624.expected
}
property PropertyJATP_03624 for_all x: Count where x <= 37 {
    let result = x * 29
    invariant result >= x
}
simulation FailureJATP_03624 {
    virtual_time 37s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_03624 limit cpu 37ms memory 37MB
assert proof.complete == true
emit mcrt "PropertyJATP_03624.proof.mcrt"