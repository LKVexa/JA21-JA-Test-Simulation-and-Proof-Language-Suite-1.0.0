module corpus.ja_proof.example_03944
use Proof
policy no_network

fixture FixtureJATP_03944 {
    input 66
    expected 528
}
unit test FixtureCheckJATP_03944 {
    let fixture_result = FixtureJATP_03944.input * 8
    assert fixture_result == FixtureJATP_03944.expected
}
property PropertyJATP_03944 for_all x: Count where x <= 66 {
    let result = x * 8
    invariant result >= x
}
simulation FailureJATP_03944 {
    virtual_time 66s
    inject network.partition at 8s
    expect service.recovers within 11s
}
benchmark BenchJATP_03944 limit cpu 66ms memory 16MB
assert proof.complete == true
emit mcrt "PropertyJATP_03944.proof.mcrt"