module corpus.ja_proof.example_03854
use Proof
policy no_network

fixture FixtureJATP_03854 {
    input 73
    expected 803
}
unit test FixtureCheckJATP_03854 {
    let fixture_result = FixtureJATP_03854.input * 11
    assert fixture_result == FixtureJATP_03854.expected
}
property PropertyJATP_03854 for_all x: Count where x <= 73 {
    let result = x * 11
    invariant result >= x
}
simulation FailureJATP_03854 {
    virtual_time 73s
    inject network.partition at 11s
    expect service.recovers within 14s
}
benchmark BenchJATP_03854 limit cpu 73ms memory 19MB
assert proof.complete == true
emit mcrt "PropertyJATP_03854.proof.mcrt"