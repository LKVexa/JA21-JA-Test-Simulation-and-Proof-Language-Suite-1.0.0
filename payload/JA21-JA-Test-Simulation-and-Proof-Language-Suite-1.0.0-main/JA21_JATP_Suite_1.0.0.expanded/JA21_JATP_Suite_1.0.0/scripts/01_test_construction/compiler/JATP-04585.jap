module corpus.ja_proof.example_04585
use Proof
policy no_network

fixture FixtureJATP_04585 {
    input 28
    expected 812
}
unit test FixtureCheckJATP_04585 {
    let fixture_result = FixtureJATP_04585.input * 29
    assert fixture_result == FixtureJATP_04585.expected
}
property PropertyJATP_04585 for_all x: Count where x <= 28 {
    let result = x * 29
    invariant result >= x
}
simulation FailureJATP_04585 {
    virtual_time 28s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_04585 limit cpu 28ms memory 37MB
assert proof.complete == true
emit mcrt "PropertyJATP_04585.proof.mcrt"