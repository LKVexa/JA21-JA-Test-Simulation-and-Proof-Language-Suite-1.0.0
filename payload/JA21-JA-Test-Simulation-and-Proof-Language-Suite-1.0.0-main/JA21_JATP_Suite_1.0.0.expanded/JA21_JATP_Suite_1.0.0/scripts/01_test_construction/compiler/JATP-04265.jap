module corpus.ja_proof.example_04265
use Proof
policy no_network

fixture FixtureJATP_04265 {
    input 96
    expected 1824
}
unit test FixtureCheckJATP_04265 {
    let fixture_result = FixtureJATP_04265.input * 19
    assert fixture_result == FixtureJATP_04265.expected
}
property PropertyJATP_04265 for_all x: Count where x <= 96 {
    let result = x * 19
    invariant result >= x
}
simulation FailureJATP_04265 {
    virtual_time 96s
    inject network.partition at 19s
    expect service.recovers within 22s
}
benchmark BenchJATP_04265 limit cpu 96ms memory 27MB
assert proof.complete == true
emit mcrt "PropertyJATP_04265.proof.mcrt"