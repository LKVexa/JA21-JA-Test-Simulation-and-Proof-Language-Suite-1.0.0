module corpus.ja_proof.example_04415
use Proof
policy no_network

fixture FixtureJATP_04415 {
    input 52
    expected 728
}
property PropertyJATP_04415 for_all x: Count where x <= 52 {
    let result = x * 14
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_04415 {
    virtual_time 52s
    inject network.partition at 14s
    expect service.recovers within 17s
}
benchmark BenchJATP_04415 limit cpu 52ms memory 22MB
assert proof.complete == false
emit mcrt "PropertyJATP_04415.proof.mcrt"