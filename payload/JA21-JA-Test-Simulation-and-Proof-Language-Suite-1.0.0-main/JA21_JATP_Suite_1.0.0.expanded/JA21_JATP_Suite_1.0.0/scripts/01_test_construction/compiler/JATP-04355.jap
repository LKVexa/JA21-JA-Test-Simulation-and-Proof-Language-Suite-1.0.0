module corpus.ja_proof.example_04355
use Proof
policy no_network

fixture FixtureJATP_04355 {
    input 89
    expected 1424
}
unit test FixtureCheckJATP_04355 {
    let fixture_result = FixtureJATP_04355.input * 16
    assert fixture_result == FixtureJATP_04355.expected
}
property PropertyJATP_04355 for_all x: Count where x <= 89 {
    let result = x * 16
    invariant result >= x
}
simulation FailureJATP_04355 {
    virtual_time 89s
    inject network.partition at 16s
    expect service.recovers within 19s
}
benchmark BenchJATP_04355 limit cpu 89ms memory 24MB
assert proof.complete == true
emit mcrt "PropertyJATP_04355.proof.mcrt"