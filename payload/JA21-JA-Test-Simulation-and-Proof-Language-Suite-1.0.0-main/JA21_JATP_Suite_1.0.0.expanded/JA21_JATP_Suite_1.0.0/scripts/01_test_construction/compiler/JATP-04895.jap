module corpus.ja_proof.example_04895
use Proof
policy no_network

fixture FixtureJATP_04895 {
    input 47
    expected 1363
}
unit test FixtureCheckJATP_04895 {
    let fixture_result = FixtureJATP_04895.input * 29
    assert fixture_result == FixtureJATP_04895.expected
}
property PropertyJATP_04895 for_all x: Count where x <= 47 {
    let result = x * 29
    invariant result >= x
}
simulation FailureJATP_04895 {
    virtual_time 47s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_04895 limit cpu 47ms memory 37MB
assert proof.complete == true
emit mcrt "PropertyJATP_04895.proof.mcrt"