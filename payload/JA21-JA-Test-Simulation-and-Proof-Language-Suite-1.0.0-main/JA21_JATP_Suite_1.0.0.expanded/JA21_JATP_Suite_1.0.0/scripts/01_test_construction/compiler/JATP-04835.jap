module corpus.ja_proof.example_04835
use Proof
policy no_network

fixture FixtureJATP_04835 {
    input 84
    expected 2604
}
unit test FixtureCheckJATP_04835 {
    let fixture_result = FixtureJATP_04835.input * 31
    assert fixture_result == FixtureJATP_04835.expected
}
property PropertyJATP_04835 for_all x: Count where x <= 84 {
    let result = x * 31
    invariant result >= x
}
simulation FailureJATP_04835 {
    virtual_time 84s
    inject network.partition at 31s
    expect service.recovers within 34s
}
benchmark BenchJATP_04835 limit cpu 84ms memory 39MB
assert proof.complete == true
emit mcrt "PropertyJATP_04835.proof.mcrt"