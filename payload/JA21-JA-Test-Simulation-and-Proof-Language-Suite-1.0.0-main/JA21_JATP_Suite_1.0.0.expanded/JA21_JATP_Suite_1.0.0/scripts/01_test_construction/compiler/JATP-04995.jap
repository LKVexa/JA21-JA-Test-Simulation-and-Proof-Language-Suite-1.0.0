module corpus.ja_proof.example_04995
use Proof
policy no_network

fixture FixtureJATP_04995 {
    input 50
    expected 250
}
unit test FixtureCheckJATP_04995 {
    let fixture_result = FixtureJATP_04995.input * 5
    assert fixture_result == FixtureJATP_04995.expected
}
property PropertyJATP_04995 for_all x: Count where x <= 50 {
    let result = x * 5
    invariant result >= x
}
simulation FailureJATP_04995 {
    virtual_time 50s
    inject network.partition at 5s
    expect service.recovers within 8s
}
benchmark BenchJATP_04995 limit cpu 50ms memory 13MB
assert proof.complete == true
emit mcrt "PropertyJATP_04995.proof.mcrt"