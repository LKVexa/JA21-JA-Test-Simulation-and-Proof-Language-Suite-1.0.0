module corpus.ja_proof.example_04105
use Proof
policy no_network

fixture FixtureJATP_04105 {
    input 33
    expected 462
}
unit test FixtureCheckJATP_04105 {
    let fixture_result = FixtureJATP_04105.input * 14
    assert fixture_result == FixtureJATP_04105.expected
}
property PropertyJATP_04105 for_all x: Count where x <= 33 {
    let result = x * 14
    invariant result >= x
}
simulation FailureJATP_04105 {
    virtual_time 33s
    inject network.partition at 14s
    expect service.recovers within 17s
}
benchmark BenchJATP_04105 limit cpu 33ms memory 22MB
assert proof.complete == true
emit mcrt "PropertyJATP_04105.proof.mcrt"