module corpus.ja_proof.example_04785
use Proof
policy no_network

fixture FixtureJATP_04785 {
    input 34
    expected 408
}
property PropertyJATP_04785 for_all x: Count where x <= 34 {
    let result = x * 12
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_04785 {
    virtual_time 34s
    inject network.partition at 12s
    expect service.recovers within 15s
}
benchmark BenchJATP_04785 limit cpu 34ms memory 20MB
assert proof.complete == false
emit mcrt "PropertyJATP_04785.proof.mcrt"