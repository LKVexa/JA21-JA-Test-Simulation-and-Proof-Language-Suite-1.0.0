module corpus.ja_proof.example_04825
use Proof
policy no_network

fixture FixtureJATP_04825 {
    input 74
    expected 1554
}
property PropertyJATP_04825 for_all x: Count where x <= 74 {
    let result = x * 21
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_04825 {
    virtual_time 74s
    inject network.partition at 21s
    expect service.recovers within 24s
}
benchmark BenchJATP_04825 limit cpu 74ms memory 29MB
assert proof.complete == false
emit mcrt "PropertyJATP_04825.proof.mcrt"