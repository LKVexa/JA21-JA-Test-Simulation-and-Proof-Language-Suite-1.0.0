module corpus.ja_proof.example_04775
use Proof
policy no_network

fixture FixtureJATP_04775 {
    input 24
    expected 48
}
property PropertyJATP_04775 for_all x: Count where x <= 24 {
    let result = x * 2
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_04775 {
    virtual_time 24s
    inject network.partition at 2s
    expect service.recovers within 5s
}
benchmark BenchJATP_04775 limit cpu 24ms memory 10MB
assert proof.complete == false
emit mcrt "PropertyJATP_04775.proof.mcrt"