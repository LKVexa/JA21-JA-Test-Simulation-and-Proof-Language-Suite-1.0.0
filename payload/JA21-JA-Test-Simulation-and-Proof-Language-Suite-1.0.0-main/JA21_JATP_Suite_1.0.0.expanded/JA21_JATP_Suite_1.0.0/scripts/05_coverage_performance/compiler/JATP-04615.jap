module corpus.ja_proof.example_04615
use Proof
policy no_network

fixture FixtureJATP_04615 {
    input 58
    expected 1624
}
unit test FixtureCheckJATP_04615 {
    let fixture_result = FixtureJATP_04615.input * 28
    assert fixture_result == FixtureJATP_04615.expected
}
property PropertyJATP_04615 for_all x: Count where x <= 58 {
    let result = x * 28
    invariant result >= x
}
simulation FailureJATP_04615 {
    virtual_time 58s
    inject network.partition at 28s
    expect service.recovers within 31s
}
benchmark BenchJATP_04615 limit cpu 58ms memory 36MB
assert proof.complete == true
emit mcrt "PropertyJATP_04615.proof.mcrt"