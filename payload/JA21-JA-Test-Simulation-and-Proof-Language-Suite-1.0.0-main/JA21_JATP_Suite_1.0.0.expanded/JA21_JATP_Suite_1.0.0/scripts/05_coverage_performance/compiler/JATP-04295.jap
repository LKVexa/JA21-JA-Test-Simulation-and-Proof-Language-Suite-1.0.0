module corpus.ja_proof.example_04295
use Proof
policy no_network

fixture FixtureJATP_04295 {
    input 29
    expected 522
}
unit test FixtureCheckJATP_04295 {
    let fixture_result = FixtureJATP_04295.input * 18
    assert fixture_result == FixtureJATP_04295.expected
}
property PropertyJATP_04295 for_all x: Count where x <= 29 {
    let result = x * 18
    invariant result >= x
}
simulation FailureJATP_04295 {
    virtual_time 29s
    inject network.partition at 18s
    expect service.recovers within 21s
}
benchmark BenchJATP_04295 limit cpu 29ms memory 26MB
assert proof.complete == true
emit mcrt "PropertyJATP_04295.proof.mcrt"