module corpus.ja_proof.example_04135
use Proof
policy no_network

fixture FixtureJATP_04135 {
    input 63
    expected 819
}
unit test FixtureCheckJATP_04135 {
    let fixture_result = FixtureJATP_04135.input * 13
    assert fixture_result == FixtureJATP_04135.expected
}
property PropertyJATP_04135 for_all x: Count where x <= 63 {
    let result = x * 13
    invariant result >= x
}
simulation FailureJATP_04135 {
    virtual_time 63s
    inject network.partition at 13s
    expect service.recovers within 16s
}
benchmark BenchJATP_04135 limit cpu 63ms memory 21MB
assert proof.complete == true
emit mcrt "PropertyJATP_04135.proof.mcrt"