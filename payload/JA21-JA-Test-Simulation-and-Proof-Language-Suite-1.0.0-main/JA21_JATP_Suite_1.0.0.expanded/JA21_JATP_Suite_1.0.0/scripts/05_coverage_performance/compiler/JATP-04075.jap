module corpus.ja_proof.example_04075
use Proof
policy no_network

fixture FixtureJATP_04075 {
    input 3
    expected 45
}
unit test FixtureCheckJATP_04075 {
    let fixture_result = FixtureJATP_04075.input * 15
    assert fixture_result == FixtureJATP_04075.expected
}
property PropertyJATP_04075 for_all x: Count where x <= 3 {
    let result = x * 15
    invariant result >= x
}
simulation FailureJATP_04075 {
    virtual_time 3s
    inject network.partition at 15s
    expect service.recovers within 18s
}
benchmark BenchJATP_04075 limit cpu 3ms memory 23MB
assert proof.complete == true
emit mcrt "PropertyJATP_04075.proof.mcrt"