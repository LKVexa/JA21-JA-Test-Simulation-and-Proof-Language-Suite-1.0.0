module corpus.ja_proof.example_04665
use Proof
policy no_network

fixture FixtureJATP_04665 {
    input 11
    expected 176
}
unit test FixtureCheckJATP_04665 {
    let fixture_result = FixtureJATP_04665.input * 16
    assert fixture_result == FixtureJATP_04665.expected
}
property PropertyJATP_04665 for_all x: Count where x <= 11 {
    let result = x * 16
    invariant result >= x
}
simulation FailureJATP_04665 {
    virtual_time 11s
    inject network.partition at 16s
    expect service.recovers within 19s
}
benchmark BenchJATP_04665 limit cpu 11ms memory 24MB
assert proof.complete == true
emit mcrt "PropertyJATP_04665.proof.mcrt"