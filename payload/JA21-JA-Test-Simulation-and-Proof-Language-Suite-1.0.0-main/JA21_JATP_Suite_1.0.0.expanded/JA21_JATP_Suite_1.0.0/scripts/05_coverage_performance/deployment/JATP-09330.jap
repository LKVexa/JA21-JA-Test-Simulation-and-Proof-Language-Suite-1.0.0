module corpus.ja_proof.example_09330
use Proof
policy no_network

fixture FixtureJATP_09330 {
    input 20
    expected 620
}
unit test FixtureCheckJATP_09330 {
    let fixture_result = FixtureJATP_09330.input * 31
    assert fixture_result == FixtureJATP_09330.expected
}
property PropertyJATP_09330 for_all x: Count where x <= 20 {
    let result = x * 31
    invariant result >= x
}
simulation FailureJATP_09330 {
    virtual_time 20s
    inject network.partition at 31s
    expect service.recovers within 34s
}
benchmark BenchJATP_09330 limit cpu 20ms memory 39MB
assert proof.complete == true
emit mcrt "PropertyJATP_09330.proof.mcrt"