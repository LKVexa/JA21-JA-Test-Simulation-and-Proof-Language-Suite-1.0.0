module corpus.ja_proof.example_09550
use Proof
policy no_network

fixture FixtureJATP_09550 {
    input 46
    expected 138
}
property PropertyJATP_09550 for_all x: Count where x <= 46 {
    let result = x * 3
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_09550 {
    virtual_time 46s
    inject network.partition at 3s
    expect service.recovers within 6s
}
benchmark BenchJATP_09550 limit cpu 46ms memory 11MB
assert proof.complete == false
emit mcrt "PropertyJATP_09550.proof.mcrt"