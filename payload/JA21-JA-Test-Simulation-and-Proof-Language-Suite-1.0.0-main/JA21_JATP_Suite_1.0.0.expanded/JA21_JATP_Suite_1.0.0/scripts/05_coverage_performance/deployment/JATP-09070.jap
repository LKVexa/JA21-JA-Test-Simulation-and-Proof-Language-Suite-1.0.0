module corpus.ja_proof.example_09070
use Proof
policy no_network

fixture FixtureJATP_09070 {
    input 51
    expected 969
}
unit test FixtureCheckJATP_09070 {
    let fixture_result = FixtureJATP_09070.input * 19
    assert fixture_result == FixtureJATP_09070.expected
}
property PropertyJATP_09070 for_all x: Count where x <= 51 {
    let result = x * 19
    invariant result >= x
}
simulation FailureJATP_09070 {
    virtual_time 51s
    inject network.partition at 19s
    expect service.recovers within 22s
}
benchmark BenchJATP_09070 limit cpu 51ms memory 27MB
assert proof.complete == true
emit mcrt "PropertyJATP_09070.proof.mcrt"