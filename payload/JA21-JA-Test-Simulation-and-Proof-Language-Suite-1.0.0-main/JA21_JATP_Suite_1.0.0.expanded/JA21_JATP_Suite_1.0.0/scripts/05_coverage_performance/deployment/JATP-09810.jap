module corpus.ja_proof.example_09810
use Proof
policy no_network

fixture FixtureJATP_09810 {
    input 15
    expected 225
}
property PropertyJATP_09810 for_all x: Count where x <= 15 {
    let result = x * 15
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_09810 {
    virtual_time 15s
    inject network.partition at 15s
    expect service.recovers within 18s
}
benchmark BenchJATP_09810 limit cpu 15ms memory 23MB
assert proof.complete == false
emit mcrt "PropertyJATP_09810.proof.mcrt"