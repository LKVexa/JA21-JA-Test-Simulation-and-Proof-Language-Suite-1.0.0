module corpus.ja_proof.example_09490
use Proof
policy no_network

fixture FixtureJATP_09490 {
    input 83
    expected 415
}
property PropertyJATP_09490 for_all x: Count where x <= 83 {
    let result = x * 5
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_09490 {
    virtual_time 83s
    inject network.partition at 5s
    expect service.recovers within 8s
}
benchmark BenchJATP_09490 limit cpu 83ms memory 13MB
assert proof.complete == false
emit mcrt "PropertyJATP_09490.proof.mcrt"