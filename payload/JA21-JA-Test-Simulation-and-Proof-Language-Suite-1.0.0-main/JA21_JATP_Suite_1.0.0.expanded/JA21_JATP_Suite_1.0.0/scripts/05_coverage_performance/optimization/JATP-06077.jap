module corpus.ja_proof.example_06077
use Proof
policy no_network

fixture FixtureJATP_06077 {
    input 65
    expected 130
}
unit test FixtureCheckJATP_06077 {
    let fixture_result = FixtureJATP_06077.input * 2
    assert fixture_result == FixtureJATP_06077.expected
}
property PropertyJATP_06077 for_all x: Count where x <= 65 {
    let result = x * 2
    invariant result >= x
}
simulation FailureJATP_06077 {
    virtual_time 65s
    inject network.partition at 2s
    expect service.recovers within 5s
}
benchmark BenchJATP_06077 limit cpu 65ms memory 10MB
assert proof.complete == true
emit mcrt "PropertyJATP_06077.proof.mcrt"