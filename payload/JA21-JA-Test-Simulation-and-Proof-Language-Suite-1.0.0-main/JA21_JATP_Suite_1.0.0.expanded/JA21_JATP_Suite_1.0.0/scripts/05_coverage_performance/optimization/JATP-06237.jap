module corpus.ja_proof.example_06237
use Proof
policy no_network

fixture FixtureJATP_06237 {
    input 31
    expected 217
}
unit test FixtureCheckJATP_06237 {
    let fixture_result = FixtureJATP_06237.input * 7
    assert fixture_result == FixtureJATP_06237.expected
}
property PropertyJATP_06237 for_all x: Count where x <= 31 {
    let result = x * 7
    invariant result >= x
}
simulation FailureJATP_06237 {
    virtual_time 31s
    inject network.partition at 7s
    expect service.recovers within 10s
}
benchmark BenchJATP_06237 limit cpu 31ms memory 15MB
assert proof.complete == true
emit mcrt "PropertyJATP_06237.proof.mcrt"