module corpus.ja_proof.example_06817
use Proof
policy no_network

fixture FixtureJATP_06817 {
    input 29
    expected 841
}
property PropertyJATP_06817 for_all x: Count where x <= 29 {
    let result = x * 29
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_06817 {
    virtual_time 29s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_06817 limit cpu 29ms memory 37MB
assert proof.complete == false
emit mcrt "PropertyJATP_06817.proof.mcrt"