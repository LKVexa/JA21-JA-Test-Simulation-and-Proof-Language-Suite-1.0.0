module corpus.ja_proof.example_06927
use Proof
policy no_network

fixture FixtureJATP_06927 {
    input 42
    expected 630
}
unit test FixtureCheckJATP_06927 {
    let fixture_result = FixtureJATP_06927.input * 15
    assert fixture_result == FixtureJATP_06927.expected
}
property PropertyJATP_06927 for_all x: Count where x <= 42 {
    let result = x * 15
    invariant result >= x
}
simulation FailureJATP_06927 {
    virtual_time 42s
    inject network.partition at 15s
    expect service.recovers within 18s
}
benchmark BenchJATP_06927 limit cpu 42ms memory 23MB
assert proof.complete == true
emit mcrt "PropertyJATP_06927.proof.mcrt"