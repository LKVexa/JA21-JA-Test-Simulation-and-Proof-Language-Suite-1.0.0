module corpus.ja_proof.example_06337
use Proof
policy no_network

fixture FixtureJATP_06337 {
    input 34
    expected 476
}
unit test FixtureCheckJATP_06337 {
    let fixture_result = FixtureJATP_06337.input * 14
    assert fixture_result == FixtureJATP_06337.expected
}
property PropertyJATP_06337 for_all x: Count where x <= 34 {
    let result = x * 14
    invariant result >= x
}
simulation FailureJATP_06337 {
    virtual_time 34s
    inject network.partition at 14s
    expect service.recovers within 17s
}
benchmark BenchJATP_06337 limit cpu 34ms memory 22MB
assert proof.complete == true
emit mcrt "PropertyJATP_06337.proof.mcrt"