module corpus.ja_proof.example_06177
use Proof
policy no_network

fixture FixtureJATP_06177 {
    input 68
    expected 612
}
unit test FixtureCheckJATP_06177 {
    let fixture_result = FixtureJATP_06177.input * 9
    assert fixture_result == FixtureJATP_06177.expected
}
property PropertyJATP_06177 for_all x: Count where x <= 68 {
    let result = x * 9
    invariant result >= x
}
simulation FailureJATP_06177 {
    virtual_time 68s
    inject network.partition at 9s
    expect service.recovers within 12s
}
benchmark BenchJATP_06177 limit cpu 68ms memory 17MB
assert proof.complete == true
emit mcrt "PropertyJATP_06177.proof.mcrt"