module corpus.ja_proof.example_06287
use Proof
policy no_network

fixture FixtureJATP_06287 {
    input 81
    expected 2106
}
unit test FixtureCheckJATP_06287 {
    let fixture_result = FixtureJATP_06287.input * 26
    assert fixture_result == FixtureJATP_06287.expected
}
property PropertyJATP_06287 for_all x: Count where x <= 81 {
    let result = x * 26
    invariant result >= x
}
simulation FailureJATP_06287 {
    virtual_time 81s
    inject network.partition at 26s
    expect service.recovers within 29s
}
benchmark BenchJATP_06287 limit cpu 81ms memory 34MB
assert proof.complete == true
emit mcrt "PropertyJATP_06287.proof.mcrt"