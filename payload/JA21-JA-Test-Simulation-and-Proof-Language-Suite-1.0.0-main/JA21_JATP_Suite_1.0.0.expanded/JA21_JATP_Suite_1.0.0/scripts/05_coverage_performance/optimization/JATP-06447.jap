module corpus.ja_proof.example_06447
use Proof
policy no_network

fixture FixtureJATP_06447 {
    input 47
    expected 1457
}
property PropertyJATP_06447 for_all x: Count where x <= 47 {
    let result = x * 31
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_06447 {
    virtual_time 47s
    inject network.partition at 31s
    expect service.recovers within 34s
}
benchmark BenchJATP_06447 limit cpu 47ms memory 39MB
assert proof.complete == false
emit mcrt "PropertyJATP_06447.proof.mcrt"