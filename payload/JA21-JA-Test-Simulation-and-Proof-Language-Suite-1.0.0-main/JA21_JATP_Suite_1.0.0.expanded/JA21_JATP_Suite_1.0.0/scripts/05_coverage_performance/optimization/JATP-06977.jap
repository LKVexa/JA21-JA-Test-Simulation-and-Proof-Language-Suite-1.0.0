module corpus.ja_proof.example_06977
use Proof
policy no_network

fixture FixtureJATP_06977 {
    input 92
    expected 276
}
unit test FixtureCheckJATP_06977 {
    let fixture_result = FixtureJATP_06977.input * 3
    assert fixture_result == FixtureJATP_06977.expected
}
property PropertyJATP_06977 for_all x: Count where x <= 92 {
    let result = x * 3
    invariant result >= x
}
simulation FailureJATP_06977 {
    virtual_time 92s
    inject network.partition at 3s
    expect service.recovers within 6s
}
benchmark BenchJATP_06977 limit cpu 92ms memory 11MB
assert proof.complete == true
emit mcrt "PropertyJATP_06977.proof.mcrt"