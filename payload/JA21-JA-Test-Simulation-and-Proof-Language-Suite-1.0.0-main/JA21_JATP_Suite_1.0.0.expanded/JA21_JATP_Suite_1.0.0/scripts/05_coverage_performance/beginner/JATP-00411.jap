module corpus.ja_proof.example_00411
use Proof
policy no_network

fixture FixtureJATP_00411 {
    input 25
    expected 225
}
property PropertyJATP_00411 for_all x: Count where x <= 25 {
    let result = x * 9
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_00411 {
    virtual_time 25s
    inject network.partition at 9s
    expect service.recovers within 12s
}
benchmark BenchJATP_00411 limit cpu 25ms memory 17MB
assert proof.complete == false
emit mcrt "PropertyJATP_00411.proof.mcrt"