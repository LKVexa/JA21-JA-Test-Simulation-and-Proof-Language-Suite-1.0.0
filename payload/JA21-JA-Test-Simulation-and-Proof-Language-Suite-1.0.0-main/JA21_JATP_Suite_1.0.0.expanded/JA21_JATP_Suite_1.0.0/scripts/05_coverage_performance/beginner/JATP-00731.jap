module corpus.ja_proof.example_00731
use Proof
policy no_network

fixture FixtureJATP_00731 {
    input 54
    expected 1026
}
unit test FixtureCheckJATP_00731 {
    let fixture_result = FixtureJATP_00731.input * 19
    assert fixture_result == FixtureJATP_00731.expected
}
property PropertyJATP_00731 for_all x: Count where x <= 54 {
    let result = x * 19
    invariant result >= x
}
simulation FailureJATP_00731 {
    virtual_time 54s
    inject network.partition at 19s
    expect service.recovers within 22s
}
benchmark BenchJATP_00731 limit cpu 54ms memory 27MB
assert proof.complete == true
emit mcrt "PropertyJATP_00731.proof.mcrt"