module corpus.ja_proof.example_08119
use Proof
policy no_network

fixture FixtureJATP_08119 {
    input 70
    expected 2030
}
unit test FixtureCheckJATP_08119 {
    let fixture_result = FixtureJATP_08119.input * 29
    assert fixture_result == FixtureJATP_08119.expected
}
property PropertyJATP_08119 for_all x: Count where x <= 70 {
    let result = x * 29
    invariant result >= x
}
simulation FailureJATP_08119 {
    virtual_time 70s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_08119 limit cpu 70ms memory 37MB
assert proof.complete == true
emit mcrt "PropertyJATP_08119.proof.mcrt"