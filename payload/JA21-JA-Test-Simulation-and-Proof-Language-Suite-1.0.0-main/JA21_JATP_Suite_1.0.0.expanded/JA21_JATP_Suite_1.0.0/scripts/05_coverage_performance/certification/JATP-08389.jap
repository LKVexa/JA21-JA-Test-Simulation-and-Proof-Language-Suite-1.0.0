module corpus.ja_proof.example_08389
use Proof
policy no_network

fixture FixtureJATP_08389 {
    input 49
    expected 980
}
unit test FixtureCheckJATP_08389 {
    let fixture_result = FixtureJATP_08389.input * 20
    assert fixture_result == FixtureJATP_08389.expected
}
property PropertyJATP_08389 for_all x: Count where x <= 49 {
    let result = x * 20
    invariant result >= x
}
simulation FailureJATP_08389 {
    virtual_time 49s
    inject network.partition at 20s
    expect service.recovers within 23s
}
benchmark BenchJATP_08389 limit cpu 49ms memory 28MB
assert proof.complete == true
emit mcrt "PropertyJATP_08389.proof.mcrt"