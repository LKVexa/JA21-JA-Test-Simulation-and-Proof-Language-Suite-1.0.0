module corpus.ja_proof.example_08599
use Proof
policy no_network

fixture FixtureJATP_08599 {
    input 65
    expected 845
}
unit test FixtureCheckJATP_08599 {
    let fixture_result = FixtureJATP_08599.input * 13
    assert fixture_result == FixtureJATP_08599.expected
}
property PropertyJATP_08599 for_all x: Count where x <= 65 {
    let result = x * 13
    invariant result >= x
}
simulation FailureJATP_08599 {
    virtual_time 65s
    inject network.partition at 13s
    expect service.recovers within 16s
}
benchmark BenchJATP_08599 limit cpu 65ms memory 21MB
assert proof.complete == true
emit mcrt "PropertyJATP_08599.proof.mcrt"