module corpus.ja_proof.example_08499
use Proof
policy no_network

fixture FixtureJATP_08499 {
    input 62
    expected 372
}
property PropertyJATP_08499 for_all x: Count where x <= 62 {
    let result = x * 6
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_08499 {
    virtual_time 62s
    inject network.partition at 6s
    expect service.recovers within 9s
}
benchmark BenchJATP_08499 limit cpu 62ms memory 14MB
assert proof.complete == false
emit mcrt "PropertyJATP_08499.proof.mcrt"