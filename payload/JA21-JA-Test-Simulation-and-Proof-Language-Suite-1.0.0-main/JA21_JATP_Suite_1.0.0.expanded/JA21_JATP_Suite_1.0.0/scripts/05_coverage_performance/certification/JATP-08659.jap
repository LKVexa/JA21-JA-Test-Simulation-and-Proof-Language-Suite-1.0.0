module corpus.ja_proof.example_08659
use Proof
policy no_network

fixture FixtureJATP_08659 {
    input 28
    expected 308
}
unit test FixtureCheckJATP_08659 {
    let fixture_result = FixtureJATP_08659.input * 11
    assert fixture_result == FixtureJATP_08659.expected
}
property PropertyJATP_08659 for_all x: Count where x <= 28 {
    let result = x * 11
    invariant result >= x
}
simulation FailureJATP_08659 {
    virtual_time 28s
    inject network.partition at 11s
    expect service.recovers within 14s
}
benchmark BenchJATP_08659 limit cpu 28ms memory 19MB
assert proof.complete == true
emit mcrt "PropertyJATP_08659.proof.mcrt"