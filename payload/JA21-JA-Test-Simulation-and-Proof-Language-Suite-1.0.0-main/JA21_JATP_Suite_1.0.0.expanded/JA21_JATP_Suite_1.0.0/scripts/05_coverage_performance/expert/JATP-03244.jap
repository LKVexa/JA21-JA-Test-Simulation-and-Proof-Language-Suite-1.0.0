module corpus.ja_proof.example_03244
use Proof
policy no_network

fixture FixtureJATP_03244 {
    input 45
    expected 945
}
unit test FixtureCheckJATP_03244 {
    let fixture_result = FixtureJATP_03244.input * 21
    assert fixture_result == FixtureJATP_03244.expected
}
property PropertyJATP_03244 for_all x: Count where x <= 45 {
    let result = x * 21
    invariant result >= x
}
simulation FailureJATP_03244 {
    virtual_time 45s
    inject network.partition at 21s
    expect service.recovers within 24s
}
benchmark BenchJATP_03244 limit cpu 45ms memory 29MB
assert proof.complete == true
emit mcrt "PropertyJATP_03244.proof.mcrt"