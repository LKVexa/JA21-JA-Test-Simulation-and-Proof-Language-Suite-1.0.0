module corpus.ja_proof.example_03564
use Proof
policy no_network

fixture FixtureJATP_03564 {
    input 74
    expected 2294
}
unit test FixtureCheckJATP_03564 {
    let fixture_result = FixtureJATP_03564.input * 31
    assert fixture_result == FixtureJATP_03564.expected
}
property PropertyJATP_03564 for_all x: Count where x <= 74 {
    let result = x * 31
    invariant result >= x
}
simulation FailureJATP_03564 {
    virtual_time 74s
    inject network.partition at 31s
    expect service.recovers within 34s
}
benchmark BenchJATP_03564 limit cpu 74ms memory 39MB
assert proof.complete == true
emit mcrt "PropertyJATP_03564.proof.mcrt"