module corpus.ja_proof.example_03184
use Proof
policy no_network

fixture FixtureJATP_03184 {
    input 82
    expected 1886
}
unit test FixtureCheckJATP_03184 {
    let fixture_result = FixtureJATP_03184.input * 23
    assert fixture_result == FixtureJATP_03184.expected
}
property PropertyJATP_03184 for_all x: Count where x <= 82 {
    let result = x * 23
    invariant result >= x
}
simulation FailureJATP_03184 {
    virtual_time 82s
    inject network.partition at 23s
    expect service.recovers within 26s
}
benchmark BenchJATP_03184 limit cpu 82ms memory 31MB
assert proof.complete == true
emit mcrt "PropertyJATP_03184.proof.mcrt"