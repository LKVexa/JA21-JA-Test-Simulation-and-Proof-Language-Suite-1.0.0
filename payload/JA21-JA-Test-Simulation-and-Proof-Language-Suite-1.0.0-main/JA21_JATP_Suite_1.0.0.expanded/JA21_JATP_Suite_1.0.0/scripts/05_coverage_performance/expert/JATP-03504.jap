module corpus.ja_proof.example_03504
use Proof
policy no_network

fixture FixtureJATP_03504 {
    input 14
    expected 28
}
property PropertyJATP_03504 for_all x: Count where x <= 14 {
    let result = x * 2
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_03504 {
    virtual_time 14s
    inject network.partition at 2s
    expect service.recovers within 5s
}
benchmark BenchJATP_03504 limit cpu 14ms memory 10MB
assert proof.complete == false
emit mcrt "PropertyJATP_03504.proof.mcrt"