module corpus.ja_proof.example_03454
use Proof
policy no_network

fixture FixtureJATP_03454 {
    input 61
    expected 854
}
property PropertyJATP_03454 for_all x: Count where x <= 61 {
    let result = x * 14
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_03454 {
    virtual_time 61s
    inject network.partition at 14s
    expect service.recovers within 17s
}
benchmark BenchJATP_03454 limit cpu 61ms memory 22MB
assert proof.complete == false
emit mcrt "PropertyJATP_03454.proof.mcrt"