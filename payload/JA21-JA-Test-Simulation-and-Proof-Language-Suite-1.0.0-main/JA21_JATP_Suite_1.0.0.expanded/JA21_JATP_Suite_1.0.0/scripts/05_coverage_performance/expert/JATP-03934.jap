module corpus.ja_proof.example_03934
use Proof
policy no_network

fixture FixtureJATP_03934 {
    input 56
    expected 1624
}
unit test FixtureCheckJATP_03934 {
    let fixture_result = FixtureJATP_03934.input * 29
    assert fixture_result == FixtureJATP_03934.expected
}
property PropertyJATP_03934 for_all x: Count where x <= 56 {
    let result = x * 29
    invariant result >= x
}
simulation FailureJATP_03934 {
    virtual_time 56s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_03934 limit cpu 56ms memory 37MB
assert proof.complete == true
emit mcrt "PropertyJATP_03934.proof.mcrt"