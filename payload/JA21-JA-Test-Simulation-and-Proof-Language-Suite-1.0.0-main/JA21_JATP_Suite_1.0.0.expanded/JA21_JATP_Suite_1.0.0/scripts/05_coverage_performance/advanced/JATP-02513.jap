module corpus.ja_proof.example_02513
use Proof
policy no_network

fixture FixtureJATP_02513 {
    input 90
    expected 270
}
property PropertyJATP_02513 for_all x: Count where x <= 90 {
    let result = x * 3
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_02513 {
    virtual_time 90s
    inject network.partition at 3s
    expect service.recovers within 6s
}
benchmark BenchJATP_02513 limit cpu 90ms memory 11MB
assert proof.complete == false
emit mcrt "PropertyJATP_02513.proof.mcrt"