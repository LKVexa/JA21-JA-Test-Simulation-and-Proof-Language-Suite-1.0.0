module corpus.ja_proof.example_02353
use Proof
policy no_network

fixture FixtureJATP_02353 {
    input 27
    expected 783
}
unit test FixtureCheckJATP_02353 {
    let fixture_result = FixtureJATP_02353.input * 29
    assert fixture_result == FixtureJATP_02353.expected
}
property PropertyJATP_02353 for_all x: Count where x <= 27 {
    let result = x * 29
    invariant result >= x
}
simulation FailureJATP_02353 {
    virtual_time 27s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_02353 limit cpu 27ms memory 37MB
assert proof.complete == true
emit mcrt "PropertyJATP_02353.proof.mcrt"