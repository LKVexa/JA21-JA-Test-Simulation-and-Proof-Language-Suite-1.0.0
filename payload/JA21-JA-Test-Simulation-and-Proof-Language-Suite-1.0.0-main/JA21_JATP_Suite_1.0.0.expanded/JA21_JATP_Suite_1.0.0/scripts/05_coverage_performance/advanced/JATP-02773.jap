module corpus.ja_proof.example_02773
use Proof
policy no_network

fixture FixtureJATP_02773 {
    input 59
    expected 885
}
property PropertyJATP_02773 for_all x: Count where x <= 59 {
    let result = x * 15
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_02773 {
    virtual_time 59s
    inject network.partition at 15s
    expect service.recovers within 18s
}
benchmark BenchJATP_02773 limit cpu 59ms memory 23MB
assert proof.complete == false
emit mcrt "PropertyJATP_02773.proof.mcrt"