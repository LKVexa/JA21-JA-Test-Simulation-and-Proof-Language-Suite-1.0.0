module corpus.ja_proof.example_02083
use Proof
policy no_network

fixture FixtureJATP_02083 {
    input 48
    expected 336
}
unit test FixtureCheckJATP_02083 {
    let fixture_result = FixtureJATP_02083.input * 7
    assert fixture_result == FixtureJATP_02083.expected
}
property PropertyJATP_02083 for_all x: Count where x <= 48 {
    let result = x * 7
    invariant result >= x
}
simulation FailureJATP_02083 {
    virtual_time 48s
    inject network.partition at 7s
    expect service.recovers within 10s
}
benchmark BenchJATP_02083 limit cpu 48ms memory 15MB
assert proof.complete == true
emit mcrt "PropertyJATP_02083.proof.mcrt"