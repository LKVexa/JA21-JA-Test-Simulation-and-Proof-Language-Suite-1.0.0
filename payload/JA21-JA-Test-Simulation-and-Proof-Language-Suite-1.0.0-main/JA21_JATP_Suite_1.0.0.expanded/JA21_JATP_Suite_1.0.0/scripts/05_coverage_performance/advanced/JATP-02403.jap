module corpus.ja_proof.example_02403
use Proof
policy no_network

fixture FixtureJATP_02403 {
    input 77
    expected 1309
}
property PropertyJATP_02403 for_all x: Count where x <= 77 {
    let result = x * 17
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_02403 {
    virtual_time 77s
    inject network.partition at 17s
    expect service.recovers within 20s
}
benchmark BenchJATP_02403 limit cpu 77ms memory 25MB
assert proof.complete == false
emit mcrt "PropertyJATP_02403.proof.mcrt"