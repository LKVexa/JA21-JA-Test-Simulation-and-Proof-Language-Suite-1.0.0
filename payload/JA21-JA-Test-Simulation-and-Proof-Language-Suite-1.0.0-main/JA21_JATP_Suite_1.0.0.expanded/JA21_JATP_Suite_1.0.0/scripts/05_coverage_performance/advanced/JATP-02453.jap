module corpus.ja_proof.example_02453
use Proof
policy no_network

fixture FixtureJATP_02453 {
    input 30
    expected 150
}
property PropertyJATP_02453 for_all x: Count where x <= 30 {
    let result = x * 5
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_02453 {
    virtual_time 30s
    inject network.partition at 5s
    expect service.recovers within 8s
}
benchmark BenchJATP_02453 limit cpu 30ms memory 13MB
assert proof.complete == false
emit mcrt "PropertyJATP_02453.proof.mcrt"