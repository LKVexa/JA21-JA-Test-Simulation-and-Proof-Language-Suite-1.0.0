module corpus.ja_proof.example_02563
use Proof
policy no_network

fixture FixtureJATP_02563 {
    input 43
    expected 946
}
unit test FixtureCheckJATP_02563 {
    let fixture_result = FixtureJATP_02563.input * 22
    assert fixture_result == FixtureJATP_02563.expected
}
property PropertyJATP_02563 for_all x: Count where x <= 43 {
    let result = x * 22
    invariant result >= x
}
simulation FailureJATP_02563 {
    virtual_time 43s
    inject network.partition at 22s
    expect service.recovers within 25s
}
benchmark BenchJATP_02563 limit cpu 43ms memory 30MB
assert proof.complete == true
emit mcrt "PropertyJATP_02563.proof.mcrt"