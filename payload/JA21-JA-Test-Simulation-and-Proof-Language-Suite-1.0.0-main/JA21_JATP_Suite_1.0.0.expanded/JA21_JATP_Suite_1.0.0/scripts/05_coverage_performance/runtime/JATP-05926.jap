module corpus.ja_proof.example_05926
use Proof
policy no_network

fixture FixtureJATP_05926 {
    input 11
    expected 66
}
unit test FixtureCheckJATP_05926 {
    let fixture_result = FixtureJATP_05926.input * 6
    assert fixture_result == FixtureJATP_05926.expected
}
property PropertyJATP_05926 for_all x: Count where x <= 11 {
    let result = x * 6
    invariant result >= x
}
simulation FailureJATP_05926 {
    virtual_time 11s
    inject network.partition at 6s
    expect service.recovers within 9s
}
benchmark BenchJATP_05926 limit cpu 11ms memory 14MB
assert proof.complete == true
emit mcrt "PropertyJATP_05926.proof.mcrt"