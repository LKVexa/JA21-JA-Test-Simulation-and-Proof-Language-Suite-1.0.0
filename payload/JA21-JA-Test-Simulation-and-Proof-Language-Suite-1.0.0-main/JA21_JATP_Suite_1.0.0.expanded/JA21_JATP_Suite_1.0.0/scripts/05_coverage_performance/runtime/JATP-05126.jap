module corpus.ja_proof.example_05126
use Proof
policy no_network

fixture FixtureJATP_05126 {
    input 84
    expected 1008
}
unit test FixtureCheckJATP_05126 {
    let fixture_result = FixtureJATP_05126.input * 12
    assert fixture_result == FixtureJATP_05126.expected
}
property PropertyJATP_05126 for_all x: Count where x <= 84 {
    let result = x * 12
    invariant result >= x
}
simulation FailureJATP_05126 {
    virtual_time 84s
    inject network.partition at 12s
    expect service.recovers within 15s
}
benchmark BenchJATP_05126 limit cpu 84ms memory 20MB
assert proof.complete == true
emit mcrt "PropertyJATP_05126.proof.mcrt"