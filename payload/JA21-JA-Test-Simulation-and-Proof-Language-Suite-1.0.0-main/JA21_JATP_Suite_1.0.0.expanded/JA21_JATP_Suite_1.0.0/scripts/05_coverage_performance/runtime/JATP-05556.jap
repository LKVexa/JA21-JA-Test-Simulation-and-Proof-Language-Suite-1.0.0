module corpus.ja_proof.example_05556
use Proof
policy no_network

fixture FixtureJATP_05556 {
    input 29
    expected 232
}
unit test FixtureCheckJATP_05556 {
    let fixture_result = FixtureJATP_05556.input * 8
    assert fixture_result == FixtureJATP_05556.expected
}
property PropertyJATP_05556 for_all x: Count where x <= 29 {
    let result = x * 8
    invariant result >= x
}
simulation FailureJATP_05556 {
    virtual_time 29s
    inject network.partition at 8s
    expect service.recovers within 11s
}
benchmark BenchJATP_05556 limit cpu 29ms memory 16MB
assert proof.complete == true
emit mcrt "PropertyJATP_05556.proof.mcrt"