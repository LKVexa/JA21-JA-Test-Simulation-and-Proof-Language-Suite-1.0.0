module corpus.ja_proof.example_07448
use Proof
policy no_network

fixture FixtureJATP_07448 {
    input 78
    expected 702
}
property PropertyJATP_07448 for_all x: Count where x <= 78 {
    let result = x * 9
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_07448 {
    virtual_time 78s
    inject network.partition at 9s
    expect service.recovers within 12s
}
benchmark BenchJATP_07448 limit cpu 78ms memory 17MB
assert proof.complete == false
emit mcrt "PropertyJATP_07448.proof.mcrt"