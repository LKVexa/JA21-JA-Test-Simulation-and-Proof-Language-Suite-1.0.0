module corpus.ja_proof.example_07608
use Proof
policy no_network

fixture FixtureJATP_07608 {
    input 44
    expected 616
}
unit test FixtureCheckJATP_07608 {
    let fixture_result = FixtureJATP_07608.input * 14
    assert fixture_result == FixtureJATP_07608.expected
}
property PropertyJATP_07608 for_all x: Count where x <= 44 {
    let result = x * 14
    invariant result >= x
}
simulation FailureJATP_07608 {
    virtual_time 44s
    inject network.partition at 14s
    expect service.recovers within 17s
}
benchmark BenchJATP_07608 limit cpu 44ms memory 22MB
assert proof.complete == true
emit mcrt "PropertyJATP_07608.proof.mcrt"