module corpus.ja_proof.example_07338
use Proof
policy no_network

fixture FixtureJATP_07338 {
    input 65
    expected 1495
}
unit test FixtureCheckJATP_07338 {
    let fixture_result = FixtureJATP_07338.input * 23
    assert fixture_result == FixtureJATP_07338.expected
}
property PropertyJATP_07338 for_all x: Count where x <= 65 {
    let result = x * 23
    invariant result >= x
}
simulation FailureJATP_07338 {
    virtual_time 65s
    inject network.partition at 23s
    expect service.recovers within 26s
}
benchmark BenchJATP_07338 limit cpu 65ms memory 31MB
assert proof.complete == true
emit mcrt "PropertyJATP_07338.proof.mcrt"