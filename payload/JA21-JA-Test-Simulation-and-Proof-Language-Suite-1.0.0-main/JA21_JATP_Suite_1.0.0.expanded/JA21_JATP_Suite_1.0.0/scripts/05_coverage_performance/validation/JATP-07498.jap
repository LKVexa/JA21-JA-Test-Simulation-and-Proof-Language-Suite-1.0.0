module corpus.ja_proof.example_07498
use Proof
policy no_network

fixture FixtureJATP_07498 {
    input 31
    expected 868
}
property PropertyJATP_07498 for_all x: Count where x <= 31 {
    let result = x * 28
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_07498 {
    virtual_time 31s
    inject network.partition at 28s
    expect service.recovers within 31s
}
benchmark BenchJATP_07498 limit cpu 31ms memory 36MB
assert proof.complete == false
emit mcrt "PropertyJATP_07498.proof.mcrt"