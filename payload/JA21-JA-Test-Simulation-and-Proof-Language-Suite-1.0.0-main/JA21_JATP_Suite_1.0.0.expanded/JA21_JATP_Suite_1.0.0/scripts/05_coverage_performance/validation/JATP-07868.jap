module corpus.ja_proof.example_07868
use Proof
policy no_network

fixture FixtureJATP_07868 {
    input 13
    expected 338
}
unit test FixtureCheckJATP_07868 {
    let fixture_result = FixtureJATP_07868.input * 26
    assert fixture_result == FixtureJATP_07868.expected
}
property PropertyJATP_07868 for_all x: Count where x <= 13 {
    let result = x * 26
    invariant result >= x
}
simulation FailureJATP_07868 {
    virtual_time 13s
    inject network.partition at 26s
    expect service.recovers within 29s
}
benchmark BenchJATP_07868 limit cpu 13ms memory 34MB
assert proof.complete == true
emit mcrt "PropertyJATP_07868.proof.mcrt"