ja source 0.3
module corpus.ja_proof.example_07128
use Proof
policy no_network

fixture FixtureJATP_07128 {
    input 49
    expected 1470
}
unit test FixtureCheckJATP_07128 {
    let fixture_result = FixtureJATP_07128.input * 30
    assert fixture_result == FixtureJATP_07128.expected
}
property PropertyJATP_07128 for_all x: Count where x <= 49 {
    let result = x * 30
    invariant result >= x
}
simulation FailureJATP_07128 {
    virtual_time 49s
    inject network.partition at 30s
    expect service.recovers within 33s
}
benchmark BenchJATP_07128 limit cpu 49ms memory 38MB
assert proof.complete == true
emit mcrt "PropertyJATP_07128.proof.mcrt"