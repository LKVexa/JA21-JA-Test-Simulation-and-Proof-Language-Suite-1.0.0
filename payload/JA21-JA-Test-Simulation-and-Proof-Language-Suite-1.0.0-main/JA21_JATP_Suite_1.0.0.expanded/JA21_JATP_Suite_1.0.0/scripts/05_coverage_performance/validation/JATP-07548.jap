module corpus.ja_proof.example_07548
use Proof
policy no_network

fixture FixtureJATP_07548 {
    input 81
    expected 1296
}
property PropertyJATP_07548 for_all x: Count where x <= 81 {
    let result = x * 16
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_07548 {
    virtual_time 81s
    inject network.partition at 16s
    expect service.recovers within 19s
}
benchmark BenchJATP_07548 limit cpu 81ms memory 24MB
assert proof.complete == false
emit mcrt "PropertyJATP_07548.proof.mcrt"