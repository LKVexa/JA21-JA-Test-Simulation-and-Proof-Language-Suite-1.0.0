module corpus.ja_proof.example_01402
use Proof
policy no_network

fixture FixtureJATP_01402 {
    input 46
    expected 368
}
property PropertyJATP_01402 for_all x: Count where x <= 46 {
    let result = x * 8
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_01402 {
    virtual_time 46s
    inject network.partition at 8s
    expect service.recovers within 11s
}
benchmark BenchJATP_01402 limit cpu 46ms memory 16MB
assert proof.complete == false
emit mcrt "PropertyJATP_01402.proof.mcrt"