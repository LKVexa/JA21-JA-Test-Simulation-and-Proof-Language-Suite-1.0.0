module corpus.ja_proof.example_01672
use Proof
policy no_network

fixture FixtureJATP_01672 {
    input 25
    expected 750
}
unit test FixtureCheckJATP_01672 {
    let fixture_result = FixtureJATP_01672.input * 30
    assert fixture_result == FixtureJATP_01672.expected
}
property PropertyJATP_01672 for_all x: Count where x <= 25 {
    let result = x * 30
    invariant result >= x
}
simulation FailureJATP_01672 {
    virtual_time 25s
    inject network.partition at 30s
    expect service.recovers within 33s
}
benchmark BenchJATP_01672 limit cpu 25ms memory 38MB
assert proof.complete == true
emit mcrt "PropertyJATP_01672.proof.mcrt"