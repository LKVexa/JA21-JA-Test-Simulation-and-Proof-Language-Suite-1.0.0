module corpus.ja_proof.example_01462
use Proof
policy no_network

fixture FixtureJATP_01462 {
    input 9
    expected 54
}
property PropertyJATP_01462 for_all x: Count where x <= 9 {
    let result = x * 6
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_01462 {
    virtual_time 9s
    inject network.partition at 6s
    expect service.recovers within 9s
}
benchmark BenchJATP_01462 limit cpu 9ms memory 14MB
assert proof.complete == false
emit mcrt "PropertyJATP_01462.proof.mcrt"