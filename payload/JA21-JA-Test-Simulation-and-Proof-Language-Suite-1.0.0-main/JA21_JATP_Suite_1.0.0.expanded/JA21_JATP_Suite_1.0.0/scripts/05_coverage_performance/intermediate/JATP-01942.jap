module corpus.ja_proof.example_01942
use Proof
policy no_network

fixture FixtureJATP_01942 {
    input 4
    expected 84
}
unit test FixtureCheckJATP_01942 {
    let fixture_result = FixtureJATP_01942.input * 21
    assert fixture_result == FixtureJATP_01942.expected
}
property PropertyJATP_01942 for_all x: Count where x <= 4 {
    let result = x * 21
    invariant result >= x
}
simulation FailureJATP_01942 {
    virtual_time 4s
    inject network.partition at 21s
    expect service.recovers within 24s
}
benchmark BenchJATP_01942 limit cpu 4ms memory 29MB
assert proof.complete == true
emit mcrt "PropertyJATP_01942.proof.mcrt"