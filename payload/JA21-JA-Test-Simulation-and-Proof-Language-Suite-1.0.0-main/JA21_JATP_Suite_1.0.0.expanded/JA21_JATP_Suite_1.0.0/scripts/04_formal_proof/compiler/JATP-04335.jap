module corpus.ja_proof.example_04335
use Proof
policy no_network

fixture FixtureJATP_04335 {
    input 69
    expected 1863
}
unit test FixtureCheckJATP_04335 {
    let fixture_result = FixtureJATP_04335.input * 27
    assert fixture_result == FixtureJATP_04335.expected
}
property PropertyJATP_04335 for_all x: Count where x <= 69 {
    let result = x * 27
    invariant result >= x
}
simulation FailureJATP_04335 {
    virtual_time 69s
    inject network.partition at 27s
    expect service.recovers within 30s
}
benchmark BenchJATP_04335 limit cpu 69ms memory 35MB
assert proof.complete == true
emit mcrt "PropertyJATP_04335.proof.mcrt"