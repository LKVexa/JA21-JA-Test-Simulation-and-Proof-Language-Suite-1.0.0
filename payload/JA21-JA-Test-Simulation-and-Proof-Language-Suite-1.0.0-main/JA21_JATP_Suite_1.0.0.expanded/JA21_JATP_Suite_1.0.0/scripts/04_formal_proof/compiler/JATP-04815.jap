module corpus.ja_proof.example_04815
use Proof
policy no_network

fixture FixtureJATP_04815 {
    input 64
    expected 704
}
property PropertyJATP_04815 for_all x: Count where x <= 64 {
    let result = x * 11
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_04815 {
    virtual_time 64s
    inject network.partition at 11s
    expect service.recovers within 14s
}
benchmark BenchJATP_04815 limit cpu 64ms memory 19MB
assert proof.complete == false
emit mcrt "PropertyJATP_04815.proof.mcrt"