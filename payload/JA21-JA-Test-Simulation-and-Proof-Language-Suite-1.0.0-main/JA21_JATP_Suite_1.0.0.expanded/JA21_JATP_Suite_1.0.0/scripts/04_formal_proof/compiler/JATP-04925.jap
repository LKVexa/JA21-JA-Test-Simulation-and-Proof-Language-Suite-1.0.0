module corpus.ja_proof.example_04925
use Proof
policy no_network

fixture FixtureJATP_04925 {
    input 77
    expected 2156
}
unit test FixtureCheckJATP_04925 {
    let fixture_result = FixtureJATP_04925.input * 28
    assert fixture_result == FixtureJATP_04925.expected
}
property PropertyJATP_04925 for_all x: Count where x <= 77 {
    let result = x * 28
    invariant result >= x
}
simulation FailureJATP_04925 {
    virtual_time 77s
    inject network.partition at 28s
    expect service.recovers within 31s
}
benchmark BenchJATP_04925 limit cpu 77ms memory 36MB
assert proof.complete == true
emit mcrt "PropertyJATP_04925.proof.mcrt"