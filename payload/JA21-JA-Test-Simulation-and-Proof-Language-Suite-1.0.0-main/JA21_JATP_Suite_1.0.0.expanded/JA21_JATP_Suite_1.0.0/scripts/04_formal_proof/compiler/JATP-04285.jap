module corpus.ja_proof.example_04285
use Proof
policy no_network

fixture FixtureJATP_04285 {
    input 19
    expected 152
}
unit test FixtureCheckJATP_04285 {
    let fixture_result = FixtureJATP_04285.input * 8
    assert fixture_result == FixtureJATP_04285.expected
}
property PropertyJATP_04285 for_all x: Count where x <= 19 {
    let result = x * 8
    invariant result >= x
}
simulation FailureJATP_04285 {
    virtual_time 19s
    inject network.partition at 8s
    expect service.recovers within 11s
}
benchmark BenchJATP_04285 limit cpu 19ms memory 16MB
assert proof.complete == true
emit mcrt "PropertyJATP_04285.proof.mcrt"