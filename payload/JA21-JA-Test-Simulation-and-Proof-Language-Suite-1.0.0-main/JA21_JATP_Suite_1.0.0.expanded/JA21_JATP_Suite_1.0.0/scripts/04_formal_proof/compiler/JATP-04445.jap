module corpus.ja_proof.example_04445
use Proof
policy no_network

fixture FixtureJATP_04445 {
    input 82
    expected 1066
}
property PropertyJATP_04445 for_all x: Count where x <= 82 {
    let result = x * 13
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_04445 {
    virtual_time 82s
    inject network.partition at 13s
    expect service.recovers within 16s
}
benchmark BenchJATP_04445 limit cpu 82ms memory 21MB
assert proof.complete == false
emit mcrt "PropertyJATP_04445.proof.mcrt"