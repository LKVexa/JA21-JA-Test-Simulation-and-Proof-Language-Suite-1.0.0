module corpus.ja_proof.example_06387
use Proof
policy no_network

fixture FixtureJATP_06387 {
    input 84
    expected 168
}
unit test FixtureCheckJATP_06387 {
    let fixture_result = FixtureJATP_06387.input * 2
    assert fixture_result == FixtureJATP_06387.expected
}
property PropertyJATP_06387 for_all x: Count where x <= 84 {
    let result = x * 2
    invariant result >= x
}
simulation FailureJATP_06387 {
    virtual_time 84s
    inject network.partition at 2s
    expect service.recovers within 5s
}
benchmark BenchJATP_06387 limit cpu 84ms memory 10MB
assert proof.complete == true
emit mcrt "PropertyJATP_06387.proof.mcrt"