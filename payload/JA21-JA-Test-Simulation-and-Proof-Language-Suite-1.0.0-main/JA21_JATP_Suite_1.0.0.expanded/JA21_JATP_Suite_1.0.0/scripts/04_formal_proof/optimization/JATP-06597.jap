module corpus.ja_proof.example_06597
use Proof
policy no_network

fixture FixtureJATP_06597 {
    input 3
    expected 78
}
unit test FixtureCheckJATP_06597 {
    let fixture_result = FixtureJATP_06597.input * 26
    assert fixture_result == FixtureJATP_06597.expected
}
property PropertyJATP_06597 for_all x: Count where x <= 3 {
    let result = x * 26
    invariant result >= x
}
simulation FailureJATP_06597 {
    virtual_time 3s
    inject network.partition at 26s
    expect service.recovers within 29s
}
benchmark BenchJATP_06597 limit cpu 3ms memory 34MB
assert proof.complete == true
emit mcrt "PropertyJATP_06597.proof.mcrt"