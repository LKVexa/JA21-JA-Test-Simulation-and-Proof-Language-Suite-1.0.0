module corpus.ja_proof.example_06757
use Proof
policy no_network

fixture FixtureJATP_06757 {
    input 66
    expected 2046
}
property PropertyJATP_06757 for_all x: Count where x <= 66 {
    let result = x * 31
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_06757 {
    virtual_time 66s
    inject network.partition at 31s
    expect service.recovers within 34s
}
benchmark BenchJATP_06757 limit cpu 66ms memory 39MB
assert proof.complete == false
emit mcrt "PropertyJATP_06757.proof.mcrt"