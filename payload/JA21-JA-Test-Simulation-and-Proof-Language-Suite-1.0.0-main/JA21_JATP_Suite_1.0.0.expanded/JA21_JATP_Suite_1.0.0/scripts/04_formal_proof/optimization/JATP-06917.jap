module corpus.ja_proof.example_06917
use Proof
policy no_network

fixture FixtureJATP_06917 {
    input 32
    expected 160
}
unit test FixtureCheckJATP_06917 {
    let fixture_result = FixtureJATP_06917.input * 5
    assert fixture_result == FixtureJATP_06917.expected
}
property PropertyJATP_06917 for_all x: Count where x <= 32 {
    let result = x * 5
    invariant result >= x
}
simulation FailureJATP_06917 {
    virtual_time 32s
    inject network.partition at 5s
    expect service.recovers within 8s
}
benchmark BenchJATP_06917 limit cpu 32ms memory 13MB
assert proof.complete == true
emit mcrt "PropertyJATP_06917.proof.mcrt"