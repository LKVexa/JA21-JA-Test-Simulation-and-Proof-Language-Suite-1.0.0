module corpus.ja_proof.example_07758
use Proof
policy no_network

fixture FixtureJATP_07758 {
    input 97
    expected 873
}
property PropertyJATP_07758 for_all x: Count where x <= 97 {
    let result = x * 9
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_07758 {
    virtual_time 97s
    inject network.partition at 9s
    expect service.recovers within 12s
}
benchmark BenchJATP_07758 limit cpu 97ms memory 17MB
assert proof.complete == false
emit mcrt "PropertyJATP_07758.proof.mcrt"