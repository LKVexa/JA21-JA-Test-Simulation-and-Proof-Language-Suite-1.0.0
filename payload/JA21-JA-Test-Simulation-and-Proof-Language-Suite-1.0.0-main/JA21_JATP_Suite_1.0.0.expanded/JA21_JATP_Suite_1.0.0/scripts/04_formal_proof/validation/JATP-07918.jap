module corpus.ja_proof.example_07918
use Proof
policy no_network

fixture FixtureJATP_07918 {
    input 63
    expected 882
}
unit test FixtureCheckJATP_07918 {
    let fixture_result = FixtureJATP_07918.input * 14
    assert fixture_result == FixtureJATP_07918.expected
}
property PropertyJATP_07918 for_all x: Count where x <= 63 {
    let result = x * 14
    invariant result >= x
}
simulation FailureJATP_07918 {
    virtual_time 63s
    inject network.partition at 14s
    expect service.recovers within 17s
}
benchmark BenchJATP_07918 limit cpu 63ms memory 22MB
assert proof.complete == true
emit mcrt "PropertyJATP_07918.proof.mcrt"