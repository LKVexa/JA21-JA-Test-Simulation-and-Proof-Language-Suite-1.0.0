module corpus.ja_proof.example_07808
use Proof
policy no_network

fixture FixtureJATP_07808 {
    input 50
    expected 1400
}
property PropertyJATP_07808 for_all x: Count where x <= 50 {
    let result = x * 28
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_07808 {
    virtual_time 50s
    inject network.partition at 28s
    expect service.recovers within 31s
}
benchmark BenchJATP_07808 limit cpu 50ms memory 36MB
assert proof.complete == false
emit mcrt "PropertyJATP_07808.proof.mcrt"