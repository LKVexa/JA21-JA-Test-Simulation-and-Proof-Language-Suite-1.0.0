module corpus.ja_proof.example_08969
use Proof
policy no_network

fixture FixtureJATP_08969 {
    input 47
    expected 517
}
property PropertyJATP_08969 for_all x: Count where x <= 47 {
    let result = x * 11
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_08969 {
    virtual_time 47s
    inject network.partition at 11s
    expect service.recovers within 14s
}
benchmark BenchJATP_08969 limit cpu 47ms memory 19MB
assert proof.complete == false
emit mcrt "PropertyJATP_08969.proof.mcrt"