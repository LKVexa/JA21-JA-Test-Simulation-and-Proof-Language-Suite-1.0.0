module corpus.ja_proof.example_08379
use Proof
policy no_network

fixture FixtureJATP_08379 {
    input 39
    expected 390
}
unit test FixtureCheckJATP_08379 {
    let fixture_result = FixtureJATP_08379.input * 10
    assert fixture_result == FixtureJATP_08379.expected
}
property PropertyJATP_08379 for_all x: Count where x <= 39 {
    let result = x * 10
    invariant result >= x
}
simulation FailureJATP_08379 {
    virtual_time 39s
    inject network.partition at 10s
    expect service.recovers within 13s
}
benchmark BenchJATP_08379 limit cpu 39ms memory 18MB
assert proof.complete == true
emit mcrt "PropertyJATP_08379.proof.mcrt"