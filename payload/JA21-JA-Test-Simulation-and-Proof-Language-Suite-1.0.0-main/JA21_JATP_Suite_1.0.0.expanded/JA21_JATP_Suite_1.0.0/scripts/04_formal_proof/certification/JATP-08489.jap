module corpus.ja_proof.example_08489
use Proof
policy no_network

fixture FixtureJATP_08489 {
    input 52
    expected 1404
}
property PropertyJATP_08489 for_all x: Count where x <= 52 {
    let result = x * 27
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_08489 {
    virtual_time 52s
    inject network.partition at 27s
    expect service.recovers within 30s
}
benchmark BenchJATP_08489 limit cpu 52ms memory 35MB
assert proof.complete == false
emit mcrt "PropertyJATP_08489.proof.mcrt"