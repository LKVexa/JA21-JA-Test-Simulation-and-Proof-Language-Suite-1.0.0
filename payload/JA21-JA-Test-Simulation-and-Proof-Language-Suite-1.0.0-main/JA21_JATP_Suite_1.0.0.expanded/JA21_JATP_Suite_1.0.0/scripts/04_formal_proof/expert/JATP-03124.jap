module corpus.ja_proof.example_03124
use Proof
policy no_network

fixture FixtureJATP_03124 {
    input 22
    expected 550
}
unit test FixtureCheckJATP_03124 {
    let fixture_result = FixtureJATP_03124.input * 25
    assert fixture_result == FixtureJATP_03124.expected
}
property PropertyJATP_03124 for_all x: Count where x <= 22 {
    let result = x * 25
    invariant result >= x
}
simulation FailureJATP_03124 {
    virtual_time 22s
    inject network.partition at 25s
    expect service.recovers within 28s
}
benchmark BenchJATP_03124 limit cpu 22ms memory 33MB
assert proof.complete == true
emit mcrt "PropertyJATP_03124.proof.mcrt"