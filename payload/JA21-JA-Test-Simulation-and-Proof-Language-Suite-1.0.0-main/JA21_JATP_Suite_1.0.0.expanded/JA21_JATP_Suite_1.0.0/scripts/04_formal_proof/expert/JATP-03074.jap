module corpus.ja_proof.example_03074
use Proof
policy no_network

fixture FixtureJATP_03074 {
    input 69
    expected 414
}
unit test FixtureCheckJATP_03074 {
    let fixture_result = FixtureJATP_03074.input * 6
    assert fixture_result == FixtureJATP_03074.expected
}
property PropertyJATP_03074 for_all x: Count where x <= 69 {
    let result = x * 6
    invariant result >= x
}
simulation FailureJATP_03074 {
    virtual_time 69s
    inject network.partition at 6s
    expect service.recovers within 9s
}
benchmark BenchJATP_03074 limit cpu 69ms memory 14MB
assert proof.complete == true
emit mcrt "PropertyJATP_03074.proof.mcrt"