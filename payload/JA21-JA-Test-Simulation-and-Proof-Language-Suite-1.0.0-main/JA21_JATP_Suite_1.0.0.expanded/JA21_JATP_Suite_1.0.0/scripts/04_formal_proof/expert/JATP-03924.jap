module corpus.ja_proof.example_03924
use Proof
policy no_network

fixture FixtureJATP_03924 {
    input 46
    expected 874
}
unit test FixtureCheckJATP_03924 {
    let fixture_result = FixtureJATP_03924.input * 19
    assert fixture_result == FixtureJATP_03924.expected
}
property PropertyJATP_03924 for_all x: Count where x <= 46 {
    let result = x * 19
    invariant result >= x
}
simulation FailureJATP_03924 {
    virtual_time 46s
    inject network.partition at 19s
    expect service.recovers within 22s
}
benchmark BenchJATP_03924 limit cpu 46ms memory 27MB
assert proof.complete == true
emit mcrt "PropertyJATP_03924.proof.mcrt"