module corpus.ja_proof.example_05866
use Proof
policy no_network

fixture FixtureJATP_05866 {
    input 48
    expected 384
}
unit test FixtureCheckJATP_05866 {
    let fixture_result = FixtureJATP_05866.input * 8
    assert fixture_result == FixtureJATP_05866.expected
}
property PropertyJATP_05866 for_all x: Count where x <= 48 {
    let result = x * 8
    invariant result >= x
}
simulation FailureJATP_05866 {
    virtual_time 48s
    inject network.partition at 8s
    expect service.recovers within 11s
}
benchmark BenchJATP_05866 limit cpu 48ms memory 16MB
assert proof.complete == true
emit mcrt "PropertyJATP_05866.proof.mcrt"