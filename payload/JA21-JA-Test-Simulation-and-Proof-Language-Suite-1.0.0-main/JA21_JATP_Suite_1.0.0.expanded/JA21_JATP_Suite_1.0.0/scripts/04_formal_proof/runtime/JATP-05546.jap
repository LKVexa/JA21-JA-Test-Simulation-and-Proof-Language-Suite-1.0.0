module corpus.ja_proof.example_05546
use Proof
policy no_network

fixture FixtureJATP_05546 {
    input 19
    expected 551
}
property PropertyJATP_05546 for_all x: Count where x <= 19 {
    let result = x * 29
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_05546 {
    virtual_time 19s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_05546 limit cpu 19ms memory 37MB
assert proof.complete == false
emit mcrt "PropertyJATP_05546.proof.mcrt"