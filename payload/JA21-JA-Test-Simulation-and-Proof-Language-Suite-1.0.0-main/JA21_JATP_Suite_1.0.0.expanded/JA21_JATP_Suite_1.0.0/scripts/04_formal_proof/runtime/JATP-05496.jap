module corpus.ja_proof.example_05496
use Proof
policy no_network

fixture FixtureJATP_05496 {
    input 66
    expected 660
}
property PropertyJATP_05496 for_all x: Count where x <= 66 {
    let result = x * 10
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_05496 {
    virtual_time 66s
    inject network.partition at 10s
    expect service.recovers within 13s
}
benchmark BenchJATP_05496 limit cpu 66ms memory 18MB
assert proof.complete == false
emit mcrt "PropertyJATP_05496.proof.mcrt"