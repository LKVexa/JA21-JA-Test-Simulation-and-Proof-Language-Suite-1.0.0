module corpus.ja_proof.example_05066
use Proof
policy no_network

fixture FixtureJATP_05066 {
    input 24
    expected 336
}
unit test FixtureCheckJATP_05066 {
    let fixture_result = FixtureJATP_05066.input * 14
    assert fixture_result == FixtureJATP_05066.expected
}
property PropertyJATP_05066 for_all x: Count where x <= 24 {
    let result = x * 14
    invariant result >= x
}
simulation FailureJATP_05066 {
    virtual_time 24s
    inject network.partition at 14s
    expect service.recovers within 17s
}
benchmark BenchJATP_05066 limit cpu 24ms memory 22MB
assert proof.complete == true
emit mcrt "PropertyJATP_05066.proof.mcrt"