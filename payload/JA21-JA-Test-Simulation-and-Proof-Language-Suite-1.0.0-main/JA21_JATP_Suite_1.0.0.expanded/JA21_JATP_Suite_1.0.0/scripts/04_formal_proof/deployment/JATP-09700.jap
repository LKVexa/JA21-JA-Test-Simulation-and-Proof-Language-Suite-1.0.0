module corpus.ja_proof.example_09700
use Proof
policy no_network

fixture FixtureJATP_09700 {
    input 2
    expected 58
}
unit test FixtureCheckJATP_09700 {
    let fixture_result = FixtureJATP_09700.input * 29
    assert fixture_result == FixtureJATP_09700.expected
}
property PropertyJATP_09700 for_all x: Count where x <= 2 {
    let result = x * 29
    invariant result >= x
}
simulation FailureJATP_09700 {
    virtual_time 2s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_09700 limit cpu 2ms memory 37MB
assert proof.complete == true
emit mcrt "PropertyJATP_09700.proof.mcrt"