module corpus.ja_proof.example_09380
use Proof
policy no_network

fixture FixtureJATP_09380 {
    input 70
    expected 1330
}
unit test FixtureCheckJATP_09380 {
    let fixture_result = FixtureJATP_09380.input * 19
    assert fixture_result == FixtureJATP_09380.expected
}
property PropertyJATP_09380 for_all x: Count where x <= 70 {
    let result = x * 19
    invariant result >= x
}
simulation FailureJATP_09380 {
    virtual_time 70s
    inject network.partition at 19s
    expect service.recovers within 22s
}
benchmark BenchJATP_09380 limit cpu 70ms memory 27MB
assert proof.complete == true
emit mcrt "PropertyJATP_09380.proof.mcrt"