module corpus.ja_proof.example_09860
use Proof
policy no_network

fixture FixtureJATP_09860 {
    input 65
    expected 195
}
unit test FixtureCheckJATP_09860 {
    let fixture_result = FixtureJATP_09860.input * 3
    assert fixture_result == FixtureJATP_09860.expected
}
property PropertyJATP_09860 for_all x: Count where x <= 65 {
    let result = x * 3
    invariant result >= x
}
simulation FailureJATP_09860 {
    virtual_time 65s
    inject network.partition at 3s
    expect service.recovers within 6s
}
benchmark BenchJATP_09860 limit cpu 65ms memory 11MB
assert proof.complete == true
emit mcrt "PropertyJATP_09860.proof.mcrt"