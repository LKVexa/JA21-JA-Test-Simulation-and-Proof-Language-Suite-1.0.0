module corpus.ja_proof.example_09590
use Proof
policy no_network

fixture FixtureJATP_09590 {
    input 86
    expected 1032
}
unit test FixtureCheckJATP_09590 {
    let fixture_result = FixtureJATP_09590.input * 12
    assert fixture_result == FixtureJATP_09590.expected
}
property PropertyJATP_09590 for_all x: Count where x <= 86 {
    let result = x * 12
    invariant result >= x
}
simulation FailureJATP_09590 {
    virtual_time 86s
    inject network.partition at 12s
    expect service.recovers within 15s
}
benchmark BenchJATP_09590 limit cpu 86ms memory 20MB
assert proof.complete == true
emit mcrt "PropertyJATP_09590.proof.mcrt"