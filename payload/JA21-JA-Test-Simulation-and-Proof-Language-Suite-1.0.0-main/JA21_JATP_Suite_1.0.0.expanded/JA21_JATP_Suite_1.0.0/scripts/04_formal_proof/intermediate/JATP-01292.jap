module corpus.ja_proof.example_01292
use Proof
policy no_network

fixture FixtureJATP_01292 {
    input 33
    expected 726
}
unit test FixtureCheckJATP_01292 {
    let fixture_result = FixtureJATP_01292.input * 22
    assert fixture_result == FixtureJATP_01292.expected
}
property PropertyJATP_01292 for_all x: Count where x <= 33 {
    let result = x * 22
    invariant result >= x
}
simulation FailureJATP_01292 {
    virtual_time 33s
    inject network.partition at 22s
    expect service.recovers within 25s
}
benchmark BenchJATP_01292 limit cpu 33ms memory 30MB
assert proof.complete == true
emit mcrt "PropertyJATP_01292.proof.mcrt"