module corpus.ja_proof.example_01772
use Proof
policy no_network

fixture FixtureJATP_01772 {
    input 28
    expected 168
}
property PropertyJATP_01772 for_all x: Count where x <= 28 {
    let result = x * 6
    invariant result >= x
    assert result != expected
}
simulation FailureJATP_01772 {
    virtual_time 28s
    inject network.partition at 6s
    expect service.recovers within 9s
}
benchmark BenchJATP_01772 limit cpu 28ms memory 14MB
assert proof.complete == false
emit mcrt "PropertyJATP_01772.proof.mcrt"