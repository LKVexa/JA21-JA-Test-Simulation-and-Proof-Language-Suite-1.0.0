module corpus.ja_proof.example_01982
use Proof
policy no_network

fixture FixtureJATP_01982 {
    input 44
    expected 1320
}
unit test FixtureCheckJATP_01982 {
    let fixture_result = FixtureJATP_01982.input * 30
    assert fixture_result == FixtureJATP_01982.expected
}
property PropertyJATP_01982 for_all x: Count where x <= 44 {
    let result = x * 30
    invariant result >= x
}
simulation FailureJATP_01982 {
    virtual_time 44s
    inject network.partition at 30s
    expect service.recovers within 33s
}
benchmark BenchJATP_01982 limit cpu 44ms memory 38MB
assert proof.complete == true
emit mcrt "PropertyJATP_01982.proof.mcrt"