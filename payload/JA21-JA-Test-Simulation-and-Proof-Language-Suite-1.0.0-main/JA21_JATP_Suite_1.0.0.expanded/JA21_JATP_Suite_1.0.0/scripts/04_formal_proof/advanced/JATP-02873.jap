module corpus.ja_proof.example_02873
use Proof
policy no_network

fixture FixtureJATP_02873 {
    input 62
    expected 1364
}
unit test FixtureCheckJATP_02873 {
    let fixture_result = FixtureJATP_02873.input * 22
    assert fixture_result == FixtureJATP_02873.expected
}
property PropertyJATP_02873 for_all x: Count where x <= 62 {
    let result = x * 22
    invariant result >= x
}
simulation FailureJATP_02873 {
    virtual_time 62s
    inject network.partition at 22s
    expect service.recovers within 25s
}
benchmark BenchJATP_02873 limit cpu 62ms memory 30MB
assert proof.complete == true
emit mcrt "PropertyJATP_02873.proof.mcrt"