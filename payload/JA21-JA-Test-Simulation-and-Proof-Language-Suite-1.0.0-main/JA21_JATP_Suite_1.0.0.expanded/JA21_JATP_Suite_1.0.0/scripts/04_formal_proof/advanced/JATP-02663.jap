module corpus.ja_proof.example_02663
use Proof
policy no_network

fixture FixtureJATP_02663 {
    input 46
    expected 1334
}
unit test FixtureCheckJATP_02663 {
    let fixture_result = FixtureJATP_02663.input * 29
    assert fixture_result == FixtureJATP_02663.expected
}
property PropertyJATP_02663 for_all x: Count where x <= 46 {
    let result = x * 29
    invariant result >= x
}
simulation FailureJATP_02663 {
    virtual_time 46s
    inject network.partition at 29s
    expect service.recovers within 32s
}
benchmark BenchJATP_02663 limit cpu 46ms memory 37MB
assert proof.complete == true
emit mcrt "PropertyJATP_02663.proof.mcrt"