module corpus.ja_proof.example_02233
use Proof
policy no_network

fixture FixtureJATP_02233 {
    input 4
    expected 8
}
unit test FixtureCheckJATP_02233 {
    let fixture_result = FixtureJATP_02233.input * 2
    assert fixture_result == FixtureJATP_02233.expected
}
property PropertyJATP_02233 for_all x: Count where x <= 4 {
    let result = x * 2
    invariant result >= x
}
simulation FailureJATP_02233 {
    virtual_time 4s
    inject network.partition at 2s
    expect service.recovers within 5s
}
benchmark BenchJATP_02233 limit cpu 4ms memory 10MB
assert proof.complete == true
emit mcrt "PropertyJATP_02233.proof.mcrt"